---
import { urlFor } from '../lib/sanity';
import { sanitizeAlt } from '../lib/logic/seo-utils';

interface Props {
  settings: any;
}

const { settings } = Astro.props;
---

<!-- Flat Design Footer — no rounded corners, no shadows -->
<footer class="border-t-4 border-accent bg-primary-dark text-white/90 pt-16 pb-8 px-6">
  <div class="max-w-[1280px] mx-auto">

    <!-- Main Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">

      <!-- Kolom 1: Identiteit -->
      <div>
        <div class="flex items-center gap-2.5 mb-5">
          {(settings?.logoFooter || settings?.logo) ? (
            <img
              src={urlFor(settings.logoFooter || settings.logo).width(40).height(40).fit('crop').url()}
              alt={sanitizeAlt(settings?.mosqueName)}
              class="w-8 h-8 object-contain"
            />
          ) : null}
          <h3 class="text-white text-xl font-heading font-bold">{settings?.mosqueName}</h3>
        </div>
        {settings?.description && (
          <p class="text-sm leading-relaxed mb-5 text-white/85">
            {settings.description}
          </p>
        )}
        <!-- Social Icons — Flat squares -->
        <div class="flex gap-2">
          {settings?.socials?.facebook && (
            <a
              href={settings.socials.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="w-11 h-11 bg-white/10 border border-white/15 flex items-center justify-center text-white/90 hover:bg-accent hover:border-accent hover:text-white active:brightness-90 transition-all"
              aria-label="Facebook"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
          )}
          {settings?.socials?.instagram && (
            <a
              href={settings.socials.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="w-11 h-11 bg-white/10 border border-white/15 flex items-center justify-center text-white/90 hover:bg-accent hover:border-accent hover:text-white active:brightness-90 transition-all"
              aria-label="Instagram"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </a>
          )}
          {settings?.socials?.youtube && (
            <a
              href={settings.socials.youtube}
              target="_blank"
              rel="noopener noreferrer"
              class="w-11 h-11 bg-white/10 border border-white/15 flex items-center justify-center text-white/90 hover:bg-accent hover:border-accent hover:text-white active:brightness-90 transition-all"
              aria-label="YouTube"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
          )}
          {settings?.whatsapp && (
            <a
              href={`https://wa.me/${settings.whatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-11 h-11 bg-white/10 border border-white/15 flex items-center justify-center text-white/90 hover:bg-whatsapp hover:border-whatsapp hover:text-white active:brightness-90 transition-all"
              aria-label="WhatsApp"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
            </a>
          )}
        </div>
      </div>

      <!-- Kolom 2: Navigatie (respecteert menuToggles) -->
      <div>
        <h4 class="font-bold mb-5 uppercase tracking-widest text-xs" style="color: var(--color-accent-gold);">Snelkoppelingen</h4>
        <ul class="space-y-3 text-sm">
          {(settings?.menuToggles?.showGebedstijden ?? true) && (
            <li><a href="/gebedstijden" class="text-white/90 hover:text-white transition-colors">Gebedstijden</a></li>
          )}
          {(settings?.menuToggles?.showAgenda ?? true) && (
            <li><a href="/agenda" class="text-white/90 hover:text-white transition-colors">Activiteiten</a></li>
          )}
          {(settings?.menuToggles?.showServices ?? true) && (
            <li><a href="/diensten" class="text-white/90 hover:text-white transition-colors">Onze Diensten</a></li>
          )}
          {(settings?.menuToggles?.showNieuws ?? true) && (
            <li><a href="/nieuws" class="text-white/90 hover:text-white transition-colors">Nieuws</a></li>
          )}
          {(settings?.menuToggles?.showAbout ?? true) && (
            <li><a href="/over-ons" class="text-white/90 hover:text-white transition-colors">Over Ons</a></li>
          )}
          {(settings?.menuToggles?.showDonaties ?? true) && (
            <li><a href="/doneren" class="text-white/90 hover:text-white transition-colors">Doneren</a></li>
          )}
        </ul>
      </div>

      <!-- Kolom 3: Contact & Bezoek -->
      <div>
        <h4 class="font-bold mb-5 uppercase tracking-widest text-xs" style="color: var(--color-accent-gold);">Contact & Bezoek</h4>
        <ul class="space-y-3 text-sm">
          {settings?.address && (
            <li class="flex items-start gap-3">
              <svg class="w-4 h-4 mt-0.5 text-white/60 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
              <span class="text-white/90">{settings.address}</span>
            </li>
          )}
          {settings?.phone && (
            <li class="flex items-center gap-3">
              <svg class="w-4 h-4 text-white/60 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
              <a href={`tel:${settings.phone.replace(/\s/g, '')}`} class="text-white/90 hover:text-white transition-colors">
                {settings.phone}
              </a>
            </li>
          )}
          {settings?.whatsapp && (
            <li class="flex items-center gap-3">
              <svg class="w-4 h-4 text-white/60 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 0 1 .778-.332 48.294 48.294 0 0 0 5.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" /></svg>
              <a href={`https://wa.me/${settings.whatsapp}`} target="_blank" rel="noopener noreferrer" class="text-white/90 hover:text-white transition-colors">
                WhatsApp
              </a>
            </li>
          )}
          {settings?.email && (
            <li class="flex items-center gap-3">
              <svg class="w-4 h-4 text-white/60 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" /></svg>
              <a href={`mailto:${settings.email}`} class="text-white/90 hover:text-white transition-colors">
                {settings.email}
              </a>
            </li>
          )}
        </ul>
      </div>

      <!-- Kolom 4: Transparantie -->
      <div>
        <h4 class="font-bold mb-5 uppercase tracking-widest text-xs" style="color: var(--color-accent-gold);">Transparantie</h4>
        <p class="text-xs mb-4 text-white/85 leading-relaxed">
          Wij zijn een officiële non-profit organisatie. Uw donaties zijn in veilige handen.
        </p>
        <div class="bg-white/5 p-4 border border-white/10 mb-4">
          <p class="text-[10px] uppercase mb-1 tracking-wider" class="text-accent">IBAN Nummer</p>
          <p class="text-sm font-mono text-white tracking-wider break-all">{settings?.iban || ''}</p>
        </div>
        <p class="text-[10px] text-white/60">
          KVK/VZW: {settings?.legal?.kvk || '---'}
        </p>
      </div>
    </div>

    <!-- Bottom Bar — Flat, strak -->
    <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-xs text-white/60">
        &copy; {new Date().getFullYear()} {settings?.mosqueName}. Alle rechten voorbehouden.
      </p>

      <!-- Ummah.be Signature -->
      <div class="flex items-center gap-2 text-xs opacity-60 hover:opacity-100 transition-opacity">
        <span>Powered by</span>
        <a
          href="https://ummah.be"
          target="_blank"
          rel="noopener noreferrer"
          class="text-white underline decoration-1 underline-offset-2 hover:text-accent transition-colors font-semibold"
        >
          Ummah.be
        </a>
        <a href="/admin" class="text-white/60 hover:text-accent transition-colors ml-1" aria-label="Admin">*</a>
      </div>

      <div class="flex gap-6 text-xs text-white/60">
        {(settings?.menuToggles?.showJanazah ?? true) && (
          <a href="/janazah" class="hover:text-white transition-colors">Hulp bij overlijden</a>
        )}
        <a href="/privacy" class="hover:text-white transition-colors">Privacy</a>
        <a href="/contact" class="hover:text-white transition-colors">Contact</a>
      </div>
    </div>
  </div>
</footer>
