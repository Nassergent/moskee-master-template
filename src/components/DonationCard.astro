---
import { urlFor } from '../lib/sanity';
import { calculateDonationProgress } from '../lib/logic/donation-utils';
import { sanitizeAlt } from '../lib/logic/seo-utils';

interface Props {
  _id: string;
  titel: string;
  beschrijving: string;
  doelbedrag?: number | null;
  /** Current amount in integer cents */
  huidigBedragCents?: number | null;
  actief: boolean;
  afbeelding?: any;
  /** When false, the CTA button selects the project in the form dropdown (used on donatiepagina) */
  clickable?: boolean;
}

const { _id, titel, beschrijving, doelbedrag, huidigBedragCents, actief, afbeelding, clickable = true } = Astro.props;
const hasProgress = !!(doelbedrag && doelbedrag > 0);
const { percentage, remaining, huidigEuros, isUrgent, isComplete } = hasProgress
  ? calculateDonationProgress(huidigBedragCents || 0, doelbedrag)
  : { percentage: 0, remaining: 0, huidigEuros: 0, isUrgent: false, isComplete: false };
---

<!-- Flat Design Card: bg-white, 3px accent left border, no shadow, no rounded -->
<div class="bg-white border border-neutral-200 border-l-[3px] border-l-accent overflow-hidden">
  {afbeelding && (
    <img
      src={urlFor(afbeelding).width(600).height(250).fit('crop').url()}
      alt={sanitizeAlt(titel)}
      class="w-full h-40 object-cover"
      loading="lazy"
    />
  )}
  <div class="p-5 sm:p-6">
    <div class="flex items-start justify-between mb-3">
      <h3 class="font-heading text-lg font-bold text-primary">{titel}</h3>
      {actief && (
        <span class="badge text-xs bg-accent/10 text-accent font-semibold px-2.5 py-1">Actief</span>
      )}
    </div>
    <p class="text-slate-600 text-sm leading-relaxed mb-5">{beschrijving}</p>

    <!-- Progress Bar (alleen als doelbedrag is ingesteld) -->
    {hasProgress && doelbedrag && (
      <div class="mb-3">
        <div class="flex justify-between text-xs text-slate-500 mb-1.5">
          <span>&euro;{huidigEuros.toLocaleString('nl-BE', { minimumFractionDigits: 2 })}</span>
          <span>&euro;{doelbedrag.toLocaleString('nl-BE')}</span>
        </div>
        <div class:list={['w-full h-3 overflow-hidden', isUrgent ? 'bg-accent/20' : 'bg-accent/10']}>
          <div
            class:list={[
              'h-full transition-all duration-500',
              isUrgent ? 'bg-accent animate-pulse' : 'bg-accent',
            ]}
            style={`width: ${percentage}%`}
          />
        </div>
        <div class="flex justify-between items-center mt-1.5">
          <p class="text-xs text-slate-400">{percentage}% bereikt</p>
          {isComplete ? (
            <p class="text-xs font-bold text-green-600">Doel bereikt!</p>
          ) : (
            <p class:list={['text-xs font-bold', isUrgent ? 'text-accent' : 'text-slate-500']}>
              Nog &euro;{remaining.toLocaleString('nl-BE')} nodig
              {isUrgent && '!'}
            </p>
          )}
        </div>
      </div>
    )}

    <!-- CTA -->
    {!isComplete && clickable && (
      <a
        href="/doneren"
        class="btn-primary block text-center bg-primary hover:bg-primary-dark text-white py-3 font-bold text-sm transition-all mt-4"
      >
        Steun dit doel
      </a>
    )}
    {!isComplete && !clickable && (
      <button
        type="button"
        class="donation-card-select w-full block text-center bg-accent hover:bg-accent-hover text-white py-3 font-bold text-sm transition-all mt-4 cursor-pointer"
        data-project-id={_id}
        data-project-title={titel}
      >
        Selecteer dit doel
      </button>
    )}
  </div>
</div>
