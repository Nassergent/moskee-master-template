---
import { fetchSettings, urlFor } from '../lib/sanity';

const settings = await fetchSettings();
const mosqueName = settings?.mosqueName || 'Onze Moskee';
const donateText = settings?.donateButtonText || 'Doneer';

// De "Universele 7" lijst — Gebedstijden & Contact altijd aan
const menuItems = [
  { name: 'Gebedstijden', href: '/gebedstijden', show: true },
  { name: 'Diensten', href: '/diensten', show: settings?.menuToggles?.showServices ?? true },
  { name: 'Artikelen', href: '/nieuws', show: settings?.menuToggles?.showNews ?? true },
  { name: 'Agenda', href: '/agenda', show: settings?.menuToggles?.showAgenda ?? true },
  { name: 'Over Ons', href: '/over-ons', show: settings?.menuToggles?.showAbout ?? true },
  { name: 'Contact', href: '/contact', show: true },
];

const visibleItems = menuItems.filter((item) => item.show);
const currentPath = Astro.url.pathname;
---

<!-- Flat Design Navigation — no rounded corners, no shadows -->
<nav class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-neutral-200">
  <div class="max-w-[1280px] mx-auto px-6 h-16 flex justify-between items-center">

    <!-- Logo / Naam -->
    <a href="/" class="flex items-center gap-2.5 group">
      {settings?.logo ? (
        <img
          src={urlFor(settings.logo).width(40).height(40).fit('crop').url()}
          alt={mosqueName}
          class="w-8 h-8 object-contain"
        />
      ) : null}
      <span class="text-lg font-bold font-heading text-primary group-hover:opacity-80 transition-opacity">
        {mosqueName}
      </span>
    </a>

    <!-- Desktop Menu -->
    <div class="hidden lg:flex items-center gap-0">
      {visibleItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class:list={[
              'px-4 py-2 text-sm font-medium transition-all border-b-2',
              isActive
                ? 'text-accent border-accent font-bold'
                : 'text-neutral-600 border-transparent hover:text-primary hover:border-primary/30',
            ]}
          >
            {item.name}
          </a>
        );
      })}

      <!-- Doneer CTA — Flat, no rounded -->
      <a
        href="/doneren"
        class="btn-primary ml-6 bg-accent hover:bg-accent-hover text-white px-6 py-2 font-bold text-sm transition-all"
      >
        {donateText}
      </a>

    </div>

    <!-- Mobile Menu Button — min 44x44px touch target -->
    <div class="lg:hidden flex items-center gap-2">

      <button
        id="nav-mobile-btn"
        class="min-w-[44px] min-h-[44px] flex items-center justify-center text-neutral-700 hover:bg-neutral-100 active:bg-neutral-200 transition-colors"
        aria-label="Menu openen"
        aria-expanded="false"
        aria-controls="nav-mobile-menu"
      >
        <svg id="nav-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
        <svg id="nav-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Overlay (click to close) -->
  <div
    id="nav-mobile-overlay"
    class="hidden fixed inset-0 bg-black/20 z-40 lg:hidden"
    aria-hidden="true"
  ></div>

  <!-- Mobile Menu Panel -->
  <div
    id="nav-mobile-menu"
    class="hidden lg:hidden border-t border-neutral-200 bg-white relative z-50"
    role="dialog"
    aria-modal="true"
    aria-label="Navigatiemenu"
  >
    <div class="max-w-[1280px] mx-auto px-6 py-4 flex flex-col gap-0">
      {visibleItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class:list={[
              'px-4 py-3 min-h-[44px] flex items-center text-sm font-medium transition-colors border-l-3 active:bg-neutral-100',
              isActive
                ? 'text-accent border-accent bg-accent-light font-bold'
                : 'text-neutral-600 border-transparent hover:text-primary hover:bg-base-100',
            ]}
          >
            {item.name}
          </a>
        );
      })}

      <!-- Mobile Doneer -->
      <a
        href="/doneren"
        class="mt-3 text-center bg-accent hover:bg-accent-hover active:brightness-90 text-white px-6 py-3 min-h-[44px] flex items-center justify-center font-bold text-sm transition-all"
      >
        {donateText}
      </a>
    </div>
  </div>
</nav>

<!-- Spacer for fixed navbar -->
<div class="h-16" />

<script>
  // Mobile menu toggle with focus trap, overlay & scroll lock
  const btn = document.getElementById('nav-mobile-btn');
  const menu = document.getElementById('nav-mobile-menu');
  const overlay = document.getElementById('nav-mobile-overlay');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  function openMenu() {
    menu?.classList.remove('hidden');
    overlay?.classList.remove('hidden');
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    btn?.setAttribute('aria-expanded', 'true');
    btn?.setAttribute('aria-label', 'Menu sluiten');
    document.body.style.overflow = 'hidden';

    // Focus first link
    const firstLink = menu?.querySelector('a') as HTMLAnchorElement | null;
    if (firstLink) firstLink.focus();
  }

  function closeMenu() {
    menu?.classList.add('hidden');
    overlay?.classList.add('hidden');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    btn?.setAttribute('aria-expanded', 'false');
    btn?.setAttribute('aria-label', 'Menu openen');
    document.body.style.overflow = '';
    btn?.focus();
  }

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    isOpen ? closeMenu() : openMenu();
  });

  // Click overlay to close
  overlay?.addEventListener('click', closeMenu);

  // ESC key closes mobile menu
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.classList.contains('hidden')) {
      closeMenu();
    }
  });

  // Focus trap: keep Tab within menu when open
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || !menu || menu.classList.contains('hidden')) return;
    const focusable = [btn, ...menu.querySelectorAll('a, button')].filter(Boolean) as HTMLElement[];
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // Close mobile menu when a link is clicked
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>
