---
import { urlFor, logoUrl } from '../lib/sanity';
import { sanitizeAlt } from '../lib/logic/seo-utils';
import { isNavItemActive } from '../lib/logic/nav-utils';
import { buildVisibleMenuItems } from '../lib/logic/menu-builder';

interface Props {
  settings: any;
}

const { settings } = Astro.props;
const mosqueName = settings?.mosqueName || 'Onze Moskee';
const donateText = settings?.donateButtonText || 'Doneer';
const visibleItems = buildVisibleMenuItems(settings);
const currentPath = Astro.url.pathname;
---

<!-- Flat Design Navigation — no rounded corners, no shadows -->
<nav class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-neutral-200">
  <div class="max-w-[1280px] mx-auto px-6 h-24 flex justify-between items-center">

    <!-- Logo / Naam -->
    <a href="/" class="flex items-center gap-3 group">
      {settings?.logo ? (
        <img
          src={logoUrl(settings.logo).height(128).url()}
          alt={sanitizeAlt(mosqueName)}
          class="h-14 w-auto object-contain"
        />
      ) : null}
      <span class="text-xl font-bold font-heading text-primary group-hover:opacity-80 transition-opacity">
        {mosqueName}
      </span>
    </a>

    <!-- Desktop Menu -->
    <div class="hidden lg:flex items-center gap-0">
      {visibleItems.map((item) => {
        const isActive = isNavItemActive(currentPath, item.href);
        return (
          <a
            href={item.href}
            class:list={[
              'px-4 py-2 text-sm font-medium transition-all border-b-2',
              isActive
                ? 'text-accent border-accent font-bold'
                : 'text-neutral-600 border-transparent hover:text-primary hover:border-primary/30',
            ]}
          >
            {item.name}
          </a>
        );
      })}

      <!-- Doneer CTA — Flat, no rounded -->
      <a
        href="/doneren"
        class="btn-primary ml-6 bg-accent hover:bg-accent-hover text-white px-6 py-2 font-bold text-sm transition-all"
      >
        {donateText}
      </a>

    </div>

    <!-- Mobile Menu Button — min 44x44px touch target -->
    <div class="lg:hidden flex items-center gap-2">
      <button
        id="nav-mobile-btn"
        class="min-w-[44px] min-h-[44px] flex items-center justify-center text-neutral-700 hover:bg-neutral-100 active:bg-neutral-200 transition-colors"
        aria-label="Menu openen"
        aria-expanded="false"
        aria-controls="nav-mobile-menu"
      >
        <svg id="nav-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
        <svg id="nav-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Fullscreen Menu -->
  <div
    id="nav-mobile-menu"
    class="fixed inset-0 top-24 z-50 lg:hidden bg-white flex flex-col translate-y-full transition-transform duration-300 ease-out"
    role="dialog"
    aria-modal="true"
    aria-label="Navigatiemenu"
    aria-hidden="true"
  >
    <!-- Links — centered, spaced out -->
    <div class="flex-1 flex flex-col justify-center px-8 -mt-8">
      {visibleItems.map((item, i) => {
        const isActive = isNavItemActive(currentPath, item.href);
        return (
          <a
            href={item.href}
            class:list={[
              'py-4 text-center text-xl font-heading font-bold transition-colors active:opacity-70',
              isActive ? 'text-accent' : 'text-primary',
            ]}
            style={`animation-delay: ${i * 50}ms`}
          >
            {item.name}
          </a>
        );
      })}
    </div>

    <!-- Bottom: Doneer knop + contact info -->
    <div class="px-8 pb-8 pt-4 border-t border-neutral-100">
      <a
        href="/doneren"
        class="block w-full text-center bg-accent hover:bg-accent-hover active:brightness-90 text-white px-6 py-4 min-h-[48px] font-bold text-lg font-heading transition-all"
      >
        {donateText}
      </a>
      {settings?.phone && (
        <a href={`tel:${settings.phone.replace(/\s/g, '')}`} class="block text-center text-sm text-neutral-400 mt-4 active:text-primary">
          {settings.phone}
        </a>
      )}
    </div>
  </div>
</nav>

<!-- Spacer for fixed navbar -->
<div class="h-24" />

<script>
  const btn = document.getElementById('nav-mobile-btn');
  const menu = document.getElementById('nav-mobile-menu');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  let isOpen = false;

  function openMenu() {
    isOpen = true;
    menu?.classList.remove('translate-y-full');
    menu?.classList.add('translate-y-0');
    menu?.setAttribute('aria-hidden', 'false');
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    btn?.setAttribute('aria-expanded', 'true');
    btn?.setAttribute('aria-label', 'Menu sluiten');
    document.body.style.overflow = 'hidden';

    const firstLink = menu?.querySelector('a') as HTMLAnchorElement | null;
    if (firstLink) firstLink.focus();
  }

  function closeMenu() {
    isOpen = false;
    menu?.classList.add('translate-y-full');
    menu?.classList.remove('translate-y-0');
    menu?.setAttribute('aria-hidden', 'true');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    btn?.setAttribute('aria-expanded', 'false');
    btn?.setAttribute('aria-label', 'Menu openen');
    document.body.style.overflow = '';
    btn?.focus();
  }

  btn?.addEventListener('click', () => {
    isOpen ? closeMenu() : openMenu();
  });

  // ESC key closes menu
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) closeMenu();
  });

  // Focus trap
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || !isOpen || !menu) return;
    const focusable = [btn, ...menu.querySelectorAll('a, button')].filter(Boolean) as HTMLElement[];
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // Close on link click
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>
