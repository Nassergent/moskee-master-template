---
/**
 * DownloadCard.astro — Document download met preview lightbox
 *
 * Data bronnen:
 * 1. downloadBron === 'homePage' → leest uit homePage singleton (pass-through)
 * 2. downloadBron === 'eigen' → eigen velden in homeCards
 */
import { resolveDownloadImage, extractFileName } from '../../lib/logic/media-utils';
import { sanitizeAlt } from '../../lib/logic/seo-utils';

interface Props {
  card: any;
  delay?: number;
  homePageDownload?: {
    downloadTitel?: string;
    downloadBeschrijving?: string;
    downloadUrl?: string;
    downloadBestand?: any;
  };
}

const { card, delay = 0, homePageDownload } = Astro.props;

// Resolve data source
let titel: string | undefined;
let beschrijving: string | undefined;
let downloadUrl: string | undefined;
let downloadBestand: any;
let ctaLabel = 'Download';

let eigenAfbeeldingUrl: string | undefined;

if (card.downloadBron === 'eigen') {
  titel = card.eigenDownloadTitel;
  beschrijving = card.eigenDownloadBeschrijving;
  downloadUrl = card.eigenDownloadBestandUrl;
  eigenAfbeeldingUrl = card.eigenDownloadAfbeeldingUrl;
  downloadBestand = null;
  ctaLabel = card.eigenDownloadCtaLabel || 'Download';
} else {
  // Default: homePage data
  titel = homePageDownload?.downloadTitel;
  beschrijving = homePageDownload?.downloadBeschrijving;
  downloadUrl = homePageDownload?.downloadUrl;
  downloadBestand = homePageDownload?.downloadBestand;
}

// Skip if no title or no downloadable content
if (!titel || !(downloadBestand || downloadUrl)) return;

// Eigen preview afbeelding heeft voorrang op bestand-detectie
const { hasImage, imageUrl: downloadImageUrl, imageUrlLarge: downloadImageUrlLarge } = eigenAfbeeldingUrl
  ? { hasImage: true, imageUrl: eigenAfbeeldingUrl, imageUrlLarge: eigenAfbeeldingUrl }
  : resolveDownloadImage(downloadBestand, downloadUrl);
const downloadFileName = extractFileName(downloadUrl);
const directDownloadUrl = downloadUrl ? `${downloadUrl}?dl=${downloadFileName}` : null;

// Unique ID for multiple lightboxes on the same page
const lightboxId = `download-lightbox-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="bg-white border border-neutral-200 border-l-[3px] border-l-accent animate-fade-in-up flex flex-col overflow-hidden" style={delay ? `animation-delay: ${delay}ms` : undefined}>
  {/* Afbeelding preview — klik opent lightbox */}
  {hasImage && downloadImageUrl && (
    <button type="button" data-lightbox-trigger={lightboxId} class="block w-full cursor-zoom-in">
      <img
        src={downloadImageUrl}
        alt={sanitizeAlt(titel)}
        class="w-full h-auto max-h-[300px] object-contain bg-neutral-50"
        width={600}
        loading="lazy"
      />
    </button>
  )}
  <div class="p-7 flex-1">
    <span class="text-3xl mb-3 block">📄</span>
    <h2 class="font-heading text-xl md:text-2xl font-bold text-primary mb-2">
      {titel}
    </h2>
    {beschrijving && (
      <p class="text-neutral-600 text-sm leading-relaxed">
        {beschrijving}
      </p>
    )}
  </div>
  {directDownloadUrl && (
    <div class="px-7 pb-7 pt-0 border-t border-neutral-100">
      <div class="pt-5">
        <a
          href={directDownloadUrl}
          download
          class="inline-flex items-center gap-2 px-6 py-2.5 min-h-[44px] bg-primary text-white font-bold text-sm hover:bg-primary-dark active:brightness-90 transition-all w-full sm:w-auto justify-center sm:justify-start"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
          </svg>
          {ctaLabel}
        </a>
      </div>
    </div>
  )}
</div>

{/* Lightbox overlay */}
{hasImage && downloadImageUrlLarge && (
  <div
    id={lightboxId}
    class="fixed inset-0 z-[999] hidden bg-black/80 backdrop-blur-sm cursor-zoom-out"
    role="dialog"
    aria-label="Afbeelding vergroten"
  >
    {/* Sluitknop — fixed positie, altijd bovenop */}
    <button
      data-lightbox-close={lightboxId}
      class="fixed top-4 right-4 z-[1000] min-w-[48px] min-h-[48px] flex items-center justify-center bg-black/80 text-white border-2 border-white/50 hover:bg-white hover:text-black transition-colors"
      aria-label="Sluiten"
    >
      <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    {/* Afbeelding gecentreerd */}
    <div class="w-full h-full flex items-center justify-center p-4 pt-16">
      <img
        src={downloadImageUrlLarge}
        alt={sanitizeAlt(titel)}
        class="max-w-full max-h-[85vh] object-contain animate-fade-in-up"
      />
    </div>
  </div>
)}

<script>
  function initDownloadLightboxes() {
    document.querySelectorAll('[data-lightbox-trigger]').forEach((trigger) => {
      if (trigger.hasAttribute('data-lightbox-bound')) return;
      trigger.setAttribute('data-lightbox-bound', '');

      const targetId = trigger.getAttribute('data-lightbox-trigger');
      const lightbox = document.getElementById(targetId!);
      if (!lightbox) return;

      const closeBtn = lightbox.querySelector('[data-lightbox-close]');

      trigger.addEventListener('click', () => {
        lightbox.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      });

      const closeLightbox = () => {
        lightbox.classList.add('hidden');
        document.body.style.overflow = '';
      };

      lightbox.addEventListener('click', (e) => {
        // Sluit bij klik op achtergrond (niet op de afbeelding zelf)
        if (e.target === lightbox || (e.target as HTMLElement).closest('[data-lightbox-close]')) return;
        const img = lightbox.querySelector('img');
        if (e.target !== img) closeLightbox();
      });
      closeBtn?.addEventListener('click', closeLightbox);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) closeLightbox();
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDownloadLightboxes);
  } else {
    initDownloadLightboxes();
  }
</script>
