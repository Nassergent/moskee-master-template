---
/**
 * HomeCardSlot.astro — Rendert de juiste card-variant op basis van CMS data.
 * Geeft niets weer als de card uitgeschakeld is of geen variant heeft.
 */
import EvenementCountdownCard from './EvenementCountdownCard.astro';
import DonatieCampagneCard from './DonatieCampagneCard.astro';
import DownloadCard from './DownloadCard.astro';
import AangepastCard from './AangepastCard.astro';

interface Props {
  card: any;
  /** Staggered animation delay in ms */
  delay?: number;
  /** Islamic days data from Aladhan API (for countdown variant) */
  islamicDaysData?: any[];
  /** Mosque name for Google Calendar */
  mosqueName?: string;
  /** Download data from homePage singleton (for download variant with downloadBron=homePage) */
  homePageDownload?: {
    downloadTitel?: string;
    downloadBeschrijving?: string;
    downloadUrl?: string;
    downloadBestand?: any;
  };
}

const { card, delay = 0, islamicDaysData, mosqueName, homePageDownload } = Astro.props;

// Skip rendering if card is disabled or has no variant
if (!card?.ingeschakeld || !card?.variant) return;
---

{card.variant === 'evenementCountdown' && (
  <EvenementCountdownCard card={card} delay={delay} islamicDaysData={islamicDaysData} mosqueName={mosqueName} />
)}

{card.variant === 'donatieCampagne' && (
  <DonatieCampagneCard card={card} delay={delay} />
)}

{card.variant === 'download' && (
  <DownloadCard card={card} delay={delay} homePageDownload={homePageDownload} />
)}

{card.variant === 'aangepast' && (
  <AangepastCard card={card} delay={delay} />
)}
