---
/**
 * PrayerManager.astro — Hybride gebedstijden (Flat Design)
 *
 * Dagelijkse tijden: Mawaqit iframe (automatisch, incl. Iqamah)
 * Vrijdaggebed: Handmatig via Sanity CMS
 */
import { fetchPrayerTimes } from '../lib/sanity';

interface Props {
  /** Toon alleen de Mawaqit embed (voor homepage compact view) */
  compact?: boolean;
}

const { compact = false } = Astro.props;
const prayer = await fetchPrayerTimes();
// Bouw de embed URL: /w/ is de iframe-vriendelijke versie van Mawaqit
const slug = prayer.mawaqitSlug || '';
const extractedSlug = slug.startsWith('http')
  ? new URL(slug).pathname.split('/').filter(Boolean).pop()
  : slug;
const mawaqitUrl = `https://mawaqit.net/nl/w/${extractedSlug}`;
// Gewone pagina-URL (voor links, niet voor iframes)
const mawaqitPageUrl = `https://mawaqit.net/nl/${extractedSlug}`;
---

<!-- Mawaqit Dagelijkse Gebedstijden -->
<div class="bg-white border border-neutral-200 border-l-4 border-l-accent overflow-hidden relative" id="mawaqit-wrapper">
  <!-- Skeleton loader — verdwijnt wanneer iframe geladen is -->
  <div id="mawaqit-skeleton" class="absolute inset-0 bg-white z-10 flex flex-col items-center justify-center gap-4" style={compact ? 'height: 400px' : 'height: 600px'}>
    <div class="w-12 h-12 border-3 border-accent/30 border-t-accent rounded-full animate-spin"></div>
    <p class="text-sm text-neutral-400">Gebedstijden laden...</p>
  </div>
  <iframe
    src={mawaqitUrl}
    title="Dagelijkse gebedstijden via Mawaqit"
    class="w-full border-0"
    style={compact ? 'height: 400px' : 'height: 600px'}
    loading="lazy"
    allow="fullscreen"
    referrerpolicy="no-referrer"
    id="mawaqit-iframe"
  ></iframe>
</div>

<script>
  const iframe = document.getElementById('mawaqit-iframe');
  const skeleton = document.getElementById('mawaqit-skeleton');
  if (iframe && skeleton) {
    iframe.addEventListener('load', () => {
      skeleton.style.opacity = '0';
      skeleton.style.transition = 'opacity 0.3s ease';
      setTimeout(() => skeleton.remove(), 300);
    });
    // Fallback: verwijder skeleton na 8 seconden hoe dan ook
    setTimeout(() => {
      if (skeleton.parentNode) {
        skeleton.style.opacity = '0';
        skeleton.style.transition = 'opacity 0.3s ease';
        setTimeout(() => skeleton.remove(), 300);
      }
    }, 8000);
  }
</script>

