---
/**
 * PrayerManager.astro — WaqfOS Native Prayer Engine (v1.6)
 *
 * Compartiment: UI — delegeert alle berekeningen naar prayer-engine.ts
 *
 * Modi:
 *   compact=true    → homepage (kleine rijen, geen LivePrayerCard)
 *   fullscreen=true → gebedstijden mobiel (vult heel het scherm)
 *   default         → gebedstijden desktop (LivePrayerCard + PrayerGrid)
 */
import { fetchPrayerTimes } from '../lib/sanity';
import {
  isEngineConfigComplete,
  buildConfigFromSanity,
  computeFullPrayerTimes,
  getPrayerStatus,
} from '../lib/logic/prayer-engine';
import PrayerGrid from './ui/PrayerGrid.astro';
import LivePrayerCard from './ui/LivePrayerCard.astro';

interface Props {
  compact?: boolean;
  fullscreen?: boolean;
}

const { compact = false, fullscreen = false } = Astro.props;
const prayer = await fetchPrayerTimes();

const configComplete = isEngineConfigComplete(prayer);
let computedTimes = null;
let prayerStatus = null;

if (configComplete) {
  try {
    const config = buildConfigFromSanity(prayer);
    const now = new Date();
    computedTimes = computeFullPrayerTimes(now, config, prayer.jumuahShifts || []);
    prayerStatus = getPrayerStatus(now, computedTimes);
  } catch (e) {
    console.error('Prayer engine computation failed:', e);
  }
}
---

{computedTimes && prayerStatus ? (
  fullscreen ? (
    <!-- Fullscreen mobiel: countdown + grid vullen heel het scherm -->
    <div class="flex flex-col h-full">
      <LivePrayerCard
        times={computedTimes}
        currentPrayer={prayerStatus.currentPrayer}
        nextPrayer={prayerStatus.nextPrayer}
        secondsUntilNext={prayerStatus.secondsUntilNext}
      />
      <div class="flex-1 min-h-0">
        <PrayerGrid
          times={computedTimes}
          currentPrayer={prayerStatus.currentPrayer}
          nextPrayer={prayerStatus.nextPrayer}
          secondsUntilNext={prayerStatus.secondsUntilNext}
          fullscreen
        />
      </div>
    </div>
  ) : (
    <div class="space-y-6">
      {!compact && (
        <LivePrayerCard
          times={computedTimes}
          currentPrayer={prayerStatus.currentPrayer}
          nextPrayer={prayerStatus.nextPrayer}
          secondsUntilNext={prayerStatus.secondsUntilNext}
        />
      )}
      <PrayerGrid
        times={computedTimes}
        currentPrayer={prayerStatus.currentPrayer}
        nextPrayer={prayerStatus.nextPrayer}
        secondsUntilNext={prayerStatus.secondsUntilNext}
        compact={compact}
      />
    </div>
  )
) : (
  <div class="bg-white border border-neutral-200 border-l-[3px] border-l-red-500 p-8 text-center">
    <p class="text-sm text-neutral-600 mb-2">
      <strong>Gebedstijden niet beschikbaar</strong>
    </p>
    <p class="text-xs text-neutral-400">
      De gebedstijden configuratie is onvolledig. Ga naar het CMS en vul de coördinaten, tijdzone en berekeningsmethode in.
    </p>
  </div>
)}
