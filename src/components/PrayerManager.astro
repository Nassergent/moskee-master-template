---
/**
 * PrayerManager.astro — WaqfOS Native Prayer Engine (v1.7)
 *
 * Compartiment: UI — delegeert alle berekeningen naar prayer-engine.ts
 *
 * Modi:
 *   compact=true    → homepage (kleine rijen, geen LivePrayerCard)
 *   fullscreen=true → gebedstijden mobiel (Mawaqit-stijl layout)
 *   default         → gebedstijden desktop (LivePrayerCard + PrayerGrid)
 */
import {
  formatCountdownHMS,
} from '../lib/logic/prayer-engine';
import { formatHijriDate } from '../lib/hijri';
import { formatFullDate } from '../lib/logic/date-utils';
import PrayerGrid from './ui/PrayerGrid.astro';
import LivePrayerCard from './ui/LivePrayerCard.astro';
import type { ComputedPrayerTimes, PrayerStatus } from '../lib/logic/prayer-engine';

interface Props {
  compact?: boolean;
  fullscreen?: boolean;
  mosqueName?: string;
  locale?: string;
  /** Pre-computed prayer times from parent page */
  computedTimes?: ComputedPrayerTimes | null;
  /** Pre-computed prayer status from parent page */
  prayerStatus?: PrayerStatus | null;
}

const { compact = false, fullscreen = false, mosqueName = '', locale = 'nl-BE', computedTimes = null, prayerStatus = null } = Astro.props;

const hijriToday = formatHijriDate();
const gregorianToday = formatFullDate(new Date().toISOString().split('T')[0], locale);

// Filter alleen actieve Jumu'ah shifts (active !== false, zodat bestaande data zonder 'active' veld ook werkt)
const activeJumuahShifts = computedTimes?.jumuah?.filter((s: any) => s.active !== false) || [];
---

{computedTimes && prayerStatus ? (
  fullscreen ? (
    <!-- Fullscreen mobiel: Mawaqit-stijl layout -->
    <div class="flex flex-col h-full bg-base">
      {/* Hero: moskee naam + live klok + datums */}
      <div class="bg-primary-dark text-white px-5 pt-5 pb-4 text-center">
        {mosqueName && (
          <p class="text-sm font-heading font-bold text-white/80 mb-2 truncate">{mosqueName}</p>
        )}
        <p
          id="mawaqit-clock"
          class="text-5xl font-bold font-heading tabular-nums text-white leading-none"
          data-tz={computedTimes.timezone}
          data-locale={locale}
        >
          {new Date().toLocaleTimeString(locale, { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false, timeZone: computedTimes.timezone })}
        </p>
        <p class="text-white/50 font-arabic text-sm mt-2" lang="ar" dir="rtl">{hijriToday}</p>
        <p class="text-white/40 text-xs mt-0.5 capitalize">{gregorianToday}</p>
      </div>

      {/* Countdown balk + sound toggle */}
      <div
        class="bg-accent text-white px-5 py-2.5 flex items-center justify-between"
        id="mawaqit-countdown-bar"
        data-seconds={prayerStatus.secondsUntilNext}
        data-computed-at={new Date().toISOString()}
        data-next-label={prayerStatus.nextPrayer ? ({ fajr: 'Fajr', dhuhr: 'Dhuhr', asr: 'Asr', maghrib: 'Maghrib', isha: 'Isha' }[prayerStatus.nextPrayer]) : ''}
      >
        <div class="flex items-center gap-3">
          <span class="font-bold font-heading text-sm">
            {prayerStatus.nextPrayer ? ({ fajr: 'Fajr', dhuhr: 'Dhuhr', asr: 'Asr', maghrib: 'Maghrib', isha: 'Isha' }[prayerStatus.nextPrayer]) : ''} in
          </span>
          <span id="mawaqit-countdown" class="text-lg font-bold font-heading tabular-nums">
            {formatCountdownHMS(prayerStatus.secondsUntilNext)}
          </span>
        </div>
        <button
          id="sound-toggle-mobile"
          class="w-10 h-10 flex items-center justify-center text-white/70 hover:text-white active:text-white transition-colors"
          aria-label="Geluid aan/uit"
          aria-pressed="true"
        >🔔</button>
      </div>

      {/* Gebedstijden rijen */}
      <div class="flex-1 min-h-0">
        <PrayerGrid
          times={computedTimes}
          currentPrayer={prayerStatus.currentPrayer}
          nextPrayer={prayerStatus.nextPrayer}
          secondsUntilNext={prayerStatus.secondsUntilNext}
          fullscreen
        />
      </div>

      {/* Jumu'ah + Shurooq onderaan */}
      <div class="bg-primary-dark text-white px-5 py-3 flex items-center justify-between">
        <div class="text-center flex-1">
          <p class="text-[10px] uppercase tracking-wider text-white/50 font-bold">Djoemoe'ah</p>
          {activeJumuahShifts?.length > 1 ? (
            <div class="flex items-center justify-center gap-2">
              {activeJumuahShifts.map((shift: any) => (
                <div>
                  <p class="text-lg font-bold font-heading tabular-nums">{shift.time}</p>
                  {shift.label && <p class="text-[9px] text-white/40">{shift.label}</p>}
                </div>
              ))}
            </div>
          ) : (
            <p class="text-xl font-bold font-heading tabular-nums">
              {activeJumuahShifts?.[0]?.time || computedTimes.adhan.dhuhr}
            </p>
          )}
        </div>
        <div class="w-px h-8 bg-white/20" />
        <div class="text-center flex-1">
          <p class="text-[10px] uppercase tracking-wider text-white/50 font-bold">Shurooq</p>
          <p class="text-xl font-bold font-heading tabular-nums">{computedTimes.sunrise}</p>
        </div>
      </div>
    </div>

    <script>
      // Live klok
      const clockEl = document.getElementById('mawaqit-clock');
      if (clockEl) {
        const tz = clockEl.dataset.tz || 'Europe/Brussels';
        const clockLocale = clockEl.dataset.locale || 'nl-BE';
        function updateClock() {
          clockEl!.textContent = new Date().toLocaleTimeString(clockLocale, {
            hour: '2-digit', minute: '2-digit', second: '2-digit',
            hour12: false, timeZone: tz,
          });
        }
        const clockTick = setInterval(updateClock, 1000);
        document.addEventListener('astro:before-preparation', () => clearInterval(clockTick));
      }

      // Countdown
      import { startCountdownTicker } from '../lib/countdown-ticker';
      import { firePrayerAlert, warmUpAudioOnInteraction } from '../lib/prayer-alert';

      warmUpAudioOnInteraction();

      const countdownCleanup = startCountdownTicker({
        elementId: 'mawaqit-countdown-bar',
        displayId: 'mawaqit-countdown',
        format: 'hms',
        reloadOnZero: true,
        reloadDelay: 3000,
        onZero: firePrayerAlert,
      });

      document.addEventListener('astro:before-preparation', countdownCleanup);
    </script>
  ) : (
    <div class="space-y-6">
      {!compact && (
        <LivePrayerCard
          times={computedTimes}
          currentPrayer={prayerStatus.currentPrayer}
          nextPrayer={prayerStatus.nextPrayer}
          secondsUntilNext={prayerStatus.secondsUntilNext}
        />
      )}
      <PrayerGrid
        times={computedTimes}
        currentPrayer={prayerStatus.currentPrayer}
        nextPrayer={prayerStatus.nextPrayer}
        secondsUntilNext={prayerStatus.secondsUntilNext}
        compact={compact}
      />

      {/* Jumu'ah + Shurooq balk — desktop + compact */}
      <div class="bg-primary-dark text-white flex items-center justify-between overflow-hidden">
        <div class="text-center flex-1 py-4 px-5">
          <p class="text-[10px] uppercase tracking-wider text-white/50 font-bold mb-1">Djoemoe'ah</p>
          {activeJumuahShifts?.length > 1 ? (
            <div class="flex items-center justify-center gap-4">
              {activeJumuahShifts.map((shift: any) => (
                <div>
                  <p class="text-xl font-bold font-heading tabular-nums">{shift.time}</p>
                  {shift.label && <p class="text-[9px] text-white/40">{shift.label}</p>}
                </div>
              ))}
            </div>
          ) : (
            <p class="text-xl font-bold font-heading tabular-nums">
              {activeJumuahShifts?.[0]?.time || computedTimes.adhan.dhuhr}
            </p>
          )}
        </div>
        <div class="w-px h-10 bg-white/20" />
        <div class="text-center flex-1 py-4 px-5">
          <p class="text-[10px] uppercase tracking-wider text-white/50 font-bold mb-1">Shurooq</p>
          <p class="text-xl font-bold font-heading tabular-nums">{computedTimes.sunrise}</p>
        </div>
        <div class="w-px h-10 bg-white/20" />
        <div class="text-center py-4 px-5">
          <button
            id="sound-toggle-desktop"
            class="flex items-center gap-2 text-white/60 hover:text-white transition-colors"
            aria-label="Geluid aan/uit"
            aria-pressed="true"
          >
            <span class="sound-icon text-lg">🔔</span>
            <span class="sound-label text-[10px] uppercase tracking-wider font-bold">Geluid</span>
          </button>
        </div>
      </div>
    </div>
  )
) : (
  <div class="bg-white border border-neutral-200 border-l-[3px] border-l-red-500 p-8 text-center">
    <p class="text-sm text-neutral-600 mb-2">
      <strong>Gebedstijden niet beschikbaar</strong>
    </p>
    <p class="text-xs text-neutral-400">
      De gebedstijden configuratie is onvolledig. Ga naar het CMS en vul de coördinaten, tijdzone en berekeningsmethode in.
    </p>
  </div>
)}

{/* Unified sound toggle for all PrayerManager buttons */}
<script>
  import { isPrayerSoundEnabled, togglePrayerSound } from '../lib/prayer-alert';

  function initSoundToggle(btnId: string) {
    const btn = document.getElementById(btnId);
    if (!btn) return;
    const iconEl = btn.querySelector('.sound-icon');
    const labelEl = btn.querySelector('.sound-label');

    const update = () => {
      const on = isPrayerSoundEnabled();
      btn.setAttribute('aria-pressed', String(on));
      btn.setAttribute('aria-label', on ? 'Geluid uitzetten' : 'Geluid aanzetten');
      // Update icon (either child or button text)
      if (iconEl) {
        iconEl.textContent = on ? '\u{1F514}' : '\u{1F515}';
      } else {
        btn.textContent = on ? '\u{1F514}' : '\u{1F515}';
      }
      if (labelEl) {
        labelEl.textContent = on ? 'Geluid' : 'Stil';
      }
    };

    update();
    btn.addEventListener('click', () => {
      const newState = togglePrayerSound();
      update();
      // Sync other toggle buttons on the page
      document.querySelectorAll('[id^="sound-toggle"]').forEach(other => {
        if (other.id !== btnId) {
          const otherIcon = other.querySelector('.sound-icon');
          if (otherIcon) otherIcon.textContent = newState ? '\u{1F514}' : '\u{1F515}';
          else other.textContent = newState ? '\u{1F514}' : '\u{1F515}';
          other.setAttribute('aria-pressed', String(newState));
          const otherLabel = other.querySelector('.sound-label');
          if (otherLabel) otherLabel.textContent = newState ? 'Geluid' : 'Stil';
        }
      });
    });
  }

  initSoundToggle('sound-toggle-mobile');
  initSoundToggle('sound-toggle-desktop');
</script>
