---
/**
 * JanazahBanner.astro — Sobere 'Eerbied Band' bij actief janazah-gebed
 *
 * Elite UI v1.7.1: Overspannende band onder de Hero. Donkerder dan primary,
 * subtiele border-t scheiding. Arabisch prominent, Nederlands rustig.
 * Geen animaties, geen iconen, geen uppercase. Privacy-aware.
 */
import { getDisplayName } from '../../../lib/logic/janazah';

interface Props {
  alert: {
    naamOverledene?: string;
    gebedstijdstip?: string;
    gebeddatum?: string;
    duaArabisch?: string;
    familyConsent?: boolean;
  };
}

const { alert } = Astro.props;

const displayName = getDisplayName(alert as any);
const datumStr = alert.gebeddatum
  ? new Date(alert.gebeddatum + 'T00:00:00').toLocaleDateString('nl-BE', {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
    })
  : null;
---

<div class="relative bg-primary-dark border-t border-white/10">
  <!-- Donkere overlay voor extra diepte -->
  <div class="absolute inset-0 bg-black/15"></div>

  <div class="relative max-w-[1280px] mx-auto px-6 py-4 md:py-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 md:gap-8">

      <!-- Links: Arabische dua — prominent -->
      <p class="font-amiri text-accent-light text-2xl md:text-3xl tracking-wide leading-relaxed shrink-0" dir="rtl" lang="ar">
        إِنَّا لِلَّٰهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ
      </p>

      <!-- Rechts: Nederlandse melding + link -->
      <div class="flex-1 min-w-0">
        <p class="text-white/90 text-sm md:text-base leading-relaxed">
          Wij hebben vernomen dat <strong class="text-white font-semibold">{displayName}</strong> is teruggekeerd naar Allah.{' '}
          {alert.gebedstijdstip && datumStr && (
            <span class="text-white/70">
              Janazah-gebed op {datumStr}, {alert.gebedstijdstip}.
            </span>
          )}
          {alert.gebedstijdstip && !datumStr && (
            <span class="text-white/70">Janazah-gebed om {alert.gebedstijdstip}.</span>
          )}
          {!alert.gebedstijdstip && datumStr && (
            <span class="text-white/70">Janazah-gebed op {datumStr}.</span>
          )}
        </p>

        <!-- Elegante tekstlink met accent-onderlijn -->
        <a
          href="/janazah"
          class="inline-block mt-2 text-xs text-white/50 hover:text-accent-light border-b border-accent/40 hover:border-accent pb-px transition-colors"
        >
          Meer info over de janazah-procedure
        </a>
      </div>

    </div>
  </div>
</div>
