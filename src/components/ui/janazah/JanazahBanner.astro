---
/**
 * JanazahBanner.astro — Sobere 'Eerbied Band' bij actief janazah-gebed
 *
 * Elite UI v1.7.2: Gecentreerd blok — Arabisch en Nederlands als één geheel.
 * Schone zinnen, automatische naam-capitalisatie, subtiele link met pijltje.
 * Gebedsinfo via buildGebedZin() uit logic layer (geen inline string-bouw).
 */
import { getDisplayName, buildGebedZin } from '../../../lib/logic/janazah';

interface Props {
  alert: {
    naamOverledene?: string;
    naGebed?: string;
    gebedstijdstip?: string;
    gebeddatum?: string;
    duaArabisch?: string;
    familyConsent?: boolean;
  };
}

const { alert } = Astro.props;

const displayName = getDisplayName(alert as any);
const gebedZin = buildGebedZin(alert as any);
---

<div class="relative bg-primary-dark border-t border-white/10">
  <div class="absolute inset-0 bg-black/15"></div>

  <div class="relative max-w-[1280px] mx-auto px-6 py-5 md:py-7">
    <div class="flex flex-col items-center text-center gap-3">

      <!-- Arabische dua -->
      <p class="font-amiri text-accent-light text-2xl md:text-3xl tracking-wide leading-relaxed" dir="rtl" lang="ar">
        إِنَّا لِلَّٰهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ
      </p>

      <!-- Nederlandse melding -->
      <p class="text-white/90 text-sm md:text-base leading-relaxed max-w-2xl">
        {alert.familyConsent && alert.naamOverledene
          ? <>Onze broeder <strong class="text-white font-semibold">{displayName}</strong> is teruggekeerd tot Allah.</>
          : <>Wij hebben vernomen dat <strong class="text-white font-semibold">{displayName}</strong> is teruggekeerd tot Allah.</>
        }
        {gebedZin && <span class="text-white/70">{` ${gebedZin}`}</span>}
      </p>

      <!-- Subtiele link met pijltje -->
      <a
        href="/janazah"
        class="inline-flex items-center gap-1 text-[11px] text-white/40 hover:text-accent-light transition-colors mt-1"
      >
        Meer info <span aria-hidden="true">&rarr;</span>
      </a>

    </div>
  </div>
</div>
