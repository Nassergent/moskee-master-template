---
interface Props {
  postType?: string;
}

const { postType = 'nieuws' } = Astro.props;

const config: Record<string, { label: string; color: string }> = {
  nieuws:     { label: 'Nieuws',     color: '#166534' },
  mededeling: { label: 'Mededeling', color: '#92400e' },
  artikel:    { label: 'Artikel',    color: '#1e40af' },
};

const badge = config[postType] || config.nieuws;
---

<span
  class="inline-block px-2 py-0.5 text-xs font-semibold uppercase tracking-wider"
  style={`background-color: ${badge.color}20; color: ${badge.color};`}
>
  {badge.label}
</span>
