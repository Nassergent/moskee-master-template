---
/**
 * PracticalInfo.astro — 3-column grid: Leeftijd & Niveaus / Inschrijving / Contact
 *
 * Flat Design: border-l-[3px] border-l-accent on all cards.
 */

interface Props {
  leeftijdsgroep?: string;
  niveaus?: string[];
  maxCapaciteit?: number;
  inschrijvingOpen?: boolean;
  inschrijvingLink?: string;
}

const { leeftijdsgroep, niveaus, maxCapaciteit, inschrijvingOpen, inschrijvingLink } = Astro.props;
const hasInfo = leeftijdsgroep || (niveaus && niveaus.length > 0) || maxCapaciteit || inschrijvingOpen;
---

{hasInfo && (
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-8">
    <!-- Leeftijd & Niveaus -->
    <div class="bg-white border border-neutral-200 border-l-[3px] border-l-accent p-5">
      <h3 class="font-heading font-bold text-sm uppercase tracking-wider text-neutral-400 mb-3">Leeftijd & Niveaus</h3>
      {leeftijdsgroep && (
        <p class="text-neutral-700 mb-2">
          <span class="font-bold">Leeftijd:</span> {leeftijdsgroep}
        </p>
      )}
      {niveaus && niveaus.length > 0 && (
        <p class="text-neutral-700 mb-2">
          <span class="font-bold">Niveaus:</span> {niveaus.join(', ')}
        </p>
      )}
      {maxCapaciteit && (
        <p class="text-neutral-700">
          <span class="font-bold">Max. plaatsen:</span> {maxCapaciteit}
        </p>
      )}
    </div>

    <!-- Inschrijving -->
    <div class="bg-white border border-neutral-200 border-l-[3px] border-l-accent p-5">
      <h3 class="font-heading font-bold text-sm uppercase tracking-wider text-neutral-400 mb-3">Inschrijving</h3>
      {inschrijvingOpen ? (
        <div>
          <p class="text-neutral-700 mb-3">Inschrijvingen zijn momenteel open.</p>
          <a
            href={inschrijvingLink || '/contact'}
            class="inline-flex items-center px-5 py-2 bg-accent hover:bg-accent-hover text-white font-bold text-sm transition-all"
            target={inschrijvingLink ? '_blank' : undefined}
            rel={inschrijvingLink ? 'noopener noreferrer' : undefined}
          >
            Schrijf je in
          </a>
        </div>
      ) : (
        <p class="text-neutral-500">Inschrijvingen zijn momenteel gesloten.</p>
      )}
    </div>

    <!-- Contact -->
    <div class="bg-white border border-neutral-200 border-l-[3px] border-l-accent p-5">
      <h3 class="font-heading font-bold text-sm uppercase tracking-wider text-neutral-400 mb-3">Vragen?</h3>
      <p class="text-neutral-700 mb-3">Neem contact met ons op voor meer informatie over dit programma.</p>
      <a
        href="/contact"
        class="inline-flex items-center px-5 py-2 bg-primary hover:bg-primary-dark text-white font-bold text-sm transition-all"
      >
        Contact opnemen
      </a>
    </div>
  </div>
)}
