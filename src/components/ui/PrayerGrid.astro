---
/**
 * PrayerGrid.astro — 5-column prayer grid (El Albani Flat Design)
 *
 * Compartiment: UI
 * 100% SSR, geen JavaScript.
 * Ontvangt ComputedPrayerTimes als prop — doet NOOIT eigen berekeningen.
 */

import { PRAYER_NAMES, PRAYER_LABELS, type ComputedPrayerTimes, type PrayerName } from '../../lib/logic/prayer-engine';

interface Props {
  times: ComputedPrayerTimes;
  currentPrayer?: PrayerName | null;
  nextPrayer?: PrayerName | null;
  secondsUntilNext?: number;
}

const { times, currentPrayer = null, nextPrayer = null, secondsUntilNext = 0 } = Astro.props;

/** Format seconds as "Xu Ym" for compact display */
function formatCompactCountdown(secs: number): string {
  if (secs <= 0) return '';
  const h = Math.floor(secs / 3600);
  const m = Math.floor((secs % 3600) / 60);
  if (h > 0) return `${h}u ${m}m`;
  return `${m}m`;
}
---

<!-- Prayer Grid — Desktop: 5 kolommen, Mobiel: nette rijen -->
<div class="border border-neutral-200 overflow-hidden">

  {/* ── Desktop: 5-kolom grid ── */}
  <div class="hidden sm:grid sm:grid-cols-5 gap-0">
    {PRAYER_NAMES.map((name) => {
      const isCurrent = currentPrayer === name;
      const isNext = nextPrayer === name;
      return (
        <div
          class:list={[
            'flex flex-col items-center py-6 border-r last:border-r-0 transition-colors',
            isCurrent
              ? 'bg-primary text-white'
              : 'bg-white hover:bg-base-100',
          ]}
        >
          <p class:list={[
            'text-xs font-bold uppercase tracking-[0.15em] mb-3',
            isCurrent ? 'text-white/80' : 'text-neutral-400',
          ]}>
            {PRAYER_LABELS[name]}
          </p>

          <p class:list={[
            'text-3xl font-bold font-heading tabular-nums',
            isCurrent ? 'text-white' : 'text-primary',
          ]}>
            {times.adhan[name]}
          </p>

          <div class="h-6 flex items-center mt-2">
            {times.iqama[name] ? (
              <div class="flex items-center gap-1.5">
                <span class:list={[
                  'text-[10px] uppercase tracking-wider font-bold',
                  isCurrent ? 'text-[#E8CDB5]' : 'text-accent',
                ]}>Iqama</span>
                <span class:list={[
                  'text-sm font-bold tabular-nums',
                  isCurrent ? 'text-[#E8CDB5]' : 'text-accent',
                ]}>{times.iqama[name]}</span>
              </div>
            ) : null}
          </div>

          {isNext && secondsUntilNext > 0 && (
            <p
              id="grid-countdown"
              data-seconds={secondsUntilNext}
              class="text-[10px] font-bold uppercase tracking-wider text-primary mt-1 tabular-nums"
            >
              In {formatCompactCountdown(secondsUntilNext)}
            </p>
          )}

          {isCurrent && (
            <div class="w-1.5 h-1.5 bg-accent mt-3" aria-hidden="true" />
          )}
        </div>
      );
    })}
  </div>

  {/* ── Mobiel: nette rij-kaarten ── */}
  <div class="sm:hidden divide-y divide-neutral-200">
    {PRAYER_NAMES.map((name) => {
      const isCurrent = currentPrayer === name;
      const isNext = nextPrayer === name;
      return (
        <div
          class:list={[
            'flex items-center px-5 py-4 transition-colors',
            isCurrent
              ? 'bg-primary text-white'
              : 'bg-white',
          ]}
        >
          {/* Links: gebedsnaam + status */}
          <div class="w-24 shrink-0">
            <p class:list={[
              'text-sm font-bold uppercase tracking-wide',
              isCurrent ? 'text-white' : 'text-primary',
            ]}>
              {PRAYER_LABELS[name]}
            </p>
            {isCurrent && (
              <span class="inline-block mt-1 text-[10px] font-bold uppercase tracking-wider text-[#E8CDB5]">
                Nu
              </span>
            )}
            {isNext && secondsUntilNext > 0 && (
              <p
                id="grid-countdown"
                data-seconds={secondsUntilNext}
                class="text-[10px] font-bold uppercase tracking-wider text-accent mt-1 tabular-nums"
              >
                In {formatCompactCountdown(secondsUntilNext)}
              </p>
            )}
          </div>

          {/* Midden: adhan tijd */}
          <div class="flex-1 text-center">
            <p class:list={[
              'text-2xl font-bold font-heading tabular-nums',
              isCurrent ? 'text-white' : 'text-primary',
            ]}>
              {times.adhan[name]}
            </p>
          </div>

          {/* Rechts: iqama tijd */}
          <div class="w-24 shrink-0 text-right">
            {times.iqama[name] ? (
              <div>
                <p class:list={[
                  'text-[10px] uppercase tracking-wider font-bold',
                  isCurrent ? 'text-[#E8CDB5]/70' : 'text-accent/60',
                ]}>Iqama</p>
                <p class:list={[
                  'text-lg font-bold font-heading tabular-nums',
                  isCurrent ? 'text-[#E8CDB5]' : 'text-accent',
                ]}>{times.iqama[name]}</p>
              </div>
            ) : (
              <span class="text-[10px] text-neutral-300">—</span>
            )}
          </div>
        </div>
      );
    })}
  </div>

</div>

{/* Meta: berekeningsbron */}
<p class="text-[10px] text-neutral-400 mt-3 text-right">
  {times.meta.source === 'computed' && 'Berekend'}
  {times.meta.source === 'cache' && 'Uit cache'}
  {times.meta.source === 'fallback' && 'Laatste bekende tijden'}
  {' '}&middot; {times.meta.method} &middot; {times.meta.madhab === 'hanafi' ? 'Hanafi' : 'Shafi\'i'}
</p>

{/* Live countdown ticker voor het volgende gebed — <500B */}
{nextPrayer && secondsUntilNext > 0 && (
  <script>
    const el = document.getElementById('grid-countdown');
    if (el) {
      let secs = parseInt(el.dataset.seconds || '0', 10);
      const tick = setInterval(() => {
        secs--;
        if (secs <= 0) { clearInterval(tick); el.textContent = 'Nu'; return; }
        const h = Math.floor(secs / 3600);
        const m = Math.floor((secs % 3600) / 60);
        el.textContent = h > 0 ? `In ${h}u ${m}m` : `In ${m}m`;
      }, 60000); // Update elke minuut (geen seconde-ticker nodig voor compact format)
      document.addEventListener('astro:before-preparation', () => clearInterval(tick));
    }
  </script>
)}
