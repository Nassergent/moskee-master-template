---
/**
 * PrayerGrid.astro — 5-column prayer grid (El Albani Flat Design)
 *
 * Compartiment: UI
 * 100% SSR, geen JavaScript (behalve kleine countdown ticker).
 *
 * compact=true    → homepage mobiel (kleinere rijen, iqama als tijd)
 * fullscreen=true → gebedstijden mobiel (rijen vullen heel het scherm)
 * default         → desktop 5-kolom grid
 */

import { PRAYER_NAMES, PRAYER_LABELS, formatCountdownCompact, getIqamaOffset, type ComputedPrayerTimes, type PrayerName } from '../../lib/logic/prayer-engine';

interface Props {
  times: ComputedPrayerTimes;
  currentPrayer?: PrayerName | null;
  nextPrayer?: PrayerName | null;
  secondsUntilNext?: number;
  compact?: boolean;
  fullscreen?: boolean;
}

const { times, currentPrayer = null, nextPrayer = null, secondsUntilNext = 0, compact = false, fullscreen = false } = Astro.props;
---

{/* ── Fullscreen mobiel: rijen vullen 100% hoogte ── */}
{fullscreen && (
  <div class="flex flex-col h-full divide-y divide-neutral-100">
    {PRAYER_NAMES.map((name) => {
      const isCurrent = currentPrayer === name;
      const isNext = nextPrayer === name;
      const offset = getIqamaOffset(times.adhan[name], times.iqama[name]);
      return (
        <div
          class:list={[
            'flex-1 flex items-center px-5 transition-colors',
            isCurrent ? 'bg-accent' : 'bg-white',
          ]}
        >
          {/* Links: gebedsnaam */}
          <div class="w-24 shrink-0">
            <p class:list={[
              'text-base font-bold font-heading',
              isCurrent ? 'text-white' : 'text-primary',
            ]}>
              {PRAYER_LABELS[name]}
            </p>
            {isCurrent && (
              <span class="text-[10px] font-bold uppercase tracking-wider text-white/70">Nu</span>
            )}
            {isNext && secondsUntilNext > 0 && (
              <p
                class="js-grid-countdown text-[10px] font-bold uppercase tracking-wider text-primary/60 tabular-nums"
                data-seconds={secondsUntilNext}
                data-computed-at={new Date().toISOString()}
              >
                In {formatCountdownCompact(secondsUntilNext)}
              </p>
            )}
          </div>

          {/* Midden: adhan tijd */}
          <div class="flex-1 text-center">
            <p class:list={[
              'text-3xl font-bold font-heading tabular-nums',
              isCurrent ? 'text-white' : 'text-primary',
            ]}>
              {times.adhan[name]}
            </p>
          </div>

          {/* Rechts: iqama offset */}
          <div class="w-16 shrink-0 text-right">
            {offset ? (
              <p class:list={[
                'text-xl font-bold font-heading tabular-nums',
                isCurrent ? 'text-white/80' : 'text-accent',
              ]}>
                {offset}
              </p>
            ) : (
              <span class="text-neutral-300">&mdash;</span>
            )}
          </div>
        </div>
      );
    })}
  </div>
)}

{/* ── Niet-fullscreen: desktop grid + compact mobiel ── */}
{!fullscreen && (
  <div class="relative border border-neutral-200 overflow-hidden">
    {/* Geluid toggle */}
    <button
      id="sound-toggle"
      class="absolute top-2 right-2 z-10 w-8 h-8 flex items-center justify-center text-sm text-neutral-400 hover:text-primary transition-colors"
      aria-label="Geluid aan/uit"
      aria-pressed="true"
    >🔔</button>

    {/* Desktop/Tablet: 5-kolom grid */}
    <div class="hidden sm:grid sm:grid-cols-5 gap-0">
      {PRAYER_NAMES.map((name) => {
        const isCurrent = currentPrayer === name;
        const isNext = nextPrayer === name;
        return (
          <div
            class:list={[
              'flex flex-col items-center py-6 border-r last:border-r-0 transition-colors',
              isCurrent
                ? 'bg-primary text-white'
                : 'bg-white hover:bg-base-100',
            ]}
            data-prayer-active={isCurrent ? 'true' : undefined}
            data-next-prayer={isNext ? PRAYER_LABELS[name] : undefined}
          >
            <p class:list={[
              'text-xs font-bold uppercase tracking-[0.15em] mb-3',
              isCurrent ? 'text-white/80' : 'text-neutral-400',
            ]}>
              {PRAYER_LABELS[name]}
            </p>

            <p class:list={[
              'text-3xl font-bold font-heading tabular-nums',
              isCurrent ? 'text-white' : 'text-primary',
            ]}>
              {times.adhan[name]}
            </p>

            <div class="h-6 flex items-center mt-2">
              {times.iqama[name] ? (
                <div class="flex items-center gap-1.5">
                  <span class:list={[
                    'text-[10px] uppercase tracking-wider font-bold',
                    isCurrent ? 'text-[var(--color-iqama-current)]' : 'text-accent',
                  ]}>Iqama</span>
                  <span class:list={[
                    'text-sm font-bold tabular-nums',
                    isCurrent ? 'text-[var(--color-iqama-current)]' : 'text-accent',
                  ]}>{times.iqama[name]}</span>
                </div>
              ) : null}
            </div>

            {isNext && secondsUntilNext > 0 && (
              <p
                class="js-grid-countdown text-[10px] font-bold uppercase tracking-wider text-primary mt-1 tabular-nums"
                data-seconds={secondsUntilNext}
                data-computed-at={new Date().toISOString()}
              >
                In {formatCountdownCompact(secondsUntilNext)}
              </p>
            )}

            {isCurrent && (
              <div class="w-1.5 h-1.5 bg-accent mt-3" aria-hidden="true" />
            )}
          </div>
        );
      })}
    </div>

    {/* Compact mobiel (homepage) */}
    <div class="sm:hidden divide-y divide-neutral-100">
      {PRAYER_NAMES.map((name) => {
        const isCurrent = currentPrayer === name;
        const isNext = nextPrayer === name;
        return (
          <div
            class:list={[
              'flex items-center px-5 py-3.5 transition-colors',
              isCurrent ? 'bg-primary' : 'bg-white',
            ]}
          >
            <div class="w-20 shrink-0">
              <p class:list={[
                'text-sm font-bold uppercase tracking-wide',
                isCurrent ? 'text-white' : 'text-primary',
              ]}>
                {PRAYER_LABELS[name]}
              </p>
              {isCurrent && (
                <span class="inline-block mt-0.5 text-[10px] font-bold uppercase tracking-wider text-[var(--color-iqama-current)]">Nu</span>
              )}
              {isNext && secondsUntilNext > 0 && (
                <p
                  class="js-grid-countdown text-[10px] font-bold uppercase tracking-wider text-accent mt-0.5 tabular-nums"
                  data-seconds={secondsUntilNext}
                  data-computed-at={new Date().toISOString()}
                >
                  In {formatCountdownCompact(secondsUntilNext)}
                </p>
              )}
            </div>

            <div class="flex-1 text-center">
              <p class:list={[
                'text-2xl font-bold font-heading tabular-nums',
                isCurrent ? 'text-white' : 'text-primary',
              ]}>
                {times.adhan[name]}
              </p>
            </div>

            <div class="w-20 shrink-0 text-right">
              {times.iqama[name] ? (
                <div>
                  <p class:list={[
                    'text-[10px] uppercase tracking-wider font-bold',
                    isCurrent ? 'text-[var(--color-iqama-current)]/70' : 'text-accent/60',
                  ]}>Iqama</p>
                  <p class:list={[
                    'text-lg font-bold font-heading tabular-nums',
                    isCurrent ? 'text-[var(--color-iqama-current)]' : 'text-accent',
                  ]}>{times.iqama[name]}</p>
                </div>
              ) : (
                <span class="text-[10px] text-neutral-300">&mdash;</span>
              )}
            </div>
          </div>
        );
      })}
    </div>

  </div>
)}

{/* Meta */}
{!fullscreen && (
  <p class="text-[10px] text-neutral-400 mt-3 text-right">
    {times.meta.source === 'computed' && 'Berekend'}
    {times.meta.source === 'cache' && 'Uit cache'}
    {times.meta.source === 'fallback' && 'Laatste bekende tijden'}
    {' '}&middot; {times.meta.method} &middot; {times.meta.madhab === 'hanafi' ? 'Hanafi' : 'Shafi\'i'}
  </p>
)}

{/* Live countdown ticker */}
{nextPrayer && secondsUntilNext > 0 && (
  <script>
    import { formatCountdownCompact } from '../../lib/countdown-ticker';
    import { firePrayerAlert, warmUpAudioOnInteraction } from '../../lib/prayer-alert';

    // Warm up audio context on first user touch (mobile fix)
    warmUpAudioOnInteraction();

    // Drift-free countdown for ALL grid elements (fullscreen, desktop, compact)
    const countdownEls = document.querySelectorAll('.js-grid-countdown');
    if (countdownEls.length > 0) {
      const firstEl = countdownEls[0] as HTMLElement;
      const serverSeconds = parseInt(firstEl.dataset.seconds || '0', 10);

      // Correct for CDN cache age
      let cacheAge = 0;
      const computedAt = firstEl.dataset.computedAt;
      if (computedAt) {
        const t = new Date(computedAt).getTime();
        if (!isNaN(t)) cacheAge = Math.max(0, (Date.now() - t) / 1000);
      }

      const initialRemaining = Math.max(0, serverSeconds - cacheAge);
      const startTime = Date.now();
      let hasFired = false;

      const getRemaining = () => Math.max(0, initialRemaining - (Date.now() - startTime) / 1000);

      const updateAll = (text: string) => {
        countdownEls.forEach(el => { el.textContent = text; });
      };

      const render = () => {
        const r = getRemaining();
        if (r <= 0 && !hasFired) {
          hasFired = true;
          updateAll('Nu');
          clearInterval(interval);
          firePrayerAlert();
          return;
        }
        if (!hasFired) updateAll(formatCountdownCompact(r));
      };

      render();
      const interval = setInterval(render, 60000);

      // Resync on tab visibility change
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden && !hasFired) render();
      });

      document.addEventListener('astro:before-preparation', () => clearInterval(interval));
    }
  </script>
)}

{/* Geluid toggle */}
<script>
  import { isPrayerSoundEnabled, togglePrayerSound } from '../../lib/prayer-alert';

  const btn = document.getElementById('sound-toggle');
  if (btn) {
    const update = () => {
      const on = isPrayerSoundEnabled();
      btn.setAttribute('aria-label', on ? 'Geluid uitzetten' : 'Geluid aanzetten');
      btn.setAttribute('aria-pressed', String(on));
      btn.textContent = on ? '\u{1F514}' : '\u{1F515}';
    };
    update();
    btn.addEventListener('click', () => { togglePrayerSound(); update(); });
  }
</script>
