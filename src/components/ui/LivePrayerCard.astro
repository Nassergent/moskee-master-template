---
/**
 * LivePrayerCard.astro — Desktop countdown + huidig gebed status
 *
 * Compartiment: UI
 * Mobiel fullscreen is nu in PrayerManager (Mawaqit-stijl).
 * Dit component = alleen desktop twee-kolom card.
 */

import { PRAYER_LABELS, formatCountdownHMS, type ComputedPrayerTimes, type PrayerName } from '../../lib/logic/prayer-engine';

interface Props {
  times: ComputedPrayerTimes;
  currentPrayer: PrayerName | null;
  nextPrayer: PrayerName;
  secondsUntilNext: number;
}

const { times, currentPrayer, nextPrayer, secondsUntilNext } = Astro.props;

const currentLabel = currentPrayer ? PRAYER_LABELS[currentPrayer] : null;
const currentTime = currentPrayer ? times.adhan[currentPrayer] : null;
const currentIqama = currentPrayer ? times.iqama[currentPrayer] : null;

const nextLabel = PRAYER_LABELS[nextPrayer];
const nextTime = times.adhan[nextPrayer];
---

<!-- Desktop: twee-kolom card -->
<div class="hidden sm:block bg-white border border-neutral-200 border-l-[3px] border-l-accent overflow-hidden">
  <div class="grid grid-cols-2 gap-0">

    <div class="bg-primary text-white p-6 md:p-8">
      {currentPrayer ? (
        <>
          <p class="text-[10px] uppercase tracking-[0.2em] text-white/60 mb-2 font-bold">Nu</p>
          <p class="text-3xl md:text-4xl font-bold font-heading mb-1">{currentLabel}</p>
          <p class="text-2xl font-heading tabular-nums text-white/90">{currentTime}</p>
          {currentIqama && (
            <p class="text-sm text-[#E8CDB5] mt-2">Iqama: <span class="font-bold">{currentIqama}</span></p>
          )}
        </>
      ) : (
        <>
          <p class="text-[10px] uppercase tracking-[0.2em] text-white/60 mb-2 font-bold">Wachten op</p>
          <p class="text-3xl md:text-4xl font-bold font-heading">{nextLabel}</p>
        </>
      )}
    </div>

    <div class="p-6 md:p-8 flex flex-col justify-center">
      <p class="text-[10px] uppercase tracking-[0.2em] text-neutral-400 mb-2 font-bold">
        {currentPrayer ? 'Volgend gebed' : 'Begint over'}
      </p>
      <p class="text-xl font-bold font-heading text-primary mb-1">{nextLabel}</p>
      <p class="text-sm text-neutral-500 mb-3">Adhan: {nextTime}</p>

      <div
        id="prayer-countdown"
        class="bg-base-100 border border-neutral-200 px-4 py-3 text-center"
        data-seconds={secondsUntilNext}
        data-computed-at={new Date().toISOString()}
        aria-live="polite"
      >
        <p class="text-[10px] uppercase tracking-[0.15em] text-neutral-400 mb-1 font-bold">Over</p>
        <p id="countdown-display" class="text-2xl md:text-3xl font-bold font-heading tabular-nums text-primary">
          {formatCountdownHMS(secondsUntilNext)}
        </p>
      </div>
    </div>

  </div>
</div>

<script>
  import { startCountdownTicker } from '../../lib/countdown-ticker';
  import { firePrayerAlert, warmUpAudioOnInteraction } from '../../lib/prayer-alert';

  warmUpAudioOnInteraction();

  const cleanup = startCountdownTicker({
    elementId: 'prayer-countdown',
    displayId: 'countdown-display',
    format: 'hms',
    reloadOnZero: true,
    reloadDelay: 5000,
    onZero: firePrayerAlert,
  });

  document.addEventListener('astro:before-preparation', cleanup);
  window.addEventListener('beforeunload', cleanup);
</script>
