---
interface Props {
  iban: string;
  bankName: string;
  payconiqImage?: string;
  qrSvg?: string;
}

const { iban, bankName, payconiqImage, qrSvg } = Astro.props;

const cleanIban = iban.replace(/\s/g, '').toUpperCase();
---

<div class="bg-white border border-neutral-200 p-5 sm:p-8 md:p-10">
  <div class="space-y-6">
    <!-- Bankgegevens tabel -->
    <div class="space-y-3">
      <div class="flex justify-between items-center py-3 border-b border-neutral-100">
        <span class="text-slate-500">Begunstigde</span>
        <span class="font-medium text-slate-800">{bankName}</span>
      </div>
      <div class="flex justify-between items-center py-3 border-b border-neutral-100">
        <span class="text-slate-500">IBAN</span>
        <div class="flex items-center gap-2">
          <code class="font-mono font-medium text-slate-800 text-lg">{cleanIban}</code>
          <button
            type="button"
            data-iban={cleanIban}
            class="iban-copy-btn text-neutral-400 hover:text-primary transition-colors p-2.5 min-w-[44px] min-h-[44px] flex items-center justify-center"
            aria-label="Kopieer IBAN naar klembord"
          >
            <svg class="w-5 h-5 copy-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9.75a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
            </svg>
            <svg class="w-5 h-5 check-icon hidden text-green-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
          </button>
        </div>
      </div>
      <div class="flex justify-between items-center py-3">
        <span class="text-slate-500">Mededeling</span>
        <span class="font-medium text-slate-800">Donatie + projectnaam</span>
      </div>
    </div>

    <!-- QR Codes -->
    {(qrSvg || payconiqImage) && (
      <div class="border-t border-neutral-100 pt-6">
        <p class="text-sm text-slate-500 mb-4">Scan met uw bank-app om direct over te schrijven</p>
        <div class:list={[
          'flex gap-6',
          qrSvg && payconiqImage ? 'flex-col sm:flex-row items-start' : 'flex-col items-start',
        ]}>
          {qrSvg && (
            <div class="border-l-[3px] border-primary pl-4">
              <p class="text-xs font-semibold text-slate-600 mb-2 uppercase tracking-wide">Bank QR</p>
              <div
                aria-hidden="true"
                class="w-[200px] h-[200px] [&>svg]:w-full [&>svg]:h-full"
                set:html={qrSvg}
              />
            </div>
          )}
          {payconiqImage && (
            <div class="border-l-[3px] border-primary pl-4">
              <p class="text-xs font-semibold text-slate-600 mb-2 uppercase tracking-wide">Payconiq</p>
              <img
                src={payconiqImage}
                alt="Payconiq QR code"
                width="200"
                height="200"
                loading="lazy"
              />
            </div>
          )}
        </div>
      </div>
    )}
  </div>
</div>

<script is:inline>
(function() {
  document.querySelectorAll('.iban-copy-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var iban = btn.getAttribute('data-iban');
      if (!iban) return;

      var copyIcon = btn.querySelector('.copy-icon');
      var checkIcon = btn.querySelector('.check-icon');

      function showSuccess() {
        if (navigator.vibrate) navigator.vibrate(50);
        if (copyIcon) copyIcon.classList.add('hidden');
        if (checkIcon) checkIcon.classList.remove('hidden');
        setTimeout(function() {
          if (copyIcon) copyIcon.classList.remove('hidden');
          if (checkIcon) checkIcon.classList.add('hidden');
        }, 2000);
      }

      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(iban).then(showSuccess).catch(function() {});
      } else {
        var textarea = document.createElement('textarea');
        textarea.value = iban;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        try { document.execCommand('copy'); showSuccess(); } catch(e) {}
        document.body.removeChild(textarea);
      }
    });
  });
})();
</script>
