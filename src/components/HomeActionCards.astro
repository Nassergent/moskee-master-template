---
/**
 * HomeActionCards.astro — 3-kolom actiekaarten sectie (homepage)
 *
 * 1. Islamitische Countdown (als er een dag binnen 30 dagen is)
 * 2. Doneer — toont eerste actieve project uit Sanity CMS (met voortgang)
 * 3. Document Download (als er een bestand is geüpload in CMS)
 *
 * Grid past zich automatisch aan: 1, 2, of 3 kolommen.
 */
import { fetchIslamicDays, generateGoogleCalendarUrl } from '../lib/hijri';
import { calculateDonationProgress } from '../lib/logic/donation-utils';
import { urlFor } from '../lib/sanity';
import { sanitizeAlt } from '../lib/logic/seo-utils';

interface Props {
  hijriAdjustment?: number;
  islamicDays?: Record<string, boolean>;
  mosqueName?: string;
  // Project (eerste actieve) voor doneer kaart
  project?: {
    titel: string;
    beschrijving?: string;
    doelbedrag?: number;
    huidigBedragCents?: number;
    prijsPerEenheid?: number;
    eenheid?: string;
    afbeelding?: any;
  } | null;
  // Download kaart
  downloadTitel?: string;
  downloadBeschrijving?: string;
  downloadUrl?: string;
}

const {
  hijriAdjustment = 0,
  islamicDays,
  mosqueName,
  project,
  downloadTitel,
  downloadBeschrijving,
  downloadUrl,
} = Astro.props;

// ── Islamic Countdown — alle aankomende dagen ──
const allDays = await fetchIslamicDays(hijriAdjustment, islamicDays);
const upcoming = allDays.length > 0 ? allDays[0] : null;
const nextDays = allDays.slice(1); // alle volgende dagen als vooruitblik

const BETEKENIS: Record<string, string> = {
  'Start Ramadan': 'De heilige vastenmaand waarin de Quran werd geopenbaard',
  'Laylat al-Qadr': 'De Nacht van de Bestemming — beter dan duizend maanden',
  'Eid al-Fitr': 'Het feest van het verbreken van het vasten',
  'Eid al-Adha': 'Het offerfeest — herdenking van Ibrahim\'s overgave',
  'Dag van Arafah': 'De belangrijkste dag van de Hadj',
  'Ashura': 'Dag van bezinning en vasten',
  "Isra' & Mi'raj": 'De nachtelijke reis en hemelvaart van de Profeet ﷺ',
};

const betekenis = upcoming ? BETEKENIS[upcoming.name] || '' : '';
const formattedDate = upcoming
  ? new Date(upcoming.gregorianDate).toLocaleDateString('nl-BE', {
      weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
    })
  : '';
const calendarUrl = upcoming
  ? generateGoogleCalendarUrl({
      titel: upcoming.name,
      startDatum: `${upcoming.gregorianDate}T00:00:00`,
      eindDatum: `${upcoming.gregorianDate}T23:59:00`,
      beschrijving: `${upcoming.nameAr} — ${betekenis}`,
      mosqueName: mosqueName || undefined,
    })
  : '';

// ── Doneer project voortgang ──
const hasProject = !!(project && project.titel);
const progress = hasProject && project.doelbedrag
  ? calculateDonationProgress(project.huidigBedragCents || 0, project.doelbedrag)
  : null;

// ── Download ──
const isImage = downloadUrl ? /\.(jpe?g|png|webp|gif)$/i.test(downloadUrl) : false;
const downloadFileName = downloadUrl ? downloadUrl.split('/').pop()?.split('?')[0] || 'document' : 'document';
const directDownloadUrl = downloadUrl ? `${downloadUrl}?dl=${downloadFileName}` : null;

const showCountdown = !!upcoming;
const showDoneer = hasProject;
const showDownload = !!(downloadUrl && downloadTitel);
const cardCount = [showCountdown, showDoneer, showDownload].filter(Boolean).length;

const gridClass = cardCount === 3
  ? 'grid-cols-1 md:grid-cols-3'
  : cardCount === 2
    ? 'grid-cols-1 md:grid-cols-2'
    : 'grid-cols-1 max-w-lg mx-auto';
---

{cardCount > 0 && (
  <section class="py-14 sm:py-20 md:py-24 bg-base-100 text-neutral-900">
    <div class="max-w-[1280px] mx-auto px-6">
      <div class={`grid ${gridClass} gap-6`}>

        {/* ── Kaart 1: Islamitische Countdown ── */}
        {showCountdown && upcoming && (
          <div class="bg-white border border-neutral-200 border-l-[3px] border-l-accent animate-fade-in-up flex flex-col">
            <div class="p-7 flex-1">
              <h2 class="font-heading text-xl md:text-2xl font-bold text-primary mb-1">
                {upcoming.name}
              </h2>
              <p class="font-arabic text-base text-neutral-400 mb-3" dir="rtl">
                {upcoming.nameAr}
              </p>
              {betekenis && (
                <p class="text-neutral-600 text-sm leading-relaxed mb-4">
                  {betekenis}
                </p>
              )}
            </div>
            <div class="px-7 pb-7 pt-0 border-t border-neutral-100">
              <div class="flex items-end justify-between pt-5">
                <div>
                  {upcoming.daysUntil === 0 ? (
                    <span class="text-xl font-bold text-accent">Vandaag</span>
                  ) : (
                    <div class="flex items-baseline gap-2">
                      <span class="text-4xl md:text-5xl font-black text-primary leading-none">
                        {upcoming.daysUntil}
                      </span>
                      <span class="text-sm font-semibold text-neutral-500">
                        {upcoming.daysUntil === 1 ? 'dag' : 'dagen'}
                      </span>
                    </div>
                  )}
                  <p class="text-xs text-neutral-400 mt-1 capitalize">{formattedDate}</p>
                </div>
                <a
                  href={calendarUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent hover:text-primary transition-colors"
                  title="Voeg toe aan Google Agenda"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                  </svg>
                  Agenda
                </a>
              </div>
            </div>

            {/* Vooruitblik: volgende 2 dagen */}
            {nextDays.length > 0 && (
              <div class="px-7 pb-5 space-y-0">
                <p class="text-[10px] font-semibold text-neutral-400 uppercase tracking-wider mb-2">Daarna</p>
                {nextDays.map((day) => {
                  const dayDate = new Date(day.gregorianDate).toLocaleDateString('nl-BE', {
                    day: 'numeric', month: 'short',
                  });
                  return (
                    <div class="flex items-center justify-between py-2 border-t border-neutral-100">
                      <div class="flex items-center gap-2 min-w-0">
                        <span class="text-sm font-bold text-primary truncate">{day.name}</span>
                        <span class="font-arabic text-xs text-neutral-300 shrink-0" dir="rtl">{day.nameAr}</span>
                      </div>
                      <div class="flex items-center gap-3 shrink-0">
                        <span class="text-xs text-neutral-400">{dayDate}</span>
                        <span class="text-sm font-black text-primary">{day.daysUntil}<span class="text-[10px] font-semibold text-neutral-400 ml-0.5">d</span></span>
                      </div>
                    </div>
                  );
                })}
              </div>
            )}

          </div>
        )}

        {/* ── Kaart 2: Doneer — eerste actieve project uit Sanity ── */}
        {showDoneer && project && (
          <div class="bg-white border border-neutral-200 border-l-[3px] border-l-accent animate-fade-in-up flex flex-col overflow-hidden" style="animation-delay: 100ms">
            {project.afbeelding && (
              <img
                src={urlFor(project.afbeelding).width(600).height(250).fit('crop').url()}
                alt={sanitizeAlt(project.titel)}
                class="w-full aspect-[12/5] object-cover"
                loading="lazy"
              />
            )}
            <div class="p-7 flex-1">
              <h2 class="font-heading text-xl md:text-2xl font-bold text-primary mb-2">
                {project.titel}
              </h2>
              {project.beschrijving && (
                <p class="text-neutral-600 text-sm leading-relaxed mb-4">
                  {project.beschrijving}
                </p>
              )}

              {/* Prijs per eenheid */}
              {project.prijsPerEenheid && project.eenheid && (
                <p class="text-sm font-semibold text-accent mb-4">
                  &euro;{project.prijsPerEenheid} per {project.eenheid}
                </p>
              )}

              {/* Voortgangsbalk */}
              {progress && project.doelbedrag && (
                <div>
                  <div class="flex justify-between text-xs text-neutral-500 mb-1.5">
                    <span>&euro;{progress.huidigEuros.toLocaleString('nl-BE', { minimumFractionDigits: 2 })}</span>
                    <span>&euro;{project.doelbedrag.toLocaleString('nl-BE')}</span>
                  </div>
                  <div class:list={['w-full h-2.5 overflow-hidden', progress.isUrgent ? 'bg-accent/20' : 'bg-accent/10']}>
                    <div
                      class:list={['h-full transition-all duration-500', progress.isUrgent ? 'bg-accent animate-pulse' : 'bg-accent']}
                      style={`width: ${progress.percentage}%`}
                    />
                  </div>
                  <p class="text-xs text-neutral-400 mt-1.5">{progress.percentage}% bereikt</p>
                </div>
              )}
            </div>
            <div class="px-7 pb-7 pt-0 border-t border-neutral-100">
              <div class="pt-5">
                <a
                  href="/doneren"
                  class="inline-flex items-center gap-2 px-6 py-2.5 min-h-[44px] bg-accent text-white font-bold text-sm hover:bg-accent-hover active:brightness-90 transition-all"
                >
                  Steun dit doel
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        )}

        {/* ── Kaart 3: Document Download (met afbeelding preview) ── */}
        {showDownload && downloadUrl && (
          <div class="bg-white border border-neutral-200 border-l-[3px] border-l-accent animate-fade-in-up flex flex-col overflow-hidden" style="animation-delay: 200ms">
            {/* Afbeelding preview als het een image is — klik opent lightbox */}
            {isImage && (
              <button type="button" data-lightbox-trigger class="block w-full cursor-zoom-in">
                <img
                  src={downloadUrl}
                  alt={sanitizeAlt(downloadTitel)}
                  class="w-full h-auto max-h-[300px] object-contain bg-neutral-50"
                  loading="lazy"
                />
              </button>
            )}
            <div class="p-7 flex-1">
              <span class="text-3xl mb-3 block">📄</span>
              <h2 class="font-heading text-xl md:text-2xl font-bold text-primary mb-2">
                {downloadTitel}
              </h2>
              {downloadBeschrijving && (
                <p class="text-neutral-600 text-sm leading-relaxed">
                  {downloadBeschrijving}
                </p>
              )}
            </div>
            <div class="px-7 pb-7 pt-0 border-t border-neutral-100">
              <div class="pt-5">
                <a
                  href={directDownloadUrl}
                  download
                  class="inline-flex items-center gap-2 px-6 py-2.5 min-h-[44px] bg-primary text-white font-bold text-sm hover:bg-primary-dark active:brightness-90 transition-all"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                  </svg>
                  Download
                </a>
              </div>
            </div>
          </div>
        )}

      </div>
    </div>
  </section>
)}

{/* Lightbox overlay */}
{showDownload && isImage && (
  <div
    id="download-lightbox"
    class="fixed inset-0 z-[999] hidden items-center justify-center bg-black/80 backdrop-blur-sm p-4 cursor-zoom-out"
    role="dialog"
    aria-label="Afbeelding vergroten"
  >
    <img
      id="download-lightbox-img"
      src={downloadUrl}
      alt={sanitizeAlt(downloadTitel)}
      class="max-w-full max-h-[90vh] object-contain animate-fade-in-up"
    />
    <button
      id="download-lightbox-close"
      class="absolute top-6 right-6 text-white/70 hover:text-white transition-colors p-2"
      aria-label="Sluiten"
    >
      <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
)}

<script>
  const trigger = document.querySelector('[data-lightbox-trigger]');
  const lightbox = document.getElementById('download-lightbox');
  const closeBtn = document.getElementById('download-lightbox-close');

  if (trigger && lightbox) {
    trigger.addEventListener('click', () => {
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    });

    const closeLightbox = () => {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = '';
    };

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    closeBtn?.addEventListener('click', closeLightbox);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) closeLightbox();
    });
  }
</script>
