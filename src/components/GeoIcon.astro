---
/**
 * GeoIcon.astro — Islamitische geometrische iconen (SVG)
 *
 * Vervangt alle emoji's door elegante geometrische patronen.
 * Gebruik: <GeoIcon name="ster-8" size="md" />
 */
interface Props {
  name: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
}

const { name, size = 'md', class: className = '' } = Astro.props;

const sizeMap = {
  sm: 'w-5 h-5',
  md: 'w-8 h-8',
  lg: 'w-10 h-10',
  xl: 'w-14 h-14',
};
---

<svg
  class={`${sizeMap[size]} ${className}`}
  viewBox="0 0 100 100"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  {/* ✦ 8-puntige ster — Rub el Hizb */}
  {name === 'ster-8' && (
    <g stroke="currentColor" stroke-width="2" fill="currentColor" fill-opacity="0.08">
      <polygon points="50,5 61,39 95,39 67,61 78,95 50,73 22,95 33,61 5,39 39,39" />
    </g>
  )}

  {/* ◇ Ruit — Diamant */}
  {name === 'ruit' && (
    <g stroke="currentColor" stroke-width="2" fill="currentColor" fill-opacity="0.08">
      <polygon points="50,8 88,50 50,92 12,50" />
      <polygon points="50,24 74,50 50,76 26,50" />
    </g>
  )}

  {/* ❋ Rozet — 6-bladig bloemmotief */}
  {name === 'rozet' && (
    <g stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity="0.08">
      <circle cx="50" cy="50" r="30" />
      <ellipse cx="50" cy="20" rx="14" ry="22" transform="rotate(0 50 50)" />
      <ellipse cx="50" cy="20" rx="14" ry="22" transform="rotate(60 50 50)" />
      <ellipse cx="50" cy="20" rx="14" ry="22" transform="rotate(120 50 50)" />
      <ellipse cx="50" cy="20" rx="14" ry="22" transform="rotate(180 50 50)" />
      <ellipse cx="50" cy="20" rx="14" ry="22" transform="rotate(240 50 50)" />
      <ellipse cx="50" cy="20" rx="14" ry="22" transform="rotate(300 50 50)" />
    </g>
  )}

  {/* ⬡ Hexagon */}
  {name === 'hexagon' && (
    <g stroke="currentColor" stroke-width="2" fill="currentColor" fill-opacity="0.08">
      <polygon points="50,8 90,29 90,71 50,92 10,71 10,29" />
      <polygon points="50,24 74,36 74,64 50,76 26,64 26,36" />
    </g>
  )}

  {/* ◎ Concentrische cirkels — Eenheid */}
  {name === 'cirkels' && (
    <g stroke="currentColor" stroke-width="1.5" fill="none">
      <circle cx="50" cy="50" r="40" />
      <circle cx="50" cy="50" r="28" />
      <circle cx="50" cy="50" r="16" />
      <circle cx="50" cy="50" r="4" fill="currentColor" />
    </g>
  )}

  {/* ☪ Halve maan met ster */}
  {name === 'maan' && (
    <g stroke="currentColor" stroke-width="2" fill="currentColor" fill-opacity="0.08">
      <path d="M60,15 A35,35 0 1,0 60,85 A28,28 0 1,1 60,15Z" />
      <polygon points="30,40 33,48 42,48 35,53 38,61 30,56 22,61 25,53 18,48 27,48" />
    </g>
  )}

  {/* ✧ 4-puntige ster — Kompas */}
  {name === 'ster-4' && (
    <g stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity="0.08">
      <polygon points="50,5 58,42 95,50 58,58 50,95 42,58 5,50 42,42" />
    </g>
  )}

  {/* ⊞ Raster — Geometrisch venster */}
  {name === 'raster' && (
    <g stroke="currentColor" stroke-width="2" fill="none">
      <rect x="10" y="10" width="80" height="80" />
      <line x1="50" y1="10" x2="50" y2="90" />
      <line x1="10" y1="50" x2="90" y2="50" />
      <circle cx="50" cy="50" r="20" />
    </g>
  )}

  {/* 🕌 Mihrab — Boogvorm */}
  {name === 'mihrab' && (
    <g stroke="currentColor" stroke-width="2" fill="currentColor" fill-opacity="0.08">
      <path d="M25,90 L25,40 A25,25 0 0,1 75,40 L75,90" />
      <path d="M38,90 L38,48 A12,12 0 0,1 62,48 L62,90" />
      <circle cx="50" cy="38" r="3" fill="currentColor" />
    </g>
  )}

  {/* 📿 Tasbih — Gebedskralen */}
  {name === 'tasbih' && (
    <g stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity="0.08">
      <circle cx="50" cy="18" r="7" />
      <circle cx="72" cy="28" r="7" />
      <circle cx="82" cy="50" r="7" />
      <circle cx="72" cy="72" r="7" />
      <circle cx="50" cy="82" r="7" />
      <circle cx="28" cy="72" r="7" />
      <circle cx="18" cy="50" r="7" />
      <circle cx="28" cy="28" r="7" />
    </g>
  )}

  {/* Fallback — eenvoudige ster */}
  {!['ster-8','ruit','rozet','hexagon','cirkels','maan','ster-4','raster','mihrab','tasbih'].includes(name) && (
    <g stroke="currentColor" stroke-width="2" fill="currentColor" fill-opacity="0.08">
      <polygon points="50,5 61,39 95,39 67,61 78,95 50,73 22,95 33,61 5,39 39,39" />
    </g>
  )}
</svg>
