---
import { getUpcomingIslamicDay, getAnnouncementText } from '../lib/hijri';
import { fetchSettings } from '../lib/sanity';

const settings = await fetchSettings();
const islamicDays = settings?.islamicDays;

// Niet tonen als uitgeschakeld
if (islamicDays?.enabled === false) return;

const hijriAdjustment = settings?.hijriAdjustment ?? 0;

const upcoming = await getUpcomingIslamicDay(hijriAdjustment, islamicDays);
---

{upcoming && (
  <div
    id="islamic-day-bar"
    class="bg-accent text-white text-center text-sm font-medium py-2.5 px-6 relative z-[60]"
  >
    <div class="max-w-[1280px] mx-auto flex items-center justify-center gap-3">
      <span class="font-arabic text-xs opacity-70">{upcoming.nameAr}</span>
      <span>{getAnnouncementText(upcoming)}</span>
      {upcoming.daysUntil <= 7 && (
        <span class="text-xs opacity-70">
          — {new Date(upcoming.gregorianDate).toLocaleDateString('nl-BE', { weekday: 'long', day: 'numeric', month: 'long' })}
        </span>
      )}
    </div>
    <button
      id="islamic-day-bar-close"
      class="absolute right-4 top-1/2 -translate-y-1/2 text-white/60 hover:text-white transition-colors p-1"
      aria-label="Sluiten"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
)}

<script>
  const closeBtn = document.getElementById('islamic-day-bar-close');
  const bar = document.getElementById('islamic-day-bar');
  closeBtn?.addEventListener('click', () => {
    bar?.remove();
  });
</script>
