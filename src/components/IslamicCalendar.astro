---
import { fetchIslamicDays } from '../lib/hijri';
import { fetchSettings } from '../lib/sanity';

const settings = await fetchSettings();
const hijriAdjustment = settings?.hijriAdjustment ?? 0;
const islamicDays = settings?.islamicDays;

const days = await fetchIslamicDays(hijriAdjustment, islamicDays);
---

{days.length > 0 && (
  <div>
    <div class="text-center mb-10">
      <h2 class="text-3xl font-bold font-heading text-primary">Islamitische Kalender</h2>
      <p class="text-neutral-500 mt-2 text-sm">Aankomende islamitische dagen en feestdagen</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 max-w-4xl mx-auto">
      {days.map((day) => {
        const eventDate = new Date(day.gregorianDate);
        const dagNaam = eventDate.toLocaleDateString('nl-BE', { weekday: 'short' });
        const dagNr = eventDate.getDate();
        const maand = eventDate.toLocaleDateString('nl-BE', { month: 'short' });
        const isClose = day.daysUntil <= 7;
        const isToday = day.daysUntil === 0;

        return (
          <div class={`bg-white border border-neutral-200 border-l-[3px] ${isToday ? 'border-l-accent bg-accent/5' : isClose ? 'border-l-primary' : 'border-l-neutral-300'} p-5 flex gap-4 items-start`}>
            {/* Datum sticker */}
            <div class={`flex-shrink-0 w-14 h-14 flex flex-col items-center justify-center ${isToday ? 'bg-accent text-white' : 'bg-base-100 text-primary'}`}>
              <span class="text-lg font-bold font-heading leading-none">{dagNr}</span>
              <span class="text-[10px] uppercase tracking-wider font-semibold">{maand}</span>
            </div>

            {/* Info */}
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-lg">{day.emoji}</span>
                <h3 class="font-heading font-bold text-primary text-sm">{day.name}</h3>
              </div>
              <p class="text-xs text-neutral-400 font-arabic">{day.nameAr}</p>
              <p class="text-xs text-neutral-500 mt-1.5">
                {isToday
                  ? 'Vandaag'
                  : day.daysUntil === 1
                    ? 'Morgen'
                    : `Over ${day.daysUntil} dagen — ${dagNaam}`
                }
              </p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
)}
