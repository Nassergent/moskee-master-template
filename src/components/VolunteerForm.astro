---
// Vrijwilligersformulier — POST naar /api/vrijwilligers
---

<form id="volunteer-form" class="space-y-5">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <label for="vol-naam" class="block text-sm font-medium text-neutral-700 mb-1">Naam *</label>
      <input type="text" id="vol-naam" name="naam" required
        class="w-full px-4 py-3 border border-neutral-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all"
        placeholder="Uw naam" />
    </div>
    <div>
      <label for="vol-email" class="block text-sm font-medium text-neutral-700 mb-1">E-mail *</label>
      <input type="email" id="vol-email" name="email" required
        class="w-full px-4 py-3 border border-neutral-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all"
        placeholder="uw@email.be" />
    </div>
  </div>
  <div>
    <label for="vol-telefoon" class="block text-sm font-medium text-neutral-700 mb-1">Telefoon</label>
    <input type="tel" id="vol-telefoon" name="telefoon"
      class="w-full px-4 py-3 border border-neutral-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all"
      placeholder="+32 xxx xx xx xx" />
  </div>

  <fieldset>
    <legend class="block text-sm font-medium text-neutral-700 mb-3">Waar wil je bij helpen?</legend>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
      {['Koken', 'Kuisen', 'Onderhoud', 'Evenementen', 'Educatie', 'Administratie'].map((taak) => (
        <label class="flex items-center gap-2 cursor-pointer text-sm text-neutral-600 hover:text-neutral-900 transition-colors">
          <input type="checkbox" name="taken" value={taak.toLowerCase()}
            class="w-4 h-4 accent-primary" />
          {taak}
        </label>
      ))}
    </div>
  </fieldset>

  <div>
    <label for="vol-bericht" class="block text-sm font-medium text-neutral-700 mb-1">Bericht</label>
    <textarea id="vol-bericht" name="bericht" rows="3"
      class="w-full px-4 py-3 border border-neutral-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all resize-y"
      placeholder="Eventuele opmerkingen..."></textarea>
  </div>

  <button type="submit"
    class="btn-primary w-full py-3 px-6 bg-accent hover:bg-accent-hover text-white font-semibold transition-all">
    Aanmelden als vrijwilliger
  </button>
  <div id="volunteer-status" class="hidden text-center py-3 text-sm font-medium"></div>
</form>

<script>
  const form = document.getElementById('volunteer-form') as HTMLFormElement;
  const status = document.getElementById('volunteer-status') as HTMLDivElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);

    const taken = formData.getAll('taken') as string[];
    const data = {
      naam: formData.get('naam'),
      email: formData.get('email'),
      telefoon: formData.get('telefoon') || '',
      taken,
      bericht: formData.get('bericht') || '',
    };

    try {
      const res = await fetch('/api/vrijwilligers', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        status.textContent = 'Bedankt voor uw aanmelding! Wij nemen contact met u op.';
        status.className = 'text-center py-3 text-sm font-medium bg-green-50 text-green-700';
        form.reset();
      } else {
        throw new Error();
      }
    } catch {
      status.textContent = 'Er is iets misgegaan. Probeer het later opnieuw.';
      status.className = 'text-center py-3 text-sm font-medium bg-red-50 text-red-700';
    }
  });
</script>
