---
/**
 * VolunteerForm.astro — Premium Flat Design vrijwilligersformulier
 * Taken worden dynamisch opgehaald uit Sanity CMS (aboutPage.vrijwilligerTaken)
 */
interface Props {
  taken?: string[];
}

const { taken = [] } = Astro.props;
---

<form id="volunteer-form" class="space-y-6">
  {/* Honeypot — verborgen voor echte gebruikers */}
  <div class="hidden" aria-hidden="true">
    <input type="text" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <label for="vol-naam" class="block text-sm font-heading font-semibold text-primary mb-2">Naam *</label>
      <input type="text" id="vol-naam" name="naam" required aria-required="true"
        class="w-full bg-white px-4 py-3.5 border border-slate-200 focus:border-primary focus:ring-1 focus:ring-primary/10 outline-none transition-all text-base"
        placeholder="Uw volledige naam" />
    </div>
    <div>
      <label for="vol-email" class="block text-sm font-heading font-semibold text-primary mb-2">E-mail *</label>
      <input type="email" id="vol-email" name="email" required aria-required="true"
        class="w-full bg-white px-4 py-3.5 border border-slate-200 focus:border-primary focus:ring-1 focus:ring-primary/10 outline-none transition-all text-base"
        placeholder="uw@email.be" />
    </div>
  </div>

  <div>
    <label for="vol-telefoon" class="block text-sm font-heading font-semibold text-primary mb-2">Telefoon</label>
    <input type="tel" id="vol-telefoon" name="telefoon"
      class="w-full bg-white px-4 py-3.5 border border-slate-200 focus:border-primary focus:ring-1 focus:ring-primary/10 outline-none transition-all text-base"
      placeholder="+32 xxx xx xx xx" />
  </div>

  {taken.length > 0 && (
    <div>
      <label for="vol-taak" class="block text-sm font-heading font-semibold text-primary mb-2">Waar wil je bij helpen?</label>
      <select id="vol-taak" name="taak"
        class="w-full bg-white px-4 py-3.5 border border-slate-200 focus:border-primary focus:ring-1 focus:ring-primary/10 outline-none transition-all text-base appearance-none bg-[url('data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2212%22%20height%3D%2212%22%20viewBox%3D%220%200%2012%2012%22%3E%3Cpath%20fill%3D%22%23475569%22%20d%3D%22M2%204l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:12px] bg-[right_16px_center] bg-no-repeat pr-10">
        <option value="">Kies een taak</option>
        {taken.map((taak: string) => (
          <option value={taak.toLowerCase()}>{taak}</option>
        ))}
      </select>
    </div>
  )}

  <div>
    <label for="vol-bericht" class="block text-sm font-heading font-semibold text-primary mb-2">Bericht</label>
    <textarea id="vol-bericht" name="bericht" rows="3"
      class="w-full bg-white px-4 py-3.5 border border-slate-200 focus:border-primary focus:ring-1 focus:ring-primary/10 outline-none transition-all resize-y text-base"
      placeholder="Vertel ons kort waarom u vrijwilliger wilt worden..."></textarea>
  </div>

  <button type="submit" id="volunteer-btn"
    class="w-full py-3.5 px-6 bg-accent text-white font-heading font-bold text-sm tracking-wide hover:brightness-110 transition-all disabled:opacity-60 disabled:cursor-not-allowed">
    Aanmelden als vrijwilliger
  </button>

  <div id="volunteer-status" class="hidden"></div>
</form>

<script>
  const form = document.getElementById('volunteer-form') as HTMLFormElement;
  const statusEl = document.getElementById('volunteer-status') as HTMLDivElement;
  const btn = document.getElementById('volunteer-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Loading state with spinner
    const originalText = btn.textContent;
    btn.textContent = 'Versturen...';
    btn.disabled = true;

    const formData = new FormData(form);
    const taak = formData.get('taak') as string;

    const data = {
      naam: formData.get('naam'),
      email: formData.get('email'),
      telefoon: formData.get('telefoon') || '',
      taken: taak ? [taak] : [],
      bericht: formData.get('bericht') || '',
      website: formData.get('website') || '',
    };

    try {
      const res = await fetch('/api/vrijwilligers', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        statusEl.innerHTML = `
          <div class="bg-primary/5 border-l-4 border-primary p-4 text-sm" tabindex="-1" role="status">
            <p class="font-heading font-bold text-primary mb-1">Aanmelding ontvangen</p>
            <p class="text-neutral-600">Jazak Allahu Khairan! Wij nemen zo snel mogelijk contact met u op.</p>
          </div>
        `;
        statusEl.className = '';
        statusEl.querySelector('[tabindex]')?.focus();
        form.reset();
      } else {
        const result = await res.json().catch(() => ({}));
        throw new Error(result.error || 'Verzending mislukt');
      }
    } catch (err: any) {
      const msg = document.createElement('span');
      msg.textContent = err.message || 'Er is iets misgegaan. Probeer het later opnieuw.';
      statusEl.innerHTML = `
        <div class="bg-red-50 border-l-4 border-red-500 p-4 text-sm">
          <p class="font-heading font-bold text-red-700 mb-1">Fout bij verzenden</p>
          <p class="text-red-600"></p>
        </div>
      `;
      statusEl.querySelector('.text-red-600')!.appendChild(msg);
      statusEl.className = '';
      statusEl.querySelector('[class*="border-l-4"]')?.setAttribute('tabindex', '-1');
      (statusEl.querySelector('[tabindex]') as HTMLElement)?.focus();
    } finally {
      btn.innerHTML = originalText || 'Aanmelden als vrijwilliger';
      btn.disabled = false;
    }
  });
</script>
