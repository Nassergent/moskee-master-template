---
import { generateGoogleCalendarUrl, generateIcsContent } from '../lib/hijri';

interface Props {
  titel: string;
  startDatum: string;
  eindDatum?: string | null;
  locatie?: string | null;
  beschrijving?: string | null;
  mosqueName?: string;
  address?: string;
}

const { titel, startDatum, eindDatum, locatie, beschrijving, mosqueName, address } = Astro.props;

const event = { titel, startDatum, eindDatum, locatie, beschrijving, mosqueName, address };
const googleUrl = generateGoogleCalendarUrl(event);
const icsContent = generateIcsContent(event);
---

<div class="add-to-calendar relative inline-block">
  <button
    type="button"
    class="atc-toggle inline-flex items-center gap-2 px-5 py-2.5 text-sm font-bold transition-all bg-accent text-white hover:bg-accent-hover"
    aria-expanded="false"
    aria-haspopup="true"
  >
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
    </svg>
    Toevoegen aan agenda
    <svg class="w-3 h-3 transition-transform duration-200 atc-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
    </svg>
  </button>

  <div class="atc-dropdown hidden absolute left-0 mt-1 w-56 bg-white border border-neutral-200 z-20 overflow-hidden">
    <a
      href={googleUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-3 px-4 py-3 text-sm text-neutral-700 hover:bg-primary-light transition-colors"
    >
      <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="currentColor">
        <path d="M19.5 3h-3V1.5h-1.5V3h-6V1.5H7.5V3h-3A1.5 1.5 0 003 4.5v15A1.5 1.5 0 004.5 21h15a1.5 1.5 0 001.5-1.5v-15A1.5 1.5 0 0019.5 3zm0 16.5h-15V9h15v10.5z"/>
      </svg>
      Google Calendar
    </a>
    <button
      type="button"
      class="atc-ics flex items-center gap-3 px-4 py-3 text-sm text-neutral-700 hover:bg-primary-light transition-colors w-full text-left"
      data-ics={icsContent}
      data-filename={`${titel.toLowerCase().replace(/\s+/g, '-')}.ics`}
    >
      <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
      </svg>
      iCal Download (.ics)
    </button>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.add-to-calendar').forEach((container) => {
      const toggle = container.querySelector('.atc-toggle') as HTMLButtonElement;
      const dropdown = container.querySelector('.atc-dropdown') as HTMLElement;
      const chevron = container.querySelector('.atc-chevron') as HTMLElement;
      const icsBtn = container.querySelector('.atc-ics') as HTMLButtonElement;

      if (!toggle || !dropdown) return;

      toggle.addEventListener('click', () => {
        const open = !dropdown.classList.contains('hidden');
        dropdown.classList.toggle('hidden');
        toggle.setAttribute('aria-expanded', String(!open));
        if (chevron) chevron.style.transform = open ? '' : 'rotate(180deg)';
      });

      document.addEventListener('click', (e) => {
        if (!container.contains(e.target as Node)) {
          dropdown.classList.add('hidden');
          toggle.setAttribute('aria-expanded', 'false');
          if (chevron) chevron.style.transform = '';
        }
      });

      if (icsBtn) {
        icsBtn.addEventListener('click', () => {
          const ics = icsBtn.dataset.ics || '';
          const filename = icsBtn.dataset.filename || 'event.ics';
          const blob = new Blob([ics], { type: 'text/calendar;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = filename;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
        });
      }
    });
  });
</script>
