---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import { fetchSettings } from '../lib/sanity';

export const prerender = false;

const settings = await fetchSettings();

// Haal donatie-info op uit query params (van Mollie redirect)
const bedrag = Astro.url.searchParams.get('bedrag');
const bestemming = Astro.url.searchParams.get('bestemming');
const isDemo = Astro.url.searchParams.get('demo') === 'true';

const bedanktTekst = settings.bedanktTekst
  || 'Bedankt voor je gulle bijdrage. We hebben je donatie in goede orde ontvangen.';
---

<BaseLayout title="Bedankt" description="Bedankt voor uw donatie">
  <!-- Header -->
  <section class="bg-primary-dark text-white py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-6 text-center animate-fade-in-up">
      <div class="w-20 h-20 mx-auto mb-6 bg-accent/20 flex items-center justify-center">
        <svg class="w-10 h-10 text-accent-light" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
      </div>
      <h1 class="text-4xl font-bold mb-4 text-white">Jazak Allahu Khairan</h1>
      <p class="text-white/80 max-w-xl mx-auto">{bedanktTekst}</p>
    </div>
  </section>

  <!-- Samenvatting -->
  <Section variant="light-50">
    <div class="max-w-2xl mx-auto">

      <!-- Donatie Samenvatting -->
      {(bedrag || bestemming) && (
        <div class="bg-white border border-neutral-200 p-8 mb-8">
          <h2 class="text-xl font-bold font-heading text-primary mb-6 text-center">Uw donatie</h2>
          <div class="space-y-4 text-sm">
            {bedrag && (
              <div class="flex justify-between items-center py-3 border-b border-neutral-100">
                <span class="text-slate-500">Bedrag</span>
                <span class="font-heading font-bold text-2xl text-primary">&euro;{parseFloat(bedrag).toLocaleString('nl-BE', { minimumFractionDigits: 2 })}</span>
              </div>
            )}
            {bestemming && (
              <div class="flex justify-between items-center py-3 border-b border-neutral-100">
                <span class="text-slate-500">Bestemming</span>
                <span class="font-medium text-slate-800">{bestemming}</span>
              </div>
            )}
            <div class="flex justify-between items-center py-3">
              <span class="text-slate-500">Status</span>
              <span class="inline-flex items-center gap-1.5 text-green-700 font-medium">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                </svg>
                {isDemo ? 'Ontvangen (demo)' : 'Ontvangen'}
              </span>
            </div>
          </div>
        </div>
      )}

      <!-- Islamitisch Citaat -->
      <div class="bg-base-100 border border-neutral-200 p-6 mb-8 text-center">
        <p class="font-arabic text-xl text-primary/60 leading-loose mb-3" dir="rtl">
          مَا نَقَصَتْ صَدَقَةٌ مِنْ مَالٍ
        </p>
        <p class="text-sm text-neutral-600 italic">
          "De rijkdom van een persoon wordt niet verminderd door Sadaqah."
        </p>
        <p class="text-xs text-accent font-medium mt-2">— Sahih Muslim 2588</p>
      </div>

      <!-- Acties -->
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/" class="btn-primary px-6 py-3 bg-primary hover:bg-primary-dark text-white font-semibold transition-all">
          Terug naar home
        </a>
        <a href="/doneren" class="px-6 py-3 bg-accent/10 hover:bg-accent/20 text-accent font-semibold transition-colors">
          Nog een donatie doen
        </a>
      </div>
    </div>
  </Section>
</BaseLayout>
