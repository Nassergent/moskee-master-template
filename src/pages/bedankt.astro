---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import { fetchSettings } from '../lib/sanity';

export const prerender = false;

const settings = await fetchSettings();
---

<BaseLayout title="Bedankt" description="Bedankt voor uw donatie">
  <section class="bg-primary-dark text-white py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-6 text-center animate-fade-in-up">
      <div class="w-20 h-20 mx-auto mb-6 bg-accent/20 flex items-center justify-center">
        <svg class="w-10 h-10 text-accent-light" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
      </div>
      <h1 class="text-4xl font-bold mb-4 text-white">Jazak Allahu Khayran</h1>
      <p class="text-white/80 max-w-xl mx-auto">
        Bedankt voor uw donatie aan {settings.mosqueName}
      </p>
    </div>
  </section>

  <Section variant="light-50">
    <div class="max-w-2xl mx-auto text-center">
      <p class="text-neutral-600 leading-relaxed mb-8">
        Uw bijdrage maakt een verschil voor onze gemeenschap. Moge Allah uw vrijgevigheid rijkelijk belonen.
      </p>

      <div class="bg-base-100 border border-neutral-200 p-6 mb-8">
        <p class="font-arabic text-xl text-primary/60 leading-loose mb-3" dir="rtl">
          مَا نَقَصَتْ صَدَقَةٌ مِنْ مَالٍ
        </p>
        <p class="text-sm text-neutral-600 italic">
          "De rijkdom van een persoon wordt niet verminderd door Sadaqah."
        </p>
        <p class="text-xs text-accent font-medium mt-2">— Sahih Muslim 2588</p>
      </div>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/" class="btn-primary px-6 py-3 bg-primary hover:bg-primary-dark text-white font-semibold transition-all">
          Terug naar home
        </a>
        <a href="/doneren" class="px-6 py-3 bg-accent/10 hover:bg-accent/20 text-accent font-semibold transition-colors">
          Nog een donatie doen
        </a>
      </div>
    </div>
  </Section>
</BaseLayout>
