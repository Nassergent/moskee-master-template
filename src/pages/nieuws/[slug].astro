---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import PortableText from '../../components/PortableText.astro';
import { fetchNieuws, fetchSettings, urlFor } from '../../lib/sanity';
import { sanitizeAlt } from '../../lib/logic/seo-utils';

const { slug } = Astro.params;
const nieuws = await fetchNieuws();
const item = nieuws.find((n: any) => n.slug?.current === slug);
if (!item?.titel) return Astro.redirect('/nieuws');
const settings = await fetchSettings();
const datum = item.datum
  ? new Date(item.datum).toLocaleDateString('nl-BE', { year: 'numeric', month: 'long', day: 'numeric' })
  : '';
const ogImage = item.afbeelding ? urlFor(item.afbeelding).width(1200).height(630).fit('crop').url() : undefined;

const newsArticleSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": item.titel,
  "description": item.samenvatting || '',
  "image": ogImage || undefined,
  "datePublished": item.datum || undefined,
  "author": {
    "@type": "Organization",
    "name": settings?.mosqueName || 'Onze Moskee',
  },
});
---

<BaseLayout title={item.titel} description={item.samenvatting} ogImage={ogImage} ogType="article" breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Nieuws', href: '/nieuws' }, { name: item.titel, href: `/nieuws/${slug}` }]}>
  <script type="application/ld+json" set:html={newsArticleSchema} />
  <!-- Page Header — Dark with optional hero image -->
  <section class="bg-primary-dark text-white py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-6">
      <div class={`grid items-center ${item.afbeelding ? 'grid-cols-1 lg:grid-cols-2 gap-10' : 'grid-cols-1'}`}>
        <div>
          <a href="/nieuws" class="inline-flex items-center text-white/70 hover:text-white text-sm mb-4 transition-colors">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Terug naar artikelen
          </a>
          <h1 class="text-4xl font-bold text-white">{item.titel}</h1>
          <time class="text-white/70 mt-2 block" datetime={item.datum}>{datum}</time>
        </div>
        {item.afbeelding && (
          <div class="hidden lg:block">
            <img
              src={urlFor(item.afbeelding).width(700).height(400).fit('crop').url()}
              alt={sanitizeAlt(item.titel)}
              class="w-full h-[350px] object-cover"
              width={700}
              height={400}
              loading="eager"
              fetchpriority="high"
            />
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Content -->
  <Section variant="light-50">
    <div class="max-w-3xl mx-auto">
      <div class="prose prose-neutral prose-lg max-w-none">
        <p class="text-lg text-neutral-700 leading-relaxed font-medium">{item.samenvatting}</p>
        {item.inhoud && item.inhoud.length > 0 ? (
          <PortableText value={item.inhoud} />
        ) : (
          <p>
            Heeft u vragen? Neem gerust <a href="/contact" class="text-primary hover:opacity-80">contact</a> met ons op.
          </p>
        )}
      </div>
    </div>
  </Section>
</BaseLayout>
