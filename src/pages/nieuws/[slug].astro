---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import { fetchNieuws } from '../../lib/sanity';

export async function getStaticPaths() {
  const nieuws = await fetchNieuws();
  return nieuws.map((item: any) => ({
    params: { slug: item.slug.current },
    props: { item },
  }));
}

export const prerender = true;

const { item } = Astro.props;
const datum = new Date(item.datum).toLocaleDateString('nl-BE', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={item.titel} description={item.samenvatting}>
  <!-- Page Header — Dark -->
  <section class="bg-primary-dark text-white py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-6">
      <a href="/nieuws" class="inline-flex items-center text-white/70 hover:text-white text-sm mb-4 transition-colors">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Terug naar nieuws
      </a>
      <h1 class="text-4xl font-bold text-white">{item.titel}</h1>
      <time class="text-white/70 mt-2 block" datetime={item.datum}>{datum}</time>
    </div>
  </section>

  <!-- Content -->
  <Section variant="light-50">
    <div class="max-w-3xl mx-auto">
      <div class="prose prose-neutral prose-lg max-w-none">
        <p class="text-lg text-neutral-700 leading-relaxed font-medium">{item.samenvatting}</p>
        {item.inhoud ? (
          item.inhoud.map((block: any) => {
            if (block._type === 'block') {
              const text = block.children?.map((c: any) => c.text).join('') || '';
              if (block.style === 'h2') return <h2>{text}</h2>;
              if (block.style === 'h3') return <h3>{text}</h3>;
              if (block.style === 'h4') return <h4>{text}</h4>;
              if (block.style === 'blockquote') return <blockquote>{text}</blockquote>;
              return <p>{text}</p>;
            }
            return null;
          })
        ) : (
          <p>
            Heeft u vragen? Neem gerust <a href="/contact" class="text-primary hover:opacity-80">contact</a> met ons op.
          </p>
        )}
      </div>
    </div>
  </Section>
</BaseLayout>
