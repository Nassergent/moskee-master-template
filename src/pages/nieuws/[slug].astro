---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import PortableText from '../../components/PortableText.astro';
import PostTypeBadge from '../../components/ui/PostTypeBadge.astro';
import { fetchPost, fetchTopicHubRelated, fetchSettings, urlFor } from '../../lib/sanity';
import { sanitizeAlt } from '../../lib/logic/seo-utils';
import { buildSiteConfig } from '../../lib/logic/config';

const { slug } = Astro.params;
const item = await fetchPost(slug!);
if (!item?.titel) return Astro.redirect('/nieuws');

const settings = await fetchSettings();
const config = buildSiteConfig(settings);
const tz = config.timezone;

const datum = item.datum
  ? new Date(item.datum).toLocaleDateString(config.locale, { year: 'numeric', month: 'long', day: 'numeric' })
  : '';
const ogImage = item.afbeelding ? urlFor(item.afbeelding).width(1200).height(630).fit('crop').url() : undefined;

// Topic Hub: haal gerelateerde content op als dit artikel een hub IS
const hubRelated = await fetchTopicHubRelated(item._id);
const hasRelated = hubRelated.posts.length > 0 || hubRelated.events.length > 0;

// Of dit artikel zelf een sub-item is van een hub
const parentHub = item.onderwerpHub;

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=3600');
Astro.response.headers.set('Vercel-CDN-Cache-Control', 'public, s-maxage=300, stale-while-revalidate=3600');
Astro.response.headers.set('Vercel-Cache-Tag', 'news');

const newsArticleSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": item.titel,
  "description": item.samenvatting || '',
  "image": ogImage || undefined,
  "datePublished": item.datum || undefined,
  "author": {
    "@type": "Organization",
    "name": settings?.mosqueName || 'Onze Moskee',
  },
});
---

<BaseLayout title={item.titel} description={item.samenvatting} ogImage={ogImage} ogType="article" breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Nieuws', href: '/nieuws' }, { name: item.titel, href: `/nieuws/${slug}` }]}>
  <script type="application/ld+json" set:html={newsArticleSchema} />
  <!-- Page Header — Dark with optional hero image -->
  <section class="bg-primary-dark text-white py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-6">
      <div class={`grid items-center ${item.afbeelding ? 'grid-cols-1 lg:grid-cols-2 gap-10' : 'grid-cols-1'}`}>
        <div>
          <a href="/nieuws" class="inline-flex items-center min-h-[44px] text-white/70 hover:text-white text-sm mb-4 transition-colors">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Terug naar artikelen
          </a>
          <div class="mb-3">
            <PostTypeBadge postType={item.postType} />
          </div>
          <h1 class="text-2xl md:text-4xl font-bold text-white">{item.titel}</h1>
          <time class="text-white/70 mt-2 block" datetime={item.datum}>{datum}</time>
        </div>
        {item.afbeelding && (
          <div class="hidden lg:block">
            <img
              src={urlFor(item.afbeelding).width(700).height(400).fit('crop').url()}
              alt={sanitizeAlt(item.titel)}
              class="w-full h-[350px] object-cover"
              width={700}
              height={400}
              loading="eager"
              fetchpriority="high"
            />
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Content -->
  <Section variant="light-50">
    <div class="max-w-3xl mx-auto">
      <div class="prose prose-neutral prose-lg max-w-none">
        <p class="text-lg text-neutral-700 leading-relaxed font-medium">{item.samenvatting}</p>
        {item.inhoud && item.inhoud.length > 0 ? (
          <PortableText value={item.inhoud} />
        ) : (
          <p>
            Heeft u vragen? Neem gerust <a href="/contact" class="text-primary hover:opacity-80">contact</a> met ons op.
          </p>
        )}
      </div>

      {/* Parent Hub Link — als dit een sub-artikel is */}
      {parentHub && parentHub.slug && (
        <div class="mt-10 border-l-[3px] border-l-accent bg-base-100 p-6">
          <p class="text-sm text-neutral-500 uppercase tracking-wider font-bold mb-2">Onderdeel van</p>
          <a
            href={`/nieuws/${parentHub.slug}`}
            class="text-lg font-bold text-primary hover:text-accent transition-colors inline-flex items-center gap-2"
          >
            {parentHub.titel}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      )}
    </div>
  </Section>

  {/* Gerelateerd in dit programma — alleen als dit artikel een hub IS met sub-items */}
  {hasRelated && (
    <Section variant="light-100">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-heading text-2xl font-bold mb-6">Gerelateerd in dit programma</h2>

        {/* Gerelateerde artikelen */}
        {hubRelated.posts.length > 0 && (
          <div class="mb-8">
            <h3 class="text-sm text-neutral-500 uppercase tracking-wider font-bold mb-4">Artikelen</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {hubRelated.posts.map((post: any) => (
                <a
                  href={`/nieuws/${post.slug}`}
                  class="bg-white border border-neutral-200 border-l-[3px] border-l-accent p-5 hover:border-l-primary transition-all group"
                >
                  <h4 class="font-heading font-bold text-base mb-1 group-hover:text-primary transition-colors">{post.titel}</h4>
                  {post.datum && (
                    <time class="text-xs text-neutral-400" datetime={post.datum}>
                      {new Date(post.datum).toLocaleDateString(config.locale, { day: 'numeric', month: 'long', year: 'numeric' })}
                    </time>
                  )}
                  {post.samenvatting && (
                    <p class="text-sm text-neutral-500 mt-2 line-clamp-2">{post.samenvatting}</p>
                  )}
                </a>
              ))}
            </div>
          </div>
        )}

        {/* Gerelateerde agenda-items */}
        {hubRelated.events.length > 0 && (
          <div>
            <h3 class="text-sm text-neutral-500 uppercase tracking-wider font-bold mb-4">Agenda</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {hubRelated.events.map((evt: any) => {
                const evtDatum = evt.startDatum
                  ? new Date(evt.startDatum).toLocaleDateString(config.locale, {
                      weekday: 'short', day: 'numeric', month: 'long',
                      timeZone: tz,
                    })
                  : '';
                const evtTijd = evt.startDatum
                  ? new Date(evt.startDatum).toLocaleTimeString(config.locale, {
                      hour: '2-digit', minute: '2-digit',
                      timeZone: tz,
                    })
                  : '';
                return (
                  <a
                    href={`/agenda/${evt.slug}`}
                    class="bg-white border border-neutral-200 border-l-[3px] border-l-accent p-5 hover:border-l-primary transition-all group"
                  >
                    {evt.categorie && (
                      <span class="text-[10px] font-semibold uppercase tracking-wider text-accent">{evt.categorie}</span>
                    )}
                    <h4 class="font-heading font-bold text-base mb-1 group-hover:text-primary transition-colors">{evt.titel}</h4>
                    <div class="flex items-center gap-2 text-sm text-neutral-500">
                      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                      <span>{evtDatum}</span>
                      {evtTijd && evtTijd !== '00:00' && (
                        <>
                          <span class="text-neutral-300">|</span>
                          <span>{evtTijd}</span>
                        </>
                      )}
                    </div>
                    {evt.locatie && (
                      <p class="text-xs text-neutral-400 mt-1">{evt.locatie}</p>
                    )}
                  </a>
                );
              })}
            </div>
          </div>
        )}
      </div>
    </Section>
  )}
</BaseLayout>
