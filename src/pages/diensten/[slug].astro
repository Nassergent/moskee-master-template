---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import GeoIcon from '../../components/GeoIcon.astro';
import { fetchDiensten } from '../../lib/sanity';

export async function getStaticPaths() {
  const diensten = await fetchDiensten();
  return diensten.map((dienst: any) => ({
    params: { slug: dienst.slug.current },
    props: { dienst },
  }));
}

export const prerender = true;

const { dienst } = Astro.props;
---

<BaseLayout title={dienst.titel} description={dienst.beschrijving}>
  <!-- Page Header — Dark -->
  <section class="bg-primary-dark text-white py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-6">
      <a href="/diensten" class="inline-flex items-center text-white/70 hover:text-white text-sm mb-4 transition-colors">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Terug naar diensten
      </a>
      <div class="flex items-center gap-4">
        <GeoIcon name={dienst.icoon || 'ster-8'} size="xl" class="text-accent-light" />
        <div>
          <h1 class="text-4xl font-bold text-white">{dienst.titel}</h1>
          <p class="text-white/70 mt-2">{dienst.tijden}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Content -->
  <Section variant="light-50">
    <div class="max-w-3xl mx-auto">
      <div class="prose prose-neutral prose-lg max-w-none">
        <p class="text-lg text-neutral-700 leading-relaxed">{dienst.beschrijving}</p>

        {dienst.inhoud && dienst.inhoud.length > 0 && (
          dienst.inhoud.map((block: any) => {
            if (block._type === 'block') {
              const text = block.children?.map((c: any) => c.text).join('') || '';
              if (block.style === 'h2') return <h2>{text}</h2>;
              if (block.style === 'h3') return <h3>{text}</h3>;
              if (block.style === 'h4') return <h4>{text}</h4>;
              if (block.style === 'blockquote') return <blockquote>{text}</blockquote>;
              return <p>{text}</p>;
            }
            return null;
          })
        )}

        <h2>Praktische Informatie</h2>
        <div class="not-prose bg-base-100 p-6 my-8 border-l-3 border-l-accent">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <p class="text-sm font-medium text-primary mb-1">Wanneer</p>
              <p class="font-medium">{dienst.tijden}</p>
            </div>
            <div>
              <p class="text-sm font-medium text-primary mb-1">Locatie</p>
              <p class="font-medium">Onze moskee</p>
            </div>
          </div>
        </div>

        <p>
          Voor meer informatie of inschrijving kunt u contact opnemen via ons
          <a href="/contact" class="text-primary hover:opacity-80">contactformulier</a>
          of langskomen bij de moskee.
        </p>
      </div>
    </div>
  </Section>
</BaseLayout>
