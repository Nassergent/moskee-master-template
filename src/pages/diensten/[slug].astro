---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import PortableText from '../../components/PortableText.astro';
import { fetchDiensten, fetchSettings, urlFor } from '../../lib/sanity';
import { sanitizeAlt } from '../../lib/logic/seo-utils';

const { slug } = Astro.params;
const diensten = await fetchDiensten();
const dienst = diensten.find((d: any) => d.slug === slug);
if (!dienst?.titel) return Astro.redirect('/diensten');
const settings = await fetchSettings();

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=3600, stale-while-revalidate=86400');
Astro.response.headers.set('Vercel-CDN-Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');
Astro.response.headers.set('Vercel-Cache-Tag', 'services');
---

<BaseLayout title={dienst.titel} description={dienst.beschrijving || ''} ogImage={dienst.afbeelding ? urlFor(dienst.afbeelding).width(1200).height(630).fit('crop').url() : undefined} breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Diensten', href: '/diensten' }, { name: dienst.titel, href: `/diensten/${slug}` }]}>
  <!-- Page Header — Dark with optional hero image -->
  <section class="bg-primary-dark text-white py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-6">
      <div class={`grid items-center ${dienst.afbeelding ? 'grid-cols-1 lg:grid-cols-2 gap-10' : 'grid-cols-1'}`}>
        <div>
          <a href="/diensten" class="inline-flex items-center min-h-[44px] text-white/70 hover:text-white text-sm mb-4 transition-colors">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Terug naar diensten
          </a>
          <h1 class="text-2xl md:text-4xl font-bold text-white">{dienst.titel}</h1>
          {dienst.tijden && <p class="text-white/70 mt-2">{dienst.tijden}</p>}
        </div>
        {dienst.afbeelding && (
          <div class="hidden lg:block">
            <img
              src={urlFor(dienst.afbeelding).width(700).height(400).fit('crop').url()}
              alt={sanitizeAlt(dienst.titel)}
              class="w-full h-[350px] object-cover"
              width={700}
              height={400}
              loading="eager"
              fetchpriority="high"
            />
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Content -->
  <Section variant="light-50">
    <div class="max-w-3xl mx-auto">
      <div class="prose prose-neutral prose-lg max-w-none">
        {dienst.inhoud && dienst.inhoud.length > 0 ? (
          <PortableText value={dienst.inhoud} />
        ) : (
          <p class="text-lg text-neutral-700 leading-relaxed">{dienst.beschrijving}</p>
        )}

        <h2>Praktische Informatie</h2>
        <div class="not-prose bg-base-100 p-6 my-8 border-l-3 border-l-accent">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <p class="text-sm font-medium text-primary mb-1">Wanneer</p>
              <p class="font-medium">{dienst.tijden || 'Neem contact op'}</p>
            </div>
            <div>
              <p class="text-sm font-medium text-primary mb-1">Locatie</p>
              <p class="font-medium">Onze moskee</p>
            </div>
          </div>
        </div>

        <p>
          Voor meer informatie of inschrijving kunt u contact opnemen via ons
          <a href="/contact" class="text-primary hover:opacity-80">contactformulier</a>
          of langskomen bij de moskee.
        </p>
      </div>
    </div>
  </Section>
</BaseLayout>
