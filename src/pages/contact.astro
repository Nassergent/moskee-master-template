---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import { fetchSettings, fetchContactPage, demoContactPage } from '../lib/sanity';

const settings = await fetchSettings();
const contactPage = await fetchContactPage();

const introText = contactPage.introText || demoContactPage.introText;
const openingstijden = contactPage.openingstijden?.length ? contactPage.openingstijden : demoContactPage.openingstijden;
const onderwerpen = contactPage.onderwerpen?.length ? contactPage.onderwerpen : demoContactPage.onderwerpen;
---

<BaseLayout title="Contact" description="Neem contact op met onze moskee">
  <!-- Page Header — Dark -->
  <section class="bg-primary-dark text-white py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-6 text-center animate-fade-in-up">
      <h1 class="text-4xl font-bold mb-4 text-white">Contact</h1>
      <p class="text-white/80 max-w-xl mx-auto">
        {introText}
      </p>
    </div>
  </section>

  <Section variant="light-50">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Contact Form — Flat -->
      <div>
        <h2 class="text-2xl font-bold mb-6">Stuur ons een bericht</h2>
        <form id="contact-form" class="space-y-5">
          {/* Honeypot — verborgen voor echte gebruikers */}
          <div class="hidden" aria-hidden="true">
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <div>
            <label for="naam" class="block text-sm font-medium text-neutral-700 mb-1">Naam *</label>
            <input type="text" id="naam" name="naam" required
              class="w-full px-4 py-3 border border-neutral-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all"
              placeholder="Uw naam" />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-neutral-700 mb-1">E-mail *</label>
            <input type="email" id="email" name="email" required
              class="w-full px-4 py-3 border border-neutral-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all"
              placeholder="uw@email.be" />
          </div>
          <div>
            <label for="telefoon" class="block text-sm font-medium text-neutral-700 mb-1">Telefoon</label>
            <input type="tel" id="telefoon" name="telefoon"
              class="w-full px-4 py-3 border border-neutral-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all"
              placeholder="+32 xxx xx xx xx" />
          </div>
          <div>
            <label for="onderwerp" class="block text-sm font-medium text-neutral-700 mb-1">Onderwerp *</label>
            <select id="onderwerp" name="onderwerp" required
              class="w-full px-4 py-3 border border-neutral-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all">
              <option value="">Kies een onderwerp</option>
              {onderwerpen.map((o: string) => (
                <option value={o.toLowerCase().replace(/\s+/g, '-')}>{o}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="bericht" class="block text-sm font-medium text-neutral-700 mb-1">Bericht *</label>
            <textarea id="bericht" name="bericht" required rows="5"
              class="w-full px-4 py-3 border border-neutral-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all resize-y"
              placeholder="Uw bericht..."></textarea>
          </div>
          <button type="submit"
            class="btn-primary w-full py-3 px-6 bg-accent hover:bg-accent-hover text-white font-semibold transition-all">
            Versturen
          </button>
          <div id="form-status" class="hidden text-center py-3 text-sm font-medium"></div>
        </form>
      </div>

      <!-- Contact Info — Flat, from settings -->
      <div class="space-y-8">
        <div>
          <h2 class="text-2xl font-bold mb-6">Contactgegevens</h2>
          <div class="space-y-3">
            {settings.address && (
              <div class="flex items-start gap-4 p-4 bg-base-100 border-l-3 border-l-primary">
                <svg class="w-5 h-5 mt-0.5 text-primary shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
                <div>
                  <p class="font-medium text-primary-dark">Adres</p>
                  <p class="text-neutral-600 text-sm">{settings.address}</p>
                </div>
              </div>
            )}
            {settings.phone && (
              <div class="flex items-start gap-4 p-4 bg-base-100 border-l-3 border-l-primary">
                <svg class="w-5 h-5 mt-0.5 text-primary shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
                <div>
                  <p class="font-medium text-primary-dark">Telefoon</p>
                  <a href={`tel:${settings.phone.replace(/\s/g, '')}`} class="text-primary hover:opacity-80 text-sm">{settings.phone}</a>
                </div>
              </div>
            )}
            {settings.email && (
              <div class="flex items-start gap-4 p-4 bg-base-100 border-l-3 border-l-primary">
                <svg class="w-5 h-5 mt-0.5 text-primary shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" /></svg>
                <div>
                  <p class="font-medium text-primary-dark">E-mail</p>
                  <a href={`mailto:${settings.email}`} class="text-primary hover:opacity-80 text-sm">{settings.email}</a>
                </div>
              </div>
            )}
          </div>
        </div>

        <!-- Openingstijden uit CMS -->
        <div class="bg-base-100 p-6 border border-neutral-200">
          <h3 class="font-heading font-bold mb-4">Openingstijden</h3>
          <div class="space-y-2 text-sm">
            {openingstijden.map((item: any) => (
              <div class={`flex flex-col ${item.opmerking ? 'pt-2 border-t border-neutral-200' : ''}`}>
                <div class="flex justify-between">
                  <span class={item.opmerking ? 'text-primary font-medium' : 'text-neutral-600'}>{item.dagen}</span>
                  <span class={`font-medium ${item.opmerking ? 'text-primary' : ''}`}>{item.tijden}</span>
                </div>
                {item.opmerking && (
                  <span class="text-xs text-neutral-400 mt-0.5">{item.opmerking}</span>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status') as HTMLDivElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const data = Object.fromEntries(formData);

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        status.textContent = 'Bedankt! Uw bericht is verzonden.';
        status.className = 'text-center py-3 text-sm font-medium bg-green-50 text-green-700';
        form.reset();
      } else {
        throw new Error();
      }
    } catch {
      status.textContent = 'Er is iets misgegaan. Probeer het later opnieuw.';
      status.className = 'text-center py-3 text-sm font-medium bg-red-50 text-red-700';
    }
  });
</script>
