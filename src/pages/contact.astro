---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import { fetchSettings, fetchContactPage } from '../lib/sanity';

const settings = await fetchSettings();
const contactPage = await fetchContactPage();

const introText = contactPage.introText || '';
const openingstijden = contactPage.openingstijden?.length ? contactPage.openingstijden : [];
const onderwerpen = contactPage.onderwerpen?.length ? contactPage.onderwerpen : [];
---

<BaseLayout title={contactPage?.seoTitle || "Contact"} description={contactPage?.seoDescription || "Neem contact op met onze moskee"}>
  <!-- Page Header — Dark -->
  <section class="bg-primary-dark text-white py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-6 text-center animate-fade-in-up">
      <h1 class="text-4xl font-bold mb-4 text-white">Contact</h1>
      {introText && (
        <p class="text-white/80 max-w-xl mx-auto">
          {introText}
        </p>
      )}
    </div>
  </section>

  <Section variant="light-50">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Contact Form — Premium Flat Design -->
      <div>
        <h2 class="text-2xl font-bold mb-8">Stuur ons een bericht</h2>
        <form id="contact-form" class="space-y-6">
          {/* Honeypot — verborgen voor echte gebruikers */}
          <div class="hidden" aria-hidden="true">
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <div>
            <label for="naam" class="block text-sm font-heading font-semibold text-primary mb-2">Naam *</label>
            <input type="text" id="naam" name="naam" required aria-required="true"
              class="w-full bg-white px-4 py-3.5 border border-slate-200 focus:border-primary focus:ring-2 focus:ring-primary/30 outline-none transition-all text-base"
              placeholder="Uw volledige naam" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="email" class="block text-sm font-heading font-semibold text-primary mb-2">E-mail *</label>
              <input type="email" id="email" name="email" required aria-required="true"
                class="w-full bg-white px-4 py-3.5 border border-slate-200 focus:border-primary focus:ring-2 focus:ring-primary/30 outline-none transition-all text-base"
                placeholder="uw@email.be" />
            </div>
            <div>
              <label for="telefoon" class="block text-sm font-heading font-semibold text-primary mb-2">Telefoon</label>
              <input type="tel" id="telefoon" name="telefoon"
                class="w-full bg-white px-4 py-3.5 border border-slate-200 focus:border-primary focus:ring-2 focus:ring-primary/30 outline-none transition-all text-base"
                placeholder="+32 xxx xx xx xx" />
            </div>
          </div>

          <div>
            <label for="onderwerp" class="block text-sm font-heading font-semibold text-primary mb-2">Onderwerp *</label>
            <select id="onderwerp" name="onderwerp" required aria-required="true"
              class="w-full bg-white px-4 py-3.5 border border-slate-200 focus:border-primary focus:ring-2 focus:ring-primary/30 outline-none transition-all text-base appearance-none bg-[url('data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2212%22%20height%3D%2212%22%20viewBox%3D%220%200%2012%2012%22%3E%3Cpath%20fill%3D%22%23475569%22%20d%3D%22M2%204l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:12px] bg-[right_16px_center] bg-no-repeat pr-10">
              <option value="">Kies een onderwerp</option>
              {onderwerpen.map((o: string) => (
                <option value={o.toLowerCase().replace(/\s+/g, '-')}>{o}</option>
              ))}
            </select>
          </div>

          <div>
            <label for="bericht" class="block text-sm font-heading font-semibold text-primary mb-2">Bericht *</label>
            <textarea id="bericht" name="bericht" required aria-required="true" rows="5"
              class="w-full bg-white px-4 py-3.5 border border-slate-200 focus:border-primary focus:ring-2 focus:ring-primary/30 outline-none transition-all resize-y text-base"
              placeholder="Waar kunnen wij u mee helpen?"></textarea>
          </div>

          <button type="submit" id="contact-btn"
            class="w-full py-3.5 px-6 min-h-[48px] bg-accent text-white font-heading font-bold text-sm tracking-wide hover:brightness-110 active:brightness-90 transition-all disabled:opacity-60 disabled:cursor-not-allowed">
            Versturen
          </button>

          <div id="form-status" class="hidden" aria-live="polite"></div>
        </form>
      </div>

      <!-- Contact Info — Flat, from settings -->
      <div class="space-y-8">
        <div>
          <h2 class="text-2xl font-bold mb-8">Contactgegevens</h2>
          <div class="space-y-3">
            {settings.address && (
              <div class="flex items-start gap-4 p-4 bg-white border border-slate-200 border-l-[3px] border-l-primary">
                <svg class="w-5 h-5 mt-0.5 text-primary shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
                <div>
                  <p class="font-heading font-semibold text-primary text-sm">Adres</p>
                  <p class="text-neutral-600 text-sm mt-0.5">{settings.address}</p>
                </div>
              </div>
            )}
            {settings.phone && (
              <div class="flex items-start gap-4 p-4 bg-white border border-slate-200 border-l-[3px] border-l-primary">
                <svg class="w-5 h-5 mt-0.5 text-primary shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
                <div>
                  <p class="font-heading font-semibold text-primary text-sm">Telefoon</p>
                  <a href={`tel:${settings.phone.replace(/\s/g, '')}`} class="text-neutral-600 hover:text-primary text-sm mt-0.5 block transition-colors">{settings.phone}</a>
                </div>
              </div>
            )}
            {settings.email && (
              <div class="flex items-start gap-4 p-4 bg-white border border-slate-200 border-l-[3px] border-l-primary">
                <svg class="w-5 h-5 mt-0.5 text-primary shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" /></svg>
                <div>
                  <p class="font-heading font-semibold text-primary text-sm">E-mail</p>
                  <a href={`mailto:${settings.email}`} class="text-neutral-600 hover:text-primary text-sm mt-0.5 block transition-colors">{settings.email}</a>
                </div>
              </div>
            )}
            {settings.whatsapp && (
              <div class="flex items-start gap-4 p-4 bg-white border border-slate-200 border-l-[3px] border-l-whatsapp">
                <svg class="w-5 h-5 mt-0.5 text-whatsapp shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
                <div>
                  <p class="font-heading font-semibold text-whatsapp text-sm">WhatsApp</p>
                  <a href={`https://wa.me/${settings.whatsapp}`} target="_blank" rel="noopener noreferrer" class="text-neutral-600 hover:text-whatsapp text-sm mt-0.5 block transition-colors">Direct een bericht sturen</a>
                </div>
              </div>
            )}
          </div>
        </div>

        {/* Openingstijden uit CMS — alleen tonen als ingevuld */}
        {openingstijden.length > 0 && (
          <div class="bg-white p-6 border border-slate-200 border-t-[3px] border-t-accent">
            <h3 class="font-heading font-bold text-primary mb-5">Openingstijden</h3>
            <div class="space-y-3 text-sm">
              {openingstijden.map((item: any) => (
                <div class={`flex flex-col ${item.opmerking ? 'pt-3 border-t border-slate-100' : ''}`}>
                  <div class="flex justify-between">
                    <span class={item.opmerking ? 'text-primary font-medium' : 'text-neutral-600'}>{item.dagen}</span>
                    <span class={`font-medium ${item.opmerking ? 'text-primary' : 'text-neutral-800'}`}>{item.tijden}</span>
                  </div>
                  {item.opmerking && (
                    <span class="text-xs text-neutral-400 mt-1">{item.opmerking}</span>
                  )}
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </Section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const statusEl = document.getElementById('form-status') as HTMLDivElement;
  const btn = document.getElementById('contact-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Loading state with spinner
    const originalText = btn.textContent;
    btn.textContent = 'Versturen...';
    btn.disabled = true;

    const formData = new FormData(form);
    const data = Object.fromEntries(formData);

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        statusEl.innerHTML = `
          <div class="bg-primary/5 border-l-4 border-primary p-4 text-sm" tabindex="-1" role="status">
            <p class="font-heading font-bold text-primary mb-1">Bericht ontvangen</p>
            <p class="text-neutral-600">Bedankt voor uw bericht. Wij reageren zo snel mogelijk, in shaa Allah.</p>
          </div>
        `;
        statusEl.className = '';
        statusEl.querySelector('[tabindex]')?.focus();
        form.reset();
      } else {
        const result = await res.json().catch(() => ({}));
        throw new Error(result.error || 'Verzending mislukt');
      }
    } catch (err: any) {
      const msg = document.createElement('span');
      msg.textContent = err.message || 'Er is iets misgegaan. Probeer het later opnieuw.';
      statusEl.innerHTML = `
        <div class="bg-red-50 border-l-4 border-red-500 p-4 text-sm">
          <p class="font-heading font-bold text-red-700 mb-1">Fout bij verzenden</p>
          <p class="text-red-600"></p>
        </div>
      `;
      statusEl.querySelector('.text-red-600')!.appendChild(msg);
      statusEl.className = '';
      statusEl.querySelector('[class*="border-l-4"]')?.setAttribute('tabindex', '-1');
      (statusEl.querySelector('[tabindex]') as HTMLElement)?.focus();
    } finally {
      btn.innerHTML = originalText || 'Versturen';
      btn.disabled = false;
    }
  });
</script>
