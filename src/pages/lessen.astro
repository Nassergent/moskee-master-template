---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import SmartFilterBar from '../components/ui/education/SmartFilterBar.astro';
import LessonCard from '../components/ui/education/LessonCard.astro';
import ScheduleGrid from '../components/ui/education/ScheduleGrid.astro';
import PracticalInfo from '../components/ui/education/PracticalInfo.astro';
import { fetchLessonPrograms, fetchRamadanOverride, fetchSettings } from '../lib/sanity';
import { buildSiteConfig } from '../lib/logic/config';
import {
  getEffectiveSchedule,
  getUniqueCategories,
  shouldShowFilter,
  capitalizeCategorie,
  categoryToAnchor,
} from '../lib/logic/education';
import type { LessonProgram } from '../lib/logic/education';

const [programs, ramadanOverride, settings] = await Promise.all([
  fetchLessonPrograms(),
  fetchRamadanOverride(),
  fetchSettings(),
]);
const config = buildSiteConfig(settings);

const categories = getUniqueCategories(programs as LessonProgram[]);
const showFilter = shouldShowFilter(programs as LessonProgram[]);

// Group programs by category (preserving volgorde within each group)
const groupedPrograms = new Map<string, any[]>();
for (const cat of categories) {
  groupedPrograms.set(cat, programs.filter((p: any) => p.categorie === cat));
}
// Programs without category go at the end
const uncategorized = programs.filter((p: any) => !p.categorie);
if (uncategorized.length > 0) {
  groupedPrograms.set('algemeen', [
    ...(groupedPrograms.get('algemeen') || []),
    ...uncategorized.filter((p: any) => p.categorie !== 'algemeen'),
  ]);
}

let sectionIndex = 0;
const variants = ['light-50', 'light-100'] as const;

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=3600');
Astro.response.headers.set('Vercel-CDN-Cache-Control', 'public, s-maxage=300, stale-while-revalidate=3600');
Astro.response.headers.set('Vercel-Cache-Tag', 'lessons');
---

<BaseLayout title="Lessen" description="Overzicht van alle lesprogramma's bij onze moskee — Koranles, Arabisch en meer.">
  <!-- Page Header — Dark -->
  <section class="bg-primary-dark text-white py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-6 text-center animate-fade-in-up">
      <h1 class="text-4xl font-bold mb-4 text-white">Onze Lessen</h1>
      <p class="text-white/80 max-w-xl mx-auto">
        Van Koranles tot Arabisch — ontdek ons educatief aanbod voor alle leeftijden
      </p>
    </div>
  </section>

  {/* Smart Filter Bar — only when multiple categories */}
  {showFilter && <SmartFilterBar categories={categories} />}

  {programs.length > 0 ? (
    <>
      {[...groupedPrograms.entries()].map(([cat, catPrograms]) => {
        if (catPrograms.length === 0) return null;
        return (
          <>
            {/* Category Header */}
            {showFilter && (
              <Section variant="light-50" id={categoryToAnchor(cat)}>
                <h2 class="font-heading text-2xl md:text-3xl font-bold">
                  {capitalizeCategorie(cat)}
                </h2>
              </Section>
            )}

            {/* Programs in this category */}
            {catPrograms.map((program: any) => {
              const schedule = getEffectiveSchedule(program.rooster, ramadanOverride);
              const variant = variants[sectionIndex++ % 2];
              const isRamadan = schedule.type === 'ramadan';
              return (
                <Section variant={variant}>
                  <LessonCard
                    titel={program.titel}
                    beschrijving={program.beschrijving}
                    inhoud={program.inhoud}
                    afbeelding={program.afbeelding}
                  />

                  {schedule.items.length > 0 && (
                    <div class:list={['mt-10', { 'bg-base p-6 border-l-[3px] border-l-accent': isRamadan }]}>
                      <h4 class="font-heading text-xl font-bold mb-4">
                        {isRamadan ? 'Ramadan Rooster' : 'Lesrooster'}
                      </h4>
                      <ScheduleGrid schedule={schedule} locale={config.locale} />
                    </div>
                  )}

                  <PracticalInfo
                    categorie={program.categorie}
                    maxCapaciteit={program.maxCapaciteit}
                    inschrijvingOpen={program.inschrijvingOpen}
                    vrijwilligersLink={program.vrijwilligersLink}
                  />
                </Section>
              );
            })}
          </>
        );
      })}
    </>
  ) : (
    <!-- Empty state -->
    <Section variant="light-50">
      <div class="max-w-xl mx-auto text-center py-12">
        <svg class="w-16 h-16 mx-auto mb-6 text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <h2 class="text-2xl font-bold mb-3">Nog geen lessen gepubliceerd</h2>
        <p class="text-neutral-500 mb-6">
          Binnenkort voegen we ons educatief aanbod toe. Neem contact op voor meer informatie.
        </p>
        <a href="/contact" class="inline-flex items-center px-8 py-3 bg-accent hover:bg-accent-hover text-white font-bold transition-all">
          Contact opnemen
        </a>
      </div>
    </Section>
  )}

  <!-- CTA -->
  <Section variant={sectionIndex % 2 === 0 ? 'light-50' : 'light-100'}>
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-2xl font-bold mb-4">Vragen over onze lessen?</h2>
      <p class="text-neutral-600 mb-8">Neem gerust contact met ons op voor meer informatie of inschrijvingen.</p>
      <a href="/contact" class="btn-primary inline-flex items-center px-8 py-3 bg-accent hover:bg-accent-hover text-white font-bold transition-all">
        Contact opnemen
      </a>
    </div>
  </Section>
</BaseLayout>
