---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import GeoIcon from '../components/GeoIcon.astro';
import { fetchNieuws, urlFor } from '../lib/sanity';

const nieuws = await fetchNieuws();
---

<BaseLayout title="Nieuws" description="Het laatste nieuws en aankondigingen van onze moskee">
  <!-- Page Header — Dark -->
  <section class="bg-primary-dark text-white py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-6 text-center animate-fade-in-up">
      <h1 class="text-4xl font-bold mb-4 text-white">Nieuws & Updates</h1>
      <p class="text-white/80 max-w-xl mx-auto">
        Blijf op de hoogte van het laatste nieuws en aankondigingen
      </p>
    </div>
  </section>

  <!-- News Grid — Flat cards with left accent border -->
  <Section variant="light-50">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {nieuws.filter((item) => item.slug?.current).map((item) => (
          <a
            href={`/nieuws/${item.slug.current}`}
            class="group bg-white border border-neutral-200 border-l-3 border-l-accent overflow-hidden hover:border-l-primary transition-all"
          >
            {item.afbeelding ? (
              <img
                src={urlFor(item.afbeelding).width(600).height(300).fit('crop').url()}
                alt={item.titel}
                class="w-full h-44 object-cover"
                loading="lazy"
              />
            ) : (
              <div class="bg-primary/5 h-44 flex items-center justify-center">
                <GeoIcon name="ster-4" size="xl" class="text-primary/20 !w-16 !h-16" />
              </div>
            )}
            <div class="p-6">
              <time class="text-xs text-neutral-400" datetime={item.datum}>
                {new Date(item.datum).toLocaleDateString('nl-BE', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <h2 class="font-heading text-lg font-bold group-hover:text-primary transition-colors mt-2 mb-3">
                {item.titel}
              </h2>
              <p class="text-neutral-600 text-sm leading-relaxed">{item.samenvatting}</p>
              <span class="inline-block mt-4 text-primary text-sm font-medium group-hover:underline">
                Lees meer &rarr;
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </Section>
</BaseLayout>
