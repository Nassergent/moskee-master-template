---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import PostTypeBadge from '../components/ui/PostTypeBadge.astro';
import { fetchNieuws, fetchSettings, urlFor } from '../lib/sanity';
import { sanitizeAlt } from '../lib/logic/seo-utils';
import { buildSiteConfig } from '../lib/logic/config';
import { isFeatureEnabled } from '../lib/logic/menu-builder';

const [nieuws, settings] = await Promise.all([fetchNieuws(), fetchSettings()]);

if (!isFeatureEnabled(settings, 'showNieuws')) {
  return Astro.redirect('/404', 404);
}
const config = buildSiteConfig(settings);
---

<BaseLayout title="Nieuws uit de moskee" description="Recente berichten en aankondigingen uit onze moskee-gemeenschap">
  <!-- Page Header — Dark -->
  <section class="bg-primary-dark text-white py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-6 text-center animate-fade-in-up">
      <h1 class="text-4xl font-bold mb-4 text-white">Nieuws uit de moskee</h1>
      <p class="text-white/80 max-w-xl mx-auto">
        Recente berichten en aankondigingen
      </p>
    </div>
  </section>

  <!-- News Grid — Flat cards with left accent border -->
  <Section variant="light-50">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {nieuws.filter((item) => item.slug).map((item) => (
          <a
            href={`/nieuws/${item.slug}`}
            class="group bg-white border border-neutral-200 border-l-3 border-l-accent overflow-hidden hover:border-l-primary transition-all"
          >
            {item.afbeelding ? (
              <img
                src={urlFor(item.afbeelding).width(400).height(200).fit('crop').url()}
                width={400}
                height={200}
                alt={sanitizeAlt(item.titel)}
                class="w-full aspect-[2/1] object-cover"
                loading="lazy"
              />
            ) : (
              <div class="bg-primary/5 aspect-[2/1] flex items-center justify-center">
                <span class="text-primary/20 text-5xl">✦</span>
              </div>
            )}
            <div class="p-6">
              <div class="flex items-center gap-2 mb-2">
                <PostTypeBadge postType={item.postType} />
                <time class="text-xs text-neutral-400" datetime={item.datum}>
                  {new Date(item.datum).toLocaleDateString(config.locale, { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              </div>
              <h2 class="font-heading text-lg font-bold group-hover:text-primary transition-colors mb-3">
                {item.titel}
              </h2>
              <p class="text-neutral-600 text-sm leading-relaxed">{item.samenvatting}</p>
              <span class="inline-block mt-4 text-primary text-sm font-medium group-hover:underline">
                Lees meer &rarr;
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </Section>
</BaseLayout>
