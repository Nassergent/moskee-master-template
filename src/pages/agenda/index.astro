---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import { fetchAgendaEvents, fetchSettings } from '../../lib/sanity';
import { formatHijriDate } from '../../lib/hijri';

const settings = await fetchSettings();
const events = await fetchAgendaEvents();
const hijriToday = formatHijriDate();

function formatDatum(datum: string): string {
  return new Date(datum).toLocaleDateString('nl-BE', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    timeZone: 'Europe/Brussels',
  });
}

function formatTijd(datum: string): string {
  const str = new Date(datum).toLocaleTimeString('nl-BE', {
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'Europe/Brussels',
  });
  return str === '00:00' ? '' : str;
}

const categorieen = [...new Set(events.map((e: any) => e.categorie).filter(Boolean))];
---

<BaseLayout title="Agenda" description="Ontdek de activiteiten en evenementen van onze moskee.">

  <!-- Page Header -->
  <section class="bg-primary-dark text-white py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-6 text-center animate-fade-in-up">
      <h1 class="text-4xl font-bold mb-4 text-white">Agenda</h1>
      <p class="text-white/80 max-w-xl mx-auto">
        Ontdek onze activiteiten en evenementen
      </p>
      <p class="text-white/50 font-arabic text-sm mt-3">{hijriToday}</p>
    </div>
  </section>

  <!-- Filter + Events -->
  <Section variant="light-50">

    {/* Categorie filters */}
    {categorieen.length > 1 && (
      <div class="flex flex-wrap gap-2 mb-10 justify-center" id="agenda-filters">
        <button
          class="agenda-filter-btn active badge px-4 py-1.5 text-sm font-semibold rounded-full bg-primary text-white cursor-pointer transition-all"
          data-categorie="alle"
        >
          Alle
        </button>
        {categorieen.map((cat: string) => (
          <button
            class="agenda-filter-btn badge px-4 py-1.5 text-sm font-semibold rounded-full bg-neutral-100 text-neutral-600 cursor-pointer transition-all"
            data-categorie={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    )}

    {/* Events grid */}
    {events.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="agenda-grid">
        {events.map((event: any) => (
          <a
            href={`/agenda/${event.slug.current}`}
            class="agenda-event-card group bg-white border border-neutral-200 border-l-3 border-l-accent hover:border-l-primary transition-all block"
            data-categorie={event.categorie || 'Overig'}
          >
            {event.afbeelding && (
              <img
                src={event.afbeelding + '?w=600&h=250&fit=crop'}
                alt={event.titel}
                class="w-full h-40 object-cover"
                loading="lazy"
              />
            )}
            <div class="p-6">
              {event.categorie && (
                <span class="badge inline-block px-3 py-1 rounded-full text-[10px] font-semibold uppercase tracking-wider bg-accent/10 text-accent mb-3">
                  {event.categorie}
                </span>
              )}
              <h3 class="font-heading text-lg font-bold text-primary group-hover:text-accent transition-colors mb-2">
                {event.titel}
              </h3>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-neutral-500 mb-2">
                <span class="flex items-center gap-1.5">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                  </svg>
                  {formatDatum(event.startDatum)}
                </span>
                {formatTijd(event.startDatum) && (
                  <span class="badge text-xs px-2 py-0.5 rounded-full bg-accent/10 text-accent">
                    {formatTijd(event.startDatum)}
                  </span>
                )}
              </div>
              {event.locatie && (
                <p class="text-xs text-neutral-400 flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                  </svg>
                  {event.locatie}
                </p>
              )}
              {event.beschrijving && (
                <p class="text-sm text-neutral-500 mt-2 line-clamp-2">{event.beschrijving}</p>
              )}
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <div class="w-16 h-16 bg-primary-light flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5m-9-3.75h.008v.008H12v-.008z" />
          </svg>
        </div>
        <h3 class="text-lg font-heading font-bold text-primary mb-2">Geen aankomende activiteiten</h3>
        <p class="text-neutral-500 mb-6">Er zijn momenteel geen geplande evenementen.</p>
        <a href="/contact" class="btn-primary inline-flex items-center gap-2 px-6 py-3 bg-accent text-white font-bold text-sm transition-all">
          Neem contact op
        </a>
      </div>
    )}
  </Section>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.agenda-filter-btn');
    const cards = document.querySelectorAll('.agenda-event-card');
    if (filterBtns.length === 0) return;

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = (btn as HTMLElement).dataset.categorie;
        filterBtns.forEach((b) => {
          const el = b as HTMLElement;
          if (b === btn) {
            el.className = el.className.replace('bg-neutral-100 text-neutral-600', 'bg-primary text-white');
            el.classList.add('active');
          } else {
            el.className = el.className.replace('bg-primary text-white', 'bg-neutral-100 text-neutral-600');
            el.classList.remove('active');
          }
        });
        cards.forEach((card) => {
          const el = card as HTMLElement;
          el.style.display = (cat === 'alle' || el.dataset.categorie === cat) ? '' : 'none';
        });
      });
    });
  });
</script>
