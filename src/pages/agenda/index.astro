---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import { fetchAgendaEvents, fetchEventCategories, fetchSettings, urlFor } from '../../lib/sanity';
import { formatHijriDate } from '../../lib/hijri';
import { buildFilterCategories, formatDatum, formatTijd, formatRecurrence } from '../../lib/logic/agenda-utils';
import { sanitizeAlt } from '../../lib/logic/seo-utils';
import { isFeatureEnabled } from '../../lib/logic/menu-builder';

const settings = await fetchSettings();

if (!isFeatureEnabled(settings, 'showAgenda')) {
  return Astro.redirect('/404', 404);
}
const events = await fetchAgendaEvents();
const cmsCategories = await fetchEventCategories();
const hijriToday = formatHijriDate();

const featuredEvents = events.filter((e: any) => e.featured);
const regularEvents = events.filter((e: any) => !e.featured);
const allEvents = [...featuredEvents, ...regularEvents];
const filterCategories = buildFilterCategories(cmsCategories, allEvents);

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=3600');
Astro.response.headers.set('Vercel-CDN-Cache-Control', 'public, s-maxage=300, stale-while-revalidate=3600');
Astro.response.headers.set('Vercel-Cache-Tag', 'agenda');
---

<BaseLayout title="Activiteiten" description="Ontdek de activiteiten en evenementen van onze moskee.">

  <!-- Page Header -->
  <section class="bg-primary-dark text-white py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-6 text-center animate-fade-in-up">
      <h1 class="text-4xl font-bold mb-4 text-white">Activiteiten</h1>
      <p class="text-white/80 max-w-xl mx-auto">
        Ontdek onze activiteiten en evenementen
      </p>
      <p class="text-white/50 font-arabic text-sm mt-3" lang="ar" dir="rtl">{hijriToday}</p>
    </div>
  </section>

  <!-- Featured Events -->
  {featuredEvents.length > 0 && (
    <Section variant="light-100">
      <div class="text-center mb-10">
        <h2 class="text-2xl font-bold">Uitgelicht</h2>
      </div>
      <div class="grid grid-cols-1 gap-6">
        {featuredEvents.map((event: any) => (
          <a
            href={`/agenda/${event.slug}`}
            class="agenda-event-card group bg-white border border-slate-200 transition-all block hover:bg-primary-light/40 md:grid md:grid-cols-[1fr_2fr]"
            style={`border-left: 4px solid ${event.categorieKleur || '#8b6843'}`}
            data-categorie={event.categorie || 'Overig'}
          >
            {event.afbeelding && (
              <img
                src={urlFor(event.afbeelding).width(600).height(400).fit('crop').url()}
                alt={sanitizeAlt(event.titel)}
                class="w-full aspect-[3/2] object-cover"
                width={600}
                height={400}
                loading="lazy"
              />
            )}
            <div class="p-6 md:p-8 flex flex-col justify-center">
              <div class="flex flex-wrap items-center gap-2 mb-3">
                {event.categorie && (
                  <span
                    class="badge inline-block px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white"
                    style={`background-color: ${event.categorieKleur || 'var(--color-primary)'}`}
                  >
                    {event.categorie}
                  </span>
                )}
                {event.doelgroep && event.doelgroep !== 'Iedereen' && (
                  <span class="badge inline-block px-3 py-1 text-xs font-semibold uppercase tracking-wider bg-neutral-100 text-neutral-700">
                    {event.doelgroep}
                  </span>
                )}
              </div>
              <h3 class="font-heading text-xl font-bold text-primary group-hover:underline group-hover:decoration-accent transition-colors mb-2">
                {event.titel}
              </h3>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-neutral-600 mb-2">
                <span class="flex items-center gap-1.5">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                  </svg>
                  {formatDatum(event.startDatum)}
                </span>
                {formatTijd(event.startDatum) && (
                  <span class="badge text-xs px-2 py-0.5 bg-primary/10 text-primary font-semibold">
                    {formatTijd(event.startDatum)}
                  </span>
                )}
              </div>
              {formatRecurrence(event) && (
                <p class="text-xs text-neutral-500 mb-2">
                  <span class="uppercase tracking-wider font-semibold">Herhaalt zich</span>
                  <span class="text-neutral-400 mx-1">·</span>
                  <span class="text-neutral-700 font-medium">{formatRecurrence(event)}</span>
                </p>
              )}
              {event.locatie && (
                <p class="text-sm text-slate-600 flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                  </svg>
                  {event.locatie}
                </p>
              )}
              {event.beschrijving && (
                <p class="text-sm text-neutral-600 mt-2 line-clamp-2">
                  {Array.isArray(event.beschrijving)
                    ? event.beschrijving.map((b: any) => b.children?.map((c: any) => c.text).join('')).filter(Boolean).join(' ')
                    : event.beschrijving}
                </p>
              )}
            </div>
          </a>
        ))}
      </div>
    </Section>
  )}

  <!-- Filter + Regular Events -->
  <Section variant="light-50">

    {/* Categorie filters */}
    {filterCategories.length > 1 && (
      <div class="flex flex-wrap gap-2 mb-10 justify-center" id="agenda-filters">
        <button
          class="agenda-filter-btn active badge px-4 py-1.5 min-h-[44px] text-sm font-semibold bg-primary text-white cursor-pointer transition-all"
          data-categorie="alle"
        >
          Alle
        </button>
        {filterCategories.map((cat) => (
          <button
            class="agenda-filter-btn badge px-4 py-1.5 min-h-[44px] text-sm font-semibold bg-neutral-100 text-neutral-600 cursor-pointer transition-all"
            data-categorie={cat.titel}
            data-kleur={cat.kleur || ''}
          >
            {cat.icoon ? `${cat.icoon} ${cat.titel}` : cat.titel}
          </button>
        ))}
      </div>
    )}

    {/* Events grid */}
    {regularEvents.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="agenda-grid">
        {regularEvents.map((event: any) => (
          <a
            href={`/agenda/${event.slug}`}
            class="agenda-event-card group bg-white border border-slate-200 transition-all block hover:bg-primary-light/40"
            style={`border-left: 3px solid ${event.categorieKleur || '#8b6843'}`}
            data-categorie={event.categorie || 'Overig'}
          >
            {event.afbeelding && (
              <img
                src={urlFor(event.afbeelding).width(600).height(250).fit('crop').url()}
                alt={sanitizeAlt(event.titel)}
                class="w-full aspect-[12/5] object-cover"
                width={600}
                height={250}
                loading="lazy"
              />
            )}
            <div class="p-6">
              <div class="flex flex-wrap items-center gap-2 mb-3">
                {event.categorie && (
                  <span
                    class="badge inline-block px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white"
                    style={`background-color: ${event.categorieKleur || 'var(--color-primary)'}`}
                  >
                    {event.categorie}
                  </span>
                )}
                {event.doelgroep && event.doelgroep !== 'Iedereen' && (
                  <span class="badge inline-block px-3 py-1 text-xs font-semibold uppercase tracking-wider bg-neutral-100 text-neutral-700">
                    {event.doelgroep}
                  </span>
                )}
              </div>
              <h3 class="font-heading text-lg font-bold text-primary group-hover:underline group-hover:decoration-accent transition-colors mb-2">
                {event.titel}
              </h3>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-neutral-600 mb-2">
                <span class="flex items-center gap-1.5">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                  </svg>
                  {formatDatum(event.startDatum)}
                </span>
                {formatTijd(event.startDatum) && (
                  <span class="badge text-xs px-2 py-0.5 bg-primary/10 text-primary font-semibold">
                    {formatTijd(event.startDatum)}
                  </span>
                )}
              </div>
              {formatRecurrence(event) && (
                <p class="text-xs text-neutral-500 mb-2">
                  <span class="uppercase tracking-wider font-semibold">Herhaalt zich</span>
                  <span class="text-neutral-400 mx-1">·</span>
                  <span class="text-neutral-700 font-medium">{formatRecurrence(event)}</span>
                </p>
              )}
              {event.locatie && (
                <p class="text-sm text-slate-600 flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                  </svg>
                  {event.locatie}
                </p>
              )}
              {event.beschrijving && (
                <p class="text-sm text-neutral-600 mt-2 line-clamp-2">
                  {Array.isArray(event.beschrijving)
                    ? event.beschrijving.map((b: any) => b.children?.map((c: any) => c.text).join('')).filter(Boolean).join(' ')
                    : event.beschrijving}
                </p>
              )}
            </div>
          </a>
        ))}
      </div>
    ) : featuredEvents.length === 0 ? (
      <div class="text-center py-16">
        <div class="w-16 h-16 bg-primary-light flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5m-9-3.75h.008v.008H12v-.008z" />
          </svg>
        </div>
        <h3 class="text-lg font-heading font-bold text-primary mb-2">Geen aankomende activiteiten</h3>
        <p class="text-neutral-500 mb-6">Er zijn momenteel geen geplande evenementen.</p>
        <a href="/contact" class="btn-primary inline-flex items-center gap-2 px-6 py-3 bg-accent text-white font-bold text-sm transition-all">
          Neem contact op
        </a>
      </div>
    ) : null}
  </Section>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.agenda-filter-btn');
    const cards = document.querySelectorAll('.agenda-event-card');
    if (filterBtns.length === 0) return;

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = (btn as HTMLElement).dataset.categorie;
        const kleur = (btn as HTMLElement).dataset.kleur;

        filterBtns.forEach((b) => {
          const el = b as HTMLElement;
          if (b === btn) {
            el.classList.remove('bg-neutral-100', 'text-neutral-600');
            if (kleur) {
              el.style.backgroundColor = kleur;
              el.style.color = '#fff';
            } else {
              el.classList.add('bg-primary', 'text-white');
            }
            el.classList.add('active');
          } else {
            el.classList.remove('bg-primary', 'text-white', 'active');
            el.style.backgroundColor = '';
            el.style.color = '';
            el.classList.add('bg-neutral-100', 'text-neutral-600');
          }
        });

        cards.forEach((card) => {
          const el = card as HTMLElement;
          el.style.display = (cat === 'alle' || el.dataset.categorie === cat) ? '' : 'none';
        });
      });
    });
  });
</script>
