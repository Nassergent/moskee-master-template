---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import AddToCalendar from '../../components/AddToCalendar.astro';
import PortableText from '../../components/PortableText.astro';
import { fetchAgendaEvent, fetchSettings, urlFor } from '../../lib/sanity';
import { formatHijriDate } from '../../lib/hijri';
import { formatDatum, formatTijd } from '../../lib/logic/agenda-utils';
import { sanitizeAlt } from '../../lib/logic/seo-utils';
import { buildSiteConfig } from '../../lib/logic/config';

const { slug } = Astro.params;
const event = await fetchAgendaEvent(slug!);
if (!event) return Astro.redirect('/agenda');

const settings = await fetchSettings();
const config = buildSiteConfig(settings);
const tz = config.timezone;

// Wrapper functies met detail-pagina opmaak (jaar + dynamische timezone)
const fmtDatum = (d: string) => formatDatum(d, { year: true, tz });
const fmtTijd = (d: string) => formatTijd(d, tz);

// Topic Hub: link naar hoofdartikel als dit evenement eraan gekoppeld is
const parentHub = event.onderwerpHub;

const eventSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Event",
  "name": event.titel,
  "description": event.beschrijving || undefined,
  "startDate": event.startDatum || undefined,
  "endDate": event.eindDatum || undefined,
  "location": event.locatie ? {
    "@type": "Place",
    "name": event.locatie,
    "address": settings?.address || undefined,
  } : undefined,
});
---

<BaseLayout title={event.titel} description={event.beschrijving || `${event.titel} bij ${settings?.mosqueName || 'Moskee'}.`} ogImage={event.afbeelding ? urlFor(event.afbeelding).width(1200).height(630).fit('crop').url() : undefined} breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Activiteiten', href: '/agenda' }, { name: event.titel, href: `/agenda/${slug}` }]}>
  <script type="application/ld+json" set:html={eventSchema} />

  <!-- Page Header -->
  <section class="bg-primary-dark text-white py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-6 text-center animate-fade-in-up">
      <div class="flex flex-wrap items-center justify-center gap-2 mb-4">
        {event.categorie && (
          <span
            class="badge inline-block px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white"
            style={`background-color: ${event.categorieKleur || 'rgba(201, 169, 131, 0.3)'}`}
          >
            {event.categorie}
          </span>
        )}
        {event.doelgroep && event.doelgroep !== 'Iedereen' && (
          <span class="badge inline-block px-3 py-1 text-xs font-semibold uppercase tracking-wider bg-white/20 text-white">
            {event.doelgroep}
          </span>
        )}
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-3 text-white">
        {event.titel}
      </h1>
    </div>
  </section>

  <!-- Content -->
  <Section variant="light-50">
    <div class="max-w-3xl mx-auto">

      <!-- Topic Hub Context Link -->
      {parentHub && parentHub.slug && (
        <a
          href={`/nieuws/${parentHub.slug}`}
          class="flex items-center gap-3 bg-base-100 border border-neutral-200 border-l-[3px] border-l-accent p-5 mb-8 hover:border-l-primary transition-all group"
        >
          <svg class="w-5 h-5 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
          <div>
            <p class="text-xs text-neutral-400 uppercase tracking-wider font-bold">Onderdeel van</p>
            <p class="font-heading font-bold text-primary group-hover:text-accent transition-colors">{parentHub.titel}</p>
          </div>
          <svg class="w-4 h-4 text-neutral-400 ml-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      )}

      <!-- Datum & Locatie -->
      <div class="bg-white border border-neutral-200 p-6 md:p-8 mb-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 bg-primary-light flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
              </svg>
            </div>
            <div>
              <p class="text-xs text-neutral-400 uppercase tracking-wider mb-0.5">Datum & Tijd</p>
              <p class="font-medium text-neutral-800">{fmtDatum(event.startDatum)}</p>
              {fmtTijd(event.startDatum) && (
                <p class="text-sm text-accent font-semibold">
                  {fmtTijd(event.startDatum)}{event.eindDatum && fmtTijd(event.eindDatum) ? ` – ${fmtTijd(event.eindDatum)}` : ''}
                </p>
              )}
            </div>
          </div>

          {event.locatie && (
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 bg-primary-light flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-neutral-400 uppercase tracking-wider mb-0.5">Locatie</p>
                <p class="font-medium text-neutral-800">{event.locatie}</p>
                {settings?.address && (
                  <p class="text-xs text-neutral-400">{settings?.mosqueName}, {settings?.address}</p>
                )}
              </div>
            </div>
          )}
        </div>
      </div>

      {/* Afbeelding */}
      {event.afbeelding && (
        <div class="overflow-hidden mb-8 border border-neutral-200">
          <img
            src={urlFor(event.afbeelding).width(800).height(450).fit('crop').url()}
            alt={sanitizeAlt(event.titel)}
            class="w-full h-auto"
            width={800}
            height={450}
            loading="lazy"
          />
        </div>
      )}

      {/* Beschrijving */}
      {event.beschrijving && (
        <div class="mb-8">
          <h2 class="text-xl font-bold mb-4">Over dit evenement</h2>
          {Array.isArray(event.beschrijving) ? (
            <PortableText value={event.beschrijving} />
          ) : (
            <div class="text-neutral-600 leading-relaxed whitespace-pre-line">
              {event.beschrijving}
            </div>
          )}
        </div>
      )}

      {/* Hijri datum */}
      <p class="text-sm text-neutral-400 font-arabic mb-6" lang="ar" dir="rtl">{formatHijriDate(new Date(event.startDatum))}</p>

      {/* AddToCalendar */}
      <div class="mb-8">
        <AddToCalendar
          titel={event.titel}
          startDatum={event.startDatum}
          eindDatum={event.eindDatum}
          locatie={event.locatie}
          beschrijving={Array.isArray(event.beschrijving) ? event.beschrijving.map((b: any) => b.children?.map((c: any) => c.text).join('')).filter(Boolean).join('\n') : event.beschrijving}
          mosqueName={settings?.mosqueName}
          address={settings?.address}
        />
      </div>

      {/* Terug link */}
      <a
        href="/agenda"
        class="inline-flex items-center gap-2 min-h-[44px] text-sm font-medium text-primary hover:text-accent transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        Terug naar agenda
      </a>
    </div>
  </Section>
</BaseLayout>
