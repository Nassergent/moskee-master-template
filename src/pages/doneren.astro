---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import DonationCard from '../components/DonationCard.astro';
import { fetchProjecten, fetchSettings, fetchAllQuotes } from '../lib/sanity';
import { calculateProjectStats } from '../lib/logic/project-utils';

const projecten = await fetchProjecten();
const settings = await fetchSettings();
const quotes = await fetchAllQuotes('donaties');

const hasProjects = projecten && projecten.length > 0;
const { totalRaised, activeCount: activeProjectCount, options: projectOptions } = hasProjects
  ? calculateProjectStats(projecten)
  : { totalRaised: 0, activeCount: 0, options: [] };

const showMollie = settings.menuToggles?.showMollie !== false;
---

<BaseLayout title="Doneren" description="Steun onze moskee met een donatie">
  <!-- Page Header — Dark -->
  <section class="bg-primary-dark text-white py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-6 text-center animate-fade-in-up">
      <h1 class="text-4xl font-bold mb-4 text-white">Doneren</h1>
      <p class="text-white/80 max-w-xl mx-auto">
        Uw steun houdt onze moskee draaiende en helpt de gemeenschap groeien
      </p>
    </div>
  </section>

  <!-- Islamitische Citaten Carousel -->
  {quotes.length > 0 && (
    <Section variant="light-100">
      <div class="max-w-3xl mx-auto text-center py-4">
        <div id="quote-carousel-doneren" class="relative min-h-[180px] flex items-center justify-center" aria-live="polite">
          {quotes.map((q: any, i: number) => (
            <div class:list={['quote-slide-doneren absolute inset-0 flex flex-col items-center justify-center transition-opacity duration-700', i === 0 ? 'opacity-100' : 'opacity-0 pointer-events-none']}>
              {q.tekstArabisch && (
                <p class="font-arabic text-3xl md:text-4xl leading-loose mb-6 text-primary/70" dir="rtl" lang="ar">
                  {q.tekstArabisch}
                </p>
              )}
              <p class="text-lg md:text-xl font-heading text-primary/90 italic leading-relaxed max-w-2xl">
                "{q.tekst}"
              </p>
              <p class="text-sm mt-4" style="color: var(--color-accent-gold);">— {q.bron}</p>
            </div>
          ))}
        </div>
        {quotes.length > 1 && (
          <div class="flex justify-center gap-2 mt-6" role="tablist">
            {quotes.map((_: any, i: number) => (
              <button
                class:list={['quote-dot-doneren w-2 h-2 rounded-full transition-all duration-300', i === 0 ? 'bg-accent w-6' : 'bg-neutral-300']}
                data-index={i}
                role="tab"
                aria-label={`Citaat ${i + 1}`}
              />
            ))}
          </div>
        )}
      </div>
    </Section>
  )}

  <!-- Donatie Sectie (Mollie formulier) — alleen als showMollie aan staat -->
  {showMollie && (
    <Section variant="light-50">
      <div class:list={[
        'mx-auto',
        hasProjects ? 'max-w-6xl grid grid-cols-1 lg:grid-cols-5 gap-12' : 'max-w-2xl'
      ]}>

        <!-- Donatie Formulier -->
        <div class:list={[hasProjects ? 'lg:col-span-3' : '']}>
          <h2 class="text-2xl font-bold font-heading text-primary mb-4">Direct doneren</h2>
          {totalRaised > 0 && (
            <p class="text-sm text-neutral-500 mb-8 flex items-center gap-2">
              <svg class="w-4 h-4 text-accent" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
              Al &euro;{totalRaised.toLocaleString('nl-BE')} opgehaald via {activeProjectCount} {activeProjectCount === 1 ? 'project' : 'projecten'}
            </p>
          )}
          <div class="bg-white border border-neutral-200 p-8">
            <form id="donation-form" class="space-y-8">
              {/* Honeypot — verborgen voor echte gebruikers */}
              <div class="hidden" aria-hidden="true">
                <input type="text" name="website" tabindex="-1" autocomplete="off" />
              </div>

              <!-- Bedrag Knoppen -->
              <fieldset>
                <legend class="block text-sm font-medium text-slate-800 mb-3">Kies een bedrag</legend>
                <p class="text-xs text-neutral-400 mb-3">&euro;10 = 1 maaltijd &middot; &euro;50 = 1 dag onderhoud &middot; &euro;100 = 1 week educatie</p>
                <div class="grid grid-cols-2 gap-3">
                  <button type="button" data-amount="10" aria-pressed="false" aria-label="Doneer &euro;10" class="donation-amount-btn py-5 min-h-[56px] text-2xl font-heading font-bold transition-all border border-primary text-primary hover:bg-primary hover:text-white active:brightness-90 focus-visible:ring-2 focus-visible:ring-primary/50">
                    &euro;10
                  </button>
                  <button type="button" data-amount="25" aria-pressed="true" aria-label="Doneer &euro;25" class="donation-amount-btn active py-5 min-h-[56px] text-2xl font-heading font-bold transition-all border border-primary bg-primary text-white active:brightness-90 focus-visible:ring-2 focus-visible:ring-primary/50">
                    &euro;25
                  </button>
                  <button type="button" data-amount="50" aria-pressed="false" aria-label="Doneer &euro;50" class="donation-amount-btn py-5 min-h-[56px] text-2xl font-heading font-bold transition-all border border-primary text-primary hover:bg-primary hover:text-white active:brightness-90 focus-visible:ring-2 focus-visible:ring-primary/50">
                    &euro;50
                  </button>
                  <button type="button" data-amount="100" aria-pressed="false" aria-label="Doneer &euro;100" class="donation-amount-btn py-5 min-h-[56px] text-2xl font-heading font-bold transition-all border border-primary text-primary hover:bg-primary hover:text-white active:brightness-90 focus-visible:ring-2 focus-visible:ring-primary/50">
                    &euro;100
                  </button>
                </div>
              </fieldset>

              <!-- Eigen Bedrag -->
              <div>
                <label class="block text-sm font-medium text-slate-800 mb-3">Of vul een eigen bedrag in</label>
                <div id="custom-amount-wrapper" class="relative border-2 border-neutral-200 hover:border-neutral-300 transition-all focus-within:ring-2 focus-within:ring-primary/30">
                  <span class="absolute left-4 top-1/2 -translate-y-1/2 text-primary font-heading font-bold text-2xl sm:text-3xl">&euro;</span>
                  <input
                    type="number"
                    id="custom-amount"
                    min="1"
                    max="10000"
                    inputmode="decimal"
                    placeholder=""
                    aria-label="Donatiebedrag in euro"
                    class="w-full pl-12 pr-4 py-4 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary/30 text-slate-800 font-heading font-bold text-2xl sm:text-3xl"
                  />
                </div>
                <p class="text-xs text-neutral-400 mt-1">Bedrag tussen &euro;1 en &euro;10.000</p>
              </div>

              <!-- Bestemming (alleen als er projecten zijn) -->
              {hasProjects && (
                <div>
                  <label class="block text-sm font-medium text-slate-800 mb-3">Bestemming</label>
                  <select
                    id="donation-project"
                    class="w-full px-4 py-3 border border-neutral-200 bg-white text-slate-800 focus:border-primary focus:ring-2 focus:ring-primary/30 focus:outline-none transition-colors"
                  >
                    <option value="algemeen">Algemene Sadaqa</option>
                    {projectOptions.map((p: any) => (
                      <option value={p.titel}>{p.titel}</option>
                    ))}
                  </select>
                </div>
              )}

              <!-- E-mail (optioneel, voor bedankmail) -->
              <div>
                <label class="block text-sm font-medium text-slate-800 mb-3">E-mailadres <span class="text-neutral-400 font-normal">(optioneel, voor bevestiging)</span></label>
                <input
                  type="email"
                  id="donation-email"
                  placeholder="uw@email.be"
                  class="w-full px-4 py-3 border border-neutral-200 bg-white text-slate-800 focus:border-primary focus:ring-2 focus:ring-primary/30 focus:outline-none transition-colors"
                />
              </div>

              <!-- Error -->
              <p id="donation-error" class="text-sm text-red-600 bg-red-50 p-3 text-center hidden" role="alert" aria-live="polite"></p>

              <!-- Trust Badges (before submit for CRO) -->
              <div class="bg-accent/5 border border-accent/20 p-4 text-center">
                <p class="text-xs text-neutral-500 flex items-center justify-center gap-2">
                  <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
                  </svg>
                  Beveiligd via Mollie &middot; Bancontact &middot; iDEAL &middot; Visa &middot; Mastercard
                </p>
                <p class="text-[10px] text-neutral-400 mt-1">100% non-profit — uw donatie gaat direct naar projecten</p>
              </div>

              <!-- Betaalknop -->
              <button
                type="submit"
                id="donation-submit"
                class="w-full bg-primary hover:bg-primary-dark active:brightness-90 text-white py-4 min-h-[52px] font-bold text-lg transition-all flex items-center justify-center gap-2"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                </svg>
                Donatie afronden via iDEAL / Bancontact
              </button>
            </form>
          </div>
        </div>

        <!-- Lopende Projecten (alleen als er projecten zijn) -->
        {hasProjects && (
          <div class="lg:col-span-2">
            <h2 class="text-2xl font-bold font-heading text-primary mb-8">Lopende Projecten</h2>
            <div class="space-y-6">
              {projecten.map((project: any) => (
                <DonationCard
                  titel={project.titel}
                  beschrijving={project.beschrijving}
                  doelbedrag={project.doelbedrag}
                  huidigBedragCents={project.huidigBedragCents || 0}
                  actief={project.actief}
                  afbeelding={project.afbeelding}
                />
              ))}
            </div>
          </div>
        )}

      </div>
    </Section>
  )}

  <!-- Rekeninggegevens — Overschrijving -->
  <Section variant="light-100">
    <div class:list={[showMollie ? 'max-w-3xl' : 'max-w-2xl', 'mx-auto']}>
      <div class:list={[
        'bg-white border border-neutral-200 text-center',
        showMollie ? 'p-8 md:p-10' : 'p-10 md:p-14'
      ]}>
        <h2 class:list={[
          'font-bold font-heading mb-2',
          showMollie ? 'text-2xl' : 'text-3xl'
        ]}>Overschrijving</h2>
        {!showMollie && (
          <p class="text-slate-500 mb-8">Maak uw donatie over via onderstaande bankgegevens</p>
        )}
        {showMollie && <div class="mb-6" />}
        <div class:list={[
          'space-y-3',
          showMollie ? 'text-sm' : 'text-base'
        ]}>
          <div class="flex justify-between items-center py-3 border-b border-neutral-100">
            <span class="text-slate-500">Begunstigde</span>
            <span class="font-medium text-slate-800">{settings.mosqueName}</span>
          </div>
          <div class="flex justify-between items-center py-3 border-b border-neutral-100">
            <span class="text-slate-500">IBAN</span>
            <span class:list={[
              'font-mono font-medium text-slate-800',
              !showMollie && 'text-lg'
            ]}>{settings.iban || 'BE00 0000 0000 0000'}</span>
          </div>
          <div class="flex justify-between items-center py-3">
            <span class="text-slate-500">Mededeling</span>
            <span class="font-medium text-slate-800">Donatie + projectnaam</span>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- Contact CTA -->
  <Section variant="light-50">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-2xl font-bold font-heading mb-4">Vragen over doneren?</h2>
      <p class="text-slate-600 mb-6">Neem contact op voor meer informatie over donatiemogelijkheden.</p>
      <a href="/contact" class="btn-primary inline-flex items-center px-6 py-3 bg-primary hover:bg-primary-dark text-white font-semibold transition-all">
        Contact opnemen
      </a>
    </div>
  </Section>
</BaseLayout>

<script>
  // Quote carousel
  const slidesD = document.querySelectorAll('.quote-slide-doneren');
  const dotsD = document.querySelectorAll('.quote-dot-doneren');
  if (slidesD.length > 1) {
    let currentD = 0;
    function showSlideD(index: number) {
      slidesD.forEach((s, i) => {
        s.classList.toggle('opacity-100', i === index);
        s.classList.toggle('opacity-0', i !== index);
        s.classList.toggle('pointer-events-none', i !== index);
      });
      dotsD.forEach((d, i) => {
        d.classList.toggle('bg-accent', i === index);
        d.classList.toggle('w-6', i === index);
        d.classList.toggle('bg-neutral-300', i !== index);
        d.classList.toggle('w-2', i !== index);
      });
    }
    let activeIntervalD: ReturnType<typeof setInterval> | null = null;

    function startAutoplayD() {
      stopAutoplayD();
      activeIntervalD = setInterval(() => {
        currentD = (currentD + 1) % slidesD.length;
        showSlideD(currentD);
      }, 5000);
    }

    function stopAutoplayD() {
      if (activeIntervalD) { clearInterval(activeIntervalD); activeIntervalD = null; }
    }

    startAutoplayD();

    // Cleanup interval to prevent memory leaks
    document.addEventListener('astro:before-preparation', stopAutoplayD);
    window.addEventListener('beforeunload', stopAutoplayD);

    // Pause on hover
    const carouselD = document.getElementById('quote-carousel-doneren');
    carouselD?.addEventListener('mouseenter', stopAutoplayD);
    carouselD?.addEventListener('mouseleave', startAutoplayD);

    dotsD.forEach((dot) => {
      dot.addEventListener('click', () => {
        currentD = parseInt((dot as HTMLElement).dataset.index || '0');
        showSlideD(currentD);
      });
    });
  }

  const form = document.getElementById('donation-form') as HTMLFormElement | null;
  if (!form) {
    // Mollie formulier niet aanwezig (showMollie = false) — skip form logic
  } else {
  const buttons = document.querySelectorAll('.donation-amount-btn') as NodeListOf<HTMLButtonElement>;
  const customInput = document.getElementById('custom-amount') as HTMLInputElement;
  const customWrapper = document.getElementById('custom-amount-wrapper') as HTMLDivElement;
  const errorEl = document.getElementById('donation-error') as HTMLParagraphElement;
  const submitBtn = document.getElementById('donation-submit') as HTMLButtonElement;
  const projectSelect = document.getElementById('donation-project') as HTMLSelectElement | null;
  const emailInput = document.getElementById('donation-email') as HTMLInputElement;

  let selectedAmount: number | 'custom' = 25;

  // Preset amount buttons
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const val = parseInt(btn.dataset.amount || '0', 10);
      selectedAmount = val;
      customInput.value = '';

      // Reset alle knoppen
      buttons.forEach((b) => {
        b.classList.remove('active', 'bg-primary', 'text-white');
        b.classList.add('text-primary');
        b.setAttribute('aria-pressed', 'false');
      });

      // Activeer deze knop
      btn.classList.add('active', 'bg-primary', 'text-white');
      btn.classList.remove('text-primary');
      btn.setAttribute('aria-pressed', 'true');

      // Custom wrapper reset
      customWrapper.classList.remove('border-primary');
      customWrapper.classList.add('border-neutral-200');
    });
  });

  // Custom bedrag
  customInput.addEventListener('focus', () => {
    selectedAmount = 'custom';

    buttons.forEach((b) => {
      b.classList.remove('active', 'bg-primary', 'text-white');
      b.classList.add('text-primary');
      b.setAttribute('aria-pressed', 'false');
    });

    customWrapper.classList.add('border-primary');
    customWrapper.classList.remove('border-neutral-200');
  });

  customInput.addEventListener('input', () => {
    selectedAmount = 'custom';
  });

  // Submit
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.classList.add('hidden');
    errorEl.textContent = '';

    const finalAmount = selectedAmount === 'custom'
      ? parseFloat(customInput.value)
      : selectedAmount;

    if (!finalAmount || finalAmount < 1) {
      errorEl.textContent = 'Vul een geldig bedrag in (minimaal \u20ac1).';
      errorEl.classList.remove('hidden');
      return;
    }

    // Disable submit
    submitBtn.disabled = true;
    submitBtn.textContent = 'Even geduld...';

    const project = projectSelect
      ? (projectSelect.value === 'algemeen' ? 'Algemene Sadaqa' : projectSelect.value)
      : 'Algemene Sadaqa';

    try {
      const res = await fetch('/api/donate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          amount: finalAmount,
          frequency: 'eenmalig',
          project,
          email: emailInput?.value || '',
          website: (document.querySelector('input[name="website"]') as HTMLInputElement)?.value || '',
        }),
      });

      const data = await res.json();

      if (data.redirectUrl) {
        const allowed = [window.location.origin, 'https://www.mollie.com', 'https://mollie.com'];
        try {
          const rUrl = new URL(data.redirectUrl);
          if (!allowed.some(a => rUrl.origin === a || rUrl.origin === new URL(a).origin)) {
            throw new Error('Onveilige redirect geblokkeerd.');
          }
          window.location.href = data.redirectUrl;
        } catch (urlErr: any) {
          errorEl.textContent = urlErr.message || 'Ongeldige redirect URL.';
          errorEl.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Donatie afronden via iDEAL / Bancontact';
        }
      } else {
        errorEl.textContent = data.error || 'Er is een fout opgetreden.';
        errorEl.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Donatie afronden via iDEAL / Bancontact';
      }
    } catch {
      errorEl.textContent = 'Kan geen verbinding maken. Probeer het later opnieuw.';
      errorEl.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Donatie afronden via iDEAL / Bancontact';
    }
  });
  } // end if (form)
</script>
