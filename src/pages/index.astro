---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import HomeCardSlot from '../components/home/HomeCardSlot.astro';
import PrayerManager from '../components/PrayerManager.astro';
import JanazahBanner from '../components/ui/janazah/JanazahBanner.astro';
import { fetchActueel, fetchSettings, fetchHomePage, fetchHomeCards, fetchUpcomingAgendaEvents, fetchPrayerTimes, fetchActiveJanazahAlert, urlFor } from '../lib/sanity';
import { fetchIslamicDays } from '../lib/hijri';
import { sanitizeAlt } from '../lib/logic/seo-utils';
import { computePrayerTimesFromSanity } from '../lib/logic/prayer-compute';
import { isJanazahActive } from '../lib/logic/janazah';

const [settings, actueel, homePage, homeCards, agendaEvents, prayer, janazahAlert] = await Promise.all([
  fetchSettings(),
  fetchActueel(),
  fetchHomePage(),
  fetchHomeCards(),
  fetchUpcomingAgendaEvents(3),
  fetchPrayerTimes(),
  fetchActiveJanazahAlert(),
]);

// Islamic days for countdown card — fetched at page level
const islamicDaysData = await fetchIslamicDays(settings?.hijriAdjustment ?? 0, settings?.islamicDays);

// Prayer times for PrayerManager — computed at page level
const { computedTimes, prayerStatus } = computePrayerTimesFromSanity(prayer);
// Hero data: alleen uit homePage singleton
const heroImageUrl = homePage?.heroImage
  ? urlFor(homePage.heroImage).width(800).height(500).fit('crop').url()
  : null;
// Kleinere versie voor mobiel achtergrond (bespaart data op 4G)
const heroImageMobile = homePage?.heroImage
  ? urlFor(homePage.heroImage).width(400).height(500).fit('crop').quality(60).url()
  : null;

const heroTagline = homePage?.heroTagline || null;
const heroTitle = homePage?.heroTitle || `Welkom bij ${settings.mosqueName}`;
const heroSubtitle = homePage?.heroSubtitle || settings.description;
const heroCta = homePage?.heroCta || 'Gebedstijden bekijken';
const badges = homePage?.badges?.length ? homePage.badges : [];
const badgeKleur = homePage?.badgeKleur || '#593B1D';
const toonActueel = homePage?.toonActueel ?? true;

// Korte cache: janazah-meldingen moeten snel zichtbaar zijn op de homepage
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<BaseLayout title={settings.mosqueName} description={settings.description} ogImage={heroImageUrl || undefined} preloadImage={heroImageUrl || undefined}>

  {/* Kritieke hero CSS inline — elimineert render-blocking voor LCP */}
  <style is:inline>
    .hero-critical{position:relative;overflow:hidden;background-color:var(--color-primary-dark,#0f3039);color:#fff;min-height:400px}
    .hero-critical img.hero-lcp{width:100%;height:500px;object-fit:cover;display:block}
    @media(max-width:1023px){.hero-critical img.hero-lcp{display:none}}
  </style>

  <!-- Hero Section — Two Column: Text Left + Image Right (Flat Design) -->
  <section class="hero-critical bg-primary-dark text-white relative overflow-hidden">
    <!-- Mobiel: hero afbeelding als achtergrond (geoptimaliseerde kleine versie) -->
    {heroImageMobile && (
      <div class="absolute inset-0 lg:hidden">
        <img src={heroImageMobile} alt="" class="w-full h-full object-cover opacity-15" aria-hidden="true" loading="eager" />
      </div>
    )}
    <div class="max-w-[1280px] mx-auto px-6 py-16 md:py-24 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

        <!-- Links: Badges + Tekst + CTA's -->
        <div class="animate-fade-in-up">
          <!-- Meertalige badges uit CMS -->
          {badges.length > 0 && (
            <div class="flex flex-wrap gap-3 mb-6">
              {badges.map((badge: string) => (
                <span class="badge px-5 py-2 text-base font-semibold border" style={`border-color: ${badgeKleur}40; background-color: ${badgeKleur}20; color: ${badgeKleur}`}>{badge}</span>
              ))}
            </div>
          )}

          {heroTagline && (
            <p class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight text-accent-light mb-2">{heroTagline}</p>
          )}
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6 text-white">
            {heroTitle}
          </h1>
          <p class="text-lg text-white/80 leading-relaxed mb-10 max-w-xl">
            {heroSubtitle}
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/gebedstijden" class="btn-primary inline-flex items-center px-8 py-3 min-h-[44px] bg-accent hover:bg-accent-hover active:brightness-90 text-white font-bold transition-all">
              {heroCta}
            </a>
            <a href="/doneren" class="inline-flex items-center px-8 py-3 min-h-[44px] bg-white/10 hover:bg-white/20 active:bg-white/30 text-white font-semibold transition-all border border-white/20">
              Steun onze moskee
            </a>
          </div>
        </div>

        <!-- Rechts: Hero Afbeelding — Flat (no rounded corners) -->
        <!-- Mobiel: subtiele achtergrond, Desktop: naast tekst -->
        <div class="hidden lg:block animate-scale-in">
          {heroImageUrl ? (
            <img
              src={heroImageUrl}
              alt={sanitizeAlt(homePage?.heroTitle || settings.mosqueName)}
              class="hero-lcp w-full h-[500px] object-cover"
              width={800}
              height={500}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          ) : (
            <div class="w-full h-[500px] bg-white/5 border border-white/10 flex items-center justify-center">
            </div>
          )}
        </div>

      </div>
    </div>
  </section>

  <!-- Janazah Banner — alleen zichtbaar als er een actieve melding is -->
  {isJanazahActive(janazahAlert) && janazahAlert && (
    <JanazahBanner alert={janazahAlert} />
  )}

  <!-- Sectie 1: Light-50 — Gebedstijden (compact) -->
  <Section variant="light-50">
    <div class="text-center mb-10">
      <h2 class="text-3xl font-bold">Gebedstijden Vandaag</h2>
      <p class="text-neutral-500 mt-3">Inclusief Iqamah-tijden</p>
    </div>
    <div class="max-w-4xl mx-auto">
      <PrayerManager compact computedTimes={computedTimes} prayerStatus={prayerStatus} />
    </div>
    <div class="text-center mt-8">
      <a href="/gebedstijden" class="inline-flex items-center gap-1 text-primary hover:text-accent font-bold text-sm transition-colors">
        Bekijk volledige gebedstijden &rarr;
      </a>
    </div>
  </Section>

  <!-- Sectie 2: Light-100 — Activiteiten (verborgen als leeg) -->
  {agendaEvents.length > 0 && (
    <Section variant="light-100">
      <div class="text-center mb-14">
        <h2 class="text-3xl font-bold">Activiteiten</h2>
        <p class="text-neutral-600 mt-3">Wat er binnenkort gepland staat</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {agendaEvents.map((event: any) => (
          <a
            href={`/agenda/${event.slug.current}`}
            class="group bg-white border border-slate-200 p-6 transition-all hover:bg-primary-light/40"
            style={`border-left: 3px solid ${event.categorieKleur || '#8b6843'}`}
          >
            <div class="flex flex-wrap items-center gap-2 mb-3">
              {event.categorie && (
                <span
                  class="badge inline-block px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white"
                  style={`background-color: ${event.categorieKleur || 'var(--color-primary)'}`}
                >
                  {event.categorie}
                </span>
              )}
              {event.doelgroep && event.doelgroep !== 'Iedereen' && (
                <span class="badge inline-block px-3 py-1 text-xs font-semibold uppercase tracking-wider bg-neutral-100 text-neutral-700">
                  {event.doelgroep}
                </span>
              )}
            </div>
            <h3 class="font-heading text-lg font-bold text-primary group-hover:underline group-hover:decoration-accent transition-colors mb-1.5">
              {event.titel}
            </h3>
            <p class="text-sm text-neutral-600">
              {new Date(event.startDatum).toLocaleDateString('nl-BE', { weekday: 'short', day: 'numeric', month: 'long', timeZone: settings?.timezone || 'Europe/Brussels' })}
            </p>
            {event.locatie && (
              <p class="text-sm text-slate-600 mt-1">{event.locatie}</p>
            )}
          </a>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/agenda" class="text-primary hover:text-accent font-medium text-sm transition-colors">
          Bekijk alle activiteiten &rarr;
        </a>
      </div>
    </Section>
  )}

  <!-- Sectie 3: Actiekaarten — CMS-bestuurbaar 3-slot systeem -->
  {(homeCards?.ingeschakeld ?? true) && (() => {
    // Fleet fallback: als homeCards document niet bestaat, toon defaults
    const defaultCards = {
      card1: { variant: 'evenementCountdown', ingeschakeld: true },
      card2: { variant: 'donatieCampagne', ingeschakeld: false },
      card3: { variant: 'download', ingeschakeld: true, downloadBron: 'homePage' },
    };
    const src = homeCards || defaultCards;
    const cards = [src.card1, src.card2, src.card3];
    const activeCards = cards.filter((c: any) => c?.ingeschakeld && c?.variant);
    const cardCount = activeCards.length;
    if (cardCount === 0) return null;
    const gridClass = cardCount === 3
      ? 'grid-cols-1 md:grid-cols-3'
      : cardCount === 2
        ? 'grid-cols-1 md:grid-cols-2'
        : 'grid-cols-1 max-w-lg mx-auto';
    const homePageDownload = {
      downloadTitel: homePage?.downloadTitel,
      downloadBeschrijving: homePage?.downloadBeschrijving,
      downloadUrl: homePage?.downloadUrl,
      downloadBestand: homePage?.downloadBestand,
    };
    return (
      <section class="py-14 sm:py-20 md:py-24 bg-base-100 text-neutral-900">
        <div class="max-w-[1280px] mx-auto px-6">
          <div class={`grid ${gridClass} gap-6`}>
            {cards.map((card: any, i: number) => (
              <HomeCardSlot
                card={card}
                delay={i * 100}
                islamicDaysData={islamicDaysData}
                mosqueName={settings?.mosqueName}
                homePageDownload={homePageDownload}
              />
            ))}
          </div>
        </div>
      </section>
    );
  })()}

  <!-- Sectie 4: Light-50 — Nieuws uit de moskee (conditioneel via CMS) -->
  {toonActueel && <Section variant="light-50">
    <div class="text-center mb-14">
      <h2 class="text-3xl font-bold">Nieuws uit de moskee</h2>
      <p class="text-neutral-600 mt-3">Recente berichten en aankondigingen</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {actueel.map((item: any) => (
        <a href={item.href} class="group bg-white border border-slate-200 p-6 transition-all hover:bg-primary-light/40" style="border-left: 3px solid #8b6843">
          <h3 class="font-heading text-lg font-bold text-primary group-hover:underline group-hover:decoration-accent transition-colors mb-2">
            {item.titel}
          </h3>
          <p class="text-sm text-neutral-600 leading-relaxed line-clamp-3">{item.beschrijving}</p>
        </a>
      ))}
    </div>
  </Section>}

  <!-- Sectie 4: Light-50 — Kom Langs (Maps + CTA) -->
  <Section variant="light-50">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 max-w-5xl mx-auto border border-neutral-200 overflow-hidden">

      <!-- Links: Google Maps Embed (gratis, geen API key nodig) -->
      <div class="h-[350px] lg:h-[400px] relative">
        <iframe
          src={`https://www.google.com/maps?q=${encodeURIComponent((settings?.mosqueName || 'Moskee') + ' ' + (settings?.address || ''))}&output=embed`}
          title={`Locatie ${settings?.mosqueName}`}
          class="w-full h-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>

      <!-- Rechts: Kom langs -->
      <div class="bg-white p-10 lg:p-14 flex flex-col justify-center">
        <h2 class="text-3xl md:text-4xl font-bold font-heading text-primary mb-3">Kom langs</h2>
        <p class="text-neutral-500 text-sm mb-8 leading-relaxed">
          {settings?.address || ''}
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(settings?.address || '')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 min-h-[44px] bg-primary text-white font-bold text-sm hover:bg-primary-dark active:brightness-90 transition-all"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
            Open in Google Maps
          </a>
          {settings?.whatsapp && (
            <a
              href={`https://wa.me/${settings.whatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 min-h-[44px] bg-whatsapp text-white font-bold text-sm hover:bg-whatsapp-hover active:brightness-90 transition-all"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
              Stuur een WhatsApp
            </a>
          )}
        </div>
      </div>

    </div>
  </Section>

  <!-- Sectie 5: Dark — CTA -->
  <Section variant="dark">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">Samen bouwen aan onze gemeenschap</h2>
      <p class="text-white/80 text-lg mb-10 max-w-2xl mx-auto">
        Of u nu wilt bidden, leren of bijdragen — iedereen is welkom bij {settings.mosqueName}.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="btn-primary px-8 py-3 min-h-[44px] inline-flex items-center bg-white text-primary-dark font-bold transition-all">
          Contact opnemen
        </a>
        <a href="/doneren" class="btn-primary px-8 py-3 min-h-[44px] inline-flex items-center bg-accent text-white font-bold transition-all">
          Doneer nu
        </a>
      </div>
    </div>
  </Section>
</BaseLayout>
