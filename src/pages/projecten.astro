---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import DonationCard from '../components/DonationCard.astro';
import { fetchProjecten, fetchAllQuotes } from '../lib/sanity';

const projecten = await fetchProjecten();
const quotes = await fetchAllQuotes('donaties');
---

<BaseLayout title="Projecten & Donaties" description="Steun onze projecten en help de gemeenschap groeien">
  <!-- Page Header — Dark -->
  <section class="bg-primary-dark text-white py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-6 text-center animate-fade-in-up">
      <h1 class="text-4xl font-bold mb-4 text-white">Projecten & Donaties</h1>
      <p class="text-white/80 max-w-xl mx-auto">
        Uw bijdrage maakt het verschil. Steun onze lopende projecten en help de gemeenschap groeien.
      </p>
    </div>
  </section>

  <!-- Islamitische Citaten Carousel -->
  {quotes.length > 0 && (
    <Section variant="light-100">
      <div class="max-w-3xl mx-auto text-center py-4">
        <div id="quote-carousel" class="relative min-h-[260px] flex items-center justify-center" aria-live="polite">
          {quotes.map((q: any, i: number) => (
            <div class:list={['quote-slide absolute inset-0 flex flex-col items-center justify-center transition-opacity duration-700', i === 0 ? 'opacity-100' : 'opacity-0 pointer-events-none']}>
              {q.tekstArabisch && (
                <p class="font-arabic text-3xl md:text-4xl leading-loose mb-6 text-primary/70" dir="rtl" lang="ar">
                  {q.tekstArabisch}
                </p>
              )}
              <p class="text-lg md:text-xl font-heading text-primary/90 italic leading-relaxed max-w-2xl">
                "{q.tekst}"
              </p>
              <p class="text-sm mt-4 mb-4" style="color: var(--color-accent-gold);">— {q.bron}</p>
            </div>
          ))}
        </div>
        {quotes.length > 1 && (
          <div class="flex justify-center gap-2 mt-6" role="tablist">
            {quotes.map((_: any, i: number) => (
              <button
                class:list={['quote-dot w-2 h-2 rounded-full transition-all duration-300', i === 0 ? 'bg-accent w-6' : 'bg-neutral-300']}
                data-index={i}
                role="tab"
                aria-label={`Citaat ${i + 1}`}
              />
            ))}
          </div>
        )}
      </div>
    </Section>
  )}

  <!-- Projects Grid -->
  <Section variant="light-50">
    <div class="max-w-5xl mx-auto">
      {projecten.length === 0 && (
        <p class="text-center text-neutral-500 py-12">Er zijn momenteel geen actieve projecten.</p>
      )}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {projecten.map((project) => (
          <DonationCard
            titel={project.titel}
            beschrijving={project.beschrijving}
            doelbedrag={project.doelbedrag}
            huidigBedragCents={project.huidigBedragCents || 0}
            actief={project.actief}
            afbeelding={project.afbeelding}
          />
        ))}
      </div>
    </div>
  </Section>

  <!-- How to Donate -->
  <Section variant="light-100">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-center mb-8">Hoe kunt u doneren?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 text-center border border-neutral-200 border-t-3 border-t-accent">
          <h3 class="font-heading font-bold mb-2">Overschrijving</h3>
          <p class="text-sm text-neutral-600">Maak een overschrijving naar onze rekening met vermelding van het project.</p>
        </div>
        <div class="bg-white p-6 text-center border border-neutral-200 border-t-3 border-t-accent">
          <h3 class="font-heading font-bold mb-2">Contant</h3>
          <p class="text-sm text-neutral-600">U kunt ook contant doneren bij de moskee tijdens de openingsuren.</p>
        </div>
        <div class="bg-white p-6 text-center border border-neutral-200 border-t-3 border-t-accent">
          <h3 class="font-heading font-bold mb-2">Contact</h3>
          <p class="text-sm text-neutral-600">Neem contact op voor andere donatiemogelijkheden.</p>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>

<script>
  const slides = document.querySelectorAll('.quote-slide');
  const dots = document.querySelectorAll('.quote-dot');
  if (slides.length > 1) {
    let current = 0;
    let activeInterval: ReturnType<typeof setInterval> | null = null;

    function showSlide(index: number) {
      slides.forEach((s, i) => {
        s.classList.toggle('opacity-100', i === index);
        s.classList.toggle('opacity-0', i !== index);
        s.classList.toggle('pointer-events-none', i !== index);
      });
      dots.forEach((d, i) => {
        d.classList.toggle('bg-accent', i === index);
        d.classList.toggle('w-6', i === index);
        d.classList.toggle('bg-neutral-300', i !== index);
        d.classList.toggle('w-2', i !== index);
      });
    }

    function startAutoplay() {
      stopAutoplay();
      activeInterval = setInterval(() => {
        current = (current + 1) % slides.length;
        showSlide(current);
      }, 5000);
    }

    function stopAutoplay() {
      if (activeInterval) { clearInterval(activeInterval); activeInterval = null; }
    }

    startAutoplay();

    // Cleanup interval to prevent memory leaks
    document.addEventListener('astro:before-preparation', stopAutoplay);
    window.addEventListener('beforeunload', stopAutoplay);

    // Pause on hover
    const carousel = document.getElementById('quote-carousel');
    carousel?.addEventListener('mouseenter', stopAutoplay);
    carousel?.addEventListener('mouseleave', startAutoplay);

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        current = parseInt((dot as HTMLElement).dataset.index || '0');
        showSlide(current);
      });
    });
  }
</script>
