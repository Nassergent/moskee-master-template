---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import PrayerManager from '../components/PrayerManager.astro';
import EtiquetteGrid from '../components/EtiquetteGrid.astro';
import IslamicCalendar from '../components/IslamicCalendar.astro';
import { fetchSettings, fetchPrayerTimes } from '../lib/sanity';
import { formatHijriDate } from '../lib/hijri';
import {
  isEngineConfigComplete,
  buildConfigFromSanity,
  computeFullPrayerTimes,
  PRAYER_LABELS,
  PRAYER_NAMES,
} from '../lib/logic/prayer-engine';

const hijriToday = formatHijriDate();

const settings = await fetchSettings();
const prayer = await fetchPrayerTimes();

// Compute times for SEO structured data
const configComplete = isEngineConfigComplete(prayer);
let prayerTimesForSeo: Record<string, string> | null = null;
if (configComplete) {
  try {
    const config = buildConfigFromSanity(prayer);
    const computed = computeFullPrayerTimes(new Date(), config, []);
    prayerTimesForSeo = computed.adhan;
  } catch { /* SEO data not critical */ }
}

// Cache headers: kort tijdens fine-tuning, verhoog later naar s-maxage=3600
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=120');
---

<BaseLayout title="Gebedstijden" description="Dagelijkse gebedstijden en Jumu'ah informatie" hideFooterMobile>
  <!-- Page Header — alleen desktop -->
  <section class="hidden sm:block bg-primary-dark text-white py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-6 text-center animate-fade-in-up">
      <h1 class="text-4xl font-bold mb-4 text-white">Gebedstijden</h1>
      <p class="text-white/80 max-w-xl mx-auto">
        Dagelijkse gebedstijden en Iqamah — altijd actueel
      </p>
      <p class="text-white/50 font-arabic text-sm mt-3">{hijriToday}</p>
    </div>
  </section>

  <!-- Mobiel: fullscreen gebedstijden, geen scroll -->
  <div class="sm:hidden fixed inset-0 top-16 flex flex-col overflow-hidden z-20 bg-white">
    <PrayerManager fullscreen />
  </div>
  <Section variant="light-50" class="hidden sm:block">
    <div class="text-center mb-10">
      <h2 class="text-2xl font-bold">Vandaag</h2>
      <p class="text-neutral-500 mt-2 text-sm">Adhan- en Iqamah-tijden</p>
    </div>
    <div class="max-w-4xl mx-auto">
      <PrayerManager />
      <p class="sr-only">
        Dagelijkse gebedstijden voor {settings?.mosqueName}: Fajr, Dhuhr, Asr, Maghrib en Isha.
        Inclusief Iqamah-tijden. Voor het Vrijdaggebed (Jumu'ah), zie de sectie hieronder.
      </p>
    </div>
  </Section>

  <!-- Vrijdaggebed (Jumu'ah) — Light-100 (alleen desktop) -->
  {prayer.jumuahShifts && prayer.jumuahShifts.length > 0 && (
    <Section variant="light-100" class="hidden sm:block">
      <div class="text-center mb-6">
        <p class="font-arabic text-2xl text-accent/60 mb-2" dir="rtl" lang="ar">صلاة الجمعة</p>
        <h2 class="text-3xl font-bold font-heading text-primary">Vrijdaggebed</h2>
      </div>

      <div class={`grid gap-6 max-w-3xl mx-auto ${prayer.jumuahShifts.length === 1 ? 'grid-cols-1 max-w-md' : 'grid-cols-1 md:grid-cols-2'}`}>
        {prayer.jumuahShifts.map((shift: any, i: number) => (
          <div class="bg-white border border-neutral-200 text-center relative">
            <div class={`h-1 ${i === 0 ? 'bg-primary' : 'bg-accent'}`} />
            <div class="px-8 py-8">
              <div class={`w-14 h-14 mx-auto mb-4 flex items-center justify-center ${i === 0 ? 'bg-primary/10' : 'bg-accent/10'}`}>
                {i === 0 ? (
                  <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 0 0 4.5 4.5H18a3.75 3.75 0 0 0 1.332-7.257 3 3 0 0 0-3.758-3.848 5.25 5.25 0 0 0-10.233 2.33A4.502 4.502 0 0 0 2.25 15Z" /></svg>
                ) : (
                  <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" /></svg>
                )}
              </div>
              <p class={`text-xs font-bold uppercase tracking-[0.2em] mb-3 ${i === 0 ? 'text-primary/60' : 'text-accent/80'}`}>{shift.label}</p>
              <p class={`text-4xl sm:text-5xl font-bold font-heading tabular-nums ${i === 0 ? 'text-primary' : 'text-accent'}`}>{shift.time}</p>
              {shift.note && (
                <p class="text-sm text-neutral-400 mt-3">{shift.note}</p>
              )}
            </div>
          </div>
        ))}
      </div>

      {prayer.jumuahNote && (
        <p class="text-sm text-neutral-500 text-center mt-6 max-w-2xl mx-auto">
          {prayer.jumuahNote}
        </p>
      )}
    </Section>
  )}

  <!-- Islamitische Kalender — alleen desktop -->
  <Section variant="light-100" class="hidden sm:block">
    <IslamicCalendar />
  </Section>

  <!-- Huisregels — alleen desktop -->
  <Section variant="light-50" class="hidden sm:block">
    <EtiquetteGrid />
  </Section>

  {/* JSON-LD Structured Data — Gebedstijden direct uit engine */}
  {prayerTimesForSeo && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Event",
      "name": `Dagelijkse gebedstijden — ${settings?.mosqueName}`,
      "description": `Gebedstijden voor ${settings?.mosqueName}: Fajr ${prayerTimesForSeo.fajr}, Dhuhr ${prayerTimesForSeo.dhuhr}, Asr ${prayerTimesForSeo.asr}, Maghrib ${prayerTimesForSeo.maghrib}, Isha ${prayerTimesForSeo.isha}`,
      "startDate": new Date().toISOString().split('T')[0],
      "location": {
        "@type": "Mosque",
        "name": settings?.mosqueName,
        "address": settings?.address || undefined,
      },
      "organizer": {
        "@type": "Organization",
        "name": settings?.mosqueName,
      },
    })} />
  )}
</BaseLayout>
