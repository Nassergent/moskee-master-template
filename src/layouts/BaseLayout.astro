---
import IslamicDayBar from '../components/IslamicDayBar.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { fetchSettings, urlFor } from '../lib/sanity';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
}

const settings = await fetchSettings();
const mosqueName = settings?.mosqueName || 'Onze Moskee';
const defaultDescription = settings?.description || 'Welkom bij onze moskee — een plek van gebed, gemeenschap en kennis.';

const { title = mosqueName, description = defaultDescription, ogImage, ogType = 'website' } = Astro.props;
const fullTitle = title === mosqueName ? title : `${title} | ${mosqueName}`;
const canonicalUrl = Astro.url.href;

// OG Image: prop > logo uit CMS > fallback
const ogImageUrl = ogImage
  || (settings?.logo ? urlFor(settings.logo).width(1200).height(630).fit('crop').url() : null)
  || null;

// 60-30-10 Color System from Sanity CMS
const colors = settings?.theme || {
  baseColor: '#FBF9F7',
  primaryColor: '#1D5C6B',
  accentColor: '#593B1D',
};
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {/* OpenGraph — Facebook, WhatsApp, LinkedIn */}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="nl_BE" />
    <meta property="og:site_name" content={mosqueName} />
    {ogImageUrl && (
      <>
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={fullTitle} />
      </>
    )}

    {/* Twitter Card */}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    {settings?.favicon ? (
      <link rel="icon" type="image/png" href={urlFor(settings.favicon).width(64).height(64).fit('crop').url()} />
    ) : (
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    )}
    <!-- Flat Design Fonts: Philosopher (headings) + Lato (body) + Amiri (Arabic) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Philosopher:wght@400;700&family=Lato:wght@300;400;700;900&family=Amiri:wght@400;700&display=swap" rel="stylesheet" />
    <title>{fullTitle}</title>

    <!-- 60-30-10 Dynamic Theme Injection from Sanity CMS -->
    <style define:vars={{
      base: colors.baseColor,
      primary: colors.primaryColor,
      accent: colors.accentColor,
    }}>
      :root {
        /* Core 60-30-10 tokens */
        --theme-base: var(--base);
        --theme-primary: var(--primary);
        --theme-accent: var(--accent);

        /* Auto-generated variants via color-mix() */
        --theme-primary-light: color-mix(in srgb, var(--primary), white 90%);
        --theme-primary-dark: color-mix(in srgb, var(--primary), black 20%);
        --theme-accent-light: color-mix(in srgb, var(--accent), white 90%);
        --theme-accent-hover: color-mix(in srgb, var(--accent), white 20%);
        --theme-base-100: color-mix(in srgb, var(--base), black 4%);
      }
    </style>

    <!-- Schema.org Mosque -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Mosque",
      "name": mosqueName,
      "description": description,
      "url": canonicalUrl,
      "address": settings?.address ? {
        "@type": "PostalAddress",
        "streetAddress": settings.address,
        "addressCountry": "BE"
      } : undefined,
      "telephone": settings?.phone || undefined,
      "email": settings?.email || undefined,
      "image": ogImageUrl || undefined
    })} />
  </head>
  <body class="min-h-screen flex flex-col bg-base transition-colors relative">
    <IslamicDayBar />
    <Navigation />
    <main class="flex-1 relative z-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
