---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { fetchSettings, urlFor } from '../lib/sanity';
import '../styles/global.css';

interface BreadcrumbItem {
  name: string;
  href: string;
}

interface Props {
  title?: string;
  description?: string;
  bodyText?: string;
  ogImage?: string;
  ogType?: string;
  hideFooterMobile?: boolean;
  preloadImage?: string;
  breadcrumbs?: BreadcrumbItem[];
}

const settings = await fetchSettings();
const mosqueName = settings?.mosqueName || 'Onze Moskee';
const defaultDescription = settings?.description || 'Welkom bij onze moskee — een plek van gebed, gemeenschap en kennis.';

const { title = mosqueName, description, bodyText, ogImage, ogType = 'website', hideFooterMobile = false, preloadImage, breadcrumbs } = Astro.props;
const autoDescription = description
  || (bodyText ? bodyText.slice(0, 160).trim() + (bodyText.length > 160 ? '...' : '') : defaultDescription);
const fullTitle = title === mosqueName ? title : `${title} | ${mosqueName}`;
const canonicalUrl = Astro.url.href;

// OG Image: prop > logo uit CMS > favicon fallback (altijd een og:image)
const ogImageUrl = ogImage
  || (settings?.logo ? urlFor(settings.logo).width(1200).height(630).fit('crop').url() : null)
  || (settings?.favicon ? urlFor(settings.favicon).width(1200).height(630).fit('crop').url() : null)
  || new URL('/favicon.svg', Astro.site || Astro.url.origin).href;

// 60-30-10 Color System from Sanity CMS
const colors = settings?.theme || {
  baseColor: '#FBF9F7',
  primaryColor: '#1D5C6B',
  accentColor: '#593B1D',
};
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={autoDescription} />
    <link rel="canonical" href={canonicalUrl} />

    {/* OpenGraph — Facebook, WhatsApp, LinkedIn */}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={autoDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="nl_BE" />
    <meta property="og:site_name" content={mosqueName} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />

    {/* Twitter Card */}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={autoDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    {settings?.favicon ? (
      <link rel="icon" type="image/png" href={urlFor(settings.favicon).width(64).height(64).fit('crop').url()} />
    ) : (
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    )}
    <!-- Preconnect voor Sanity CDN -->
    <link rel="preconnect" href="https://cdn.sanity.io" />
    <link rel="dns-prefetch" href="https://maps.googleapis.com" />
    {/* LCP preload — boven fonts zodat hero-afbeelding als eerste wordt opgehaald */}
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <link rel="preload" as="font" href="/fonts/philosopher-regular.woff2" type="font/woff2" crossorigin />
    <link rel="preload" as="font" href="/fonts/philosopher-bold.woff2" type="font/woff2" crossorigin />
    <link rel="preload" as="font" href="/fonts/lato-light.woff2" type="font/woff2" crossorigin />
    <link rel="preload" as="font" href="/fonts/lato-regular.woff2" type="font/woff2" crossorigin />
    <link rel="preload" as="font" href="/fonts/lato-bold.woff2" type="font/woff2" crossorigin />
    <link rel="preload" as="font" href="/fonts/lato-black.woff2" type="font/woff2" crossorigin />
    <link rel="preload" as="font" href="/fonts/amiri-regular.woff2" type="font/woff2" crossorigin />
    <link rel="preload" as="font" href="/fonts/amiri-bold.woff2" type="font/woff2" crossorigin />

    <!-- Self-hosted Fonts: Philosopher + Lato + Amiri (geen Google Fonts CDN) -->
    <style is:inline>
      @font-face {
        font-family: 'Philosopher';
        src: url('/fonts/philosopher-regular.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Philosopher';
        src: url('/fonts/philosopher-bold.woff2') format('woff2');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Lato';
        src: url('/fonts/lato-light.woff2') format('woff2');
        font-weight: 300;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Lato';
        src: url('/fonts/lato-regular.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Lato';
        src: url('/fonts/lato-bold.woff2') format('woff2');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Lato';
        src: url('/fonts/lato-black.woff2') format('woff2');
        font-weight: 900;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Amiri';
        src: url('/fonts/amiri-regular.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Amiri';
        src: url('/fonts/amiri-bold.woff2') format('woff2');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }
    </style>
    <title>{fullTitle}</title>

    <!-- 60-30-10 Dynamic Theme Injection from Sanity CMS -->
    <style define:vars={{
      base: colors.baseColor,
      primary: colors.primaryColor,
      accent: colors.accentColor,
    }}>
      :root {
        /* Core 60-30-10 tokens */
        --theme-base: var(--base);
        --theme-primary: var(--primary);
        --theme-accent: var(--accent);

        /* Auto-generated variants via color-mix() */
        --theme-primary-light: color-mix(in srgb, var(--primary), white 90%);
        --theme-primary-dark: color-mix(in srgb, var(--primary), black 20%);
        --theme-accent-light: color-mix(in srgb, var(--accent), white 90%);
        --theme-accent-hover: color-mix(in srgb, var(--accent), white 20%);
        --theme-base-100: color-mix(in srgb, var(--base), black 4%);
      }
    </style>

    <!-- Schema.org Mosque -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Mosque",
      "name": mosqueName,
      "description": autoDescription,
      "url": canonicalUrl,
      "address": settings?.address ? {
        "@type": "PostalAddress",
        "streetAddress": settings.address,
        "addressCountry": "BE"
      } : undefined,
      "telephone": settings?.phone || undefined,
      "email": settings?.email || undefined,
      "image": ogImageUrl || undefined
    })} />

    {/* BreadcrumbList JSON-LD — voor detail-pagina's */}
    {breadcrumbs && breadcrumbs.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": breadcrumbs.map((item, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "name": item.name,
          "item": new URL(item.href, Astro.site || Astro.url.origin).href,
        })),
      })} />
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-base transition-colors relative">
    <!-- Skip to content (a11y) -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-primary focus:text-white focus:px-4 focus:py-2 focus:text-sm focus:font-bold">
      Ga naar inhoud
    </a>
    <Navigation />
    <main id="main-content" class="flex-1 relative z-10">
      <slot />
    </main>
    <div class:list={[hideFooterMobile && 'hidden sm:block']}>
      <Footer />
    </div>
  </body>
</html>
