# ── Site ──
PUBLIC_SITE_URL=https://your-mosque.vercel.app

# ── Sanity CMS ──
PUBLIC_SANITY_PROJECT_ID=your-project-id
PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-read-token
SANITY_WRITE_TOKEN=your-write-token

# ── Mollie Betalingen ──
MOLLIE_API_KEY=test_xxxxxxxxxxxx
MOLLIE_WEBHOOK_SECRET=whsec_... # Vind in Mollie Dashboard > Developers > Webhooks

# ── Webhook Verificatie ──
# Set to 'true' ONLY in development — NEVER in production!
# When true, HMAC signature verification is skipped and demo mode is active.
WEBHOOK_SKIP_VERIFICATION=true

# ── Resend E-mail ──
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL_DOMAIN=onboarding@resend.dev  # Vervang door uw eigen domein na Resend verificatie

# ── Upstash Redis (Rate Limiting + Webhook Idempotency) ──
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Tenant / Multi-tenant ──
SANITY_PROJECT_ID=your-project-id   # Server-only tenant identifier (ZONDER PUBLIC_ prefix!)

# ── Cron Jobs ──
CRON_SECRET=your-cron-secret

# ── Health Check ──
HEALTH_SECRET=                # Optioneel: beschermt /api/health endpoint

# ── Demo Mode ──
# DEMO_MODE=false             # Override demo mode detectie (true = geen echte integraties)

# ── Fleet Telemetry ──
TENANT_ID=your-mosque-id
HUB_TELEMETRY_URL=https://ummah.be/api/v1/fleet/intake
