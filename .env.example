# ── Sanity CMS ──
PUBLIC_SANITY_PROJECT_ID=your-project-id
PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-read-token
SANITY_WRITE_TOKEN=your-write-token

# ── Mollie Betalingen ──
MOLLIE_API_KEY=test_xxxxxxxxxxxx
MOLLIE_WEBHOOK_SECRET=whsec_... # Vind deze na het aanmaken van de webhook in Mollie (Dashboard > Developers > Webhooks)

# ── Resend E-mail ──
RESEND_API_KEY=re_xxxxxxxxxxxx

# ── Upstash Redis (Rate Limiting + Webhook Idempotency) ──
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Tenant / Multi-tenant ──
SANITY_PROJECT_ID=your-project-id   # Server-only tenant identifier (ZONDER PUBLIC_ prefix!)

# ── Cron Jobs ──
CRON_SECRET=your-cron-secret
